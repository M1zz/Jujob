    "당신은 충분히\n가치 있는 사람이에요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are more than enough,\nand worth every bit of hype!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are more\nthan enough, and worth every bit!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已经足够好，\n是个很有价值的人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你本來就是\n很有價值的人喔！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは十分に\n価値のある人です!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты — человек,\nкоторый многого стоит!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú vales mucho,\nmuchísimo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist wertvoll,\nund zwar genau so, wie du bist!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fait, tu vaux de l'or,\nne l'oublie jamais !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali davvero tanto,\ne tu lo sai!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já é mais\nque suficiente!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่เป็นคุณก็มีค่า\nมากพอแล้วนะ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn xứng đáng với mọi điều\ntốt đẹp trên đời!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

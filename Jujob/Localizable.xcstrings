    "기분이나 상황에 맞는\n주접을 골라드릴게요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us your mood or moment\nand we'll pick the perfect hype!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll pick a gush to suit\nyour mood or moment!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你的心情和场景，\n挑一句最合适的彩虹屁！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依照心情或情境，\n幫你挑一句剛剛好的彩虹屁！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分やシーンに合った\nほめちぎりを選びます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подберём оду под твоё\nнастроение и ситуацию!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te elijo el piropo perfecto\npara tu estado de ánimo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir suchen den passenden Spruch\nzu Stimmung und Situation!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je te choisis le compliment\nqui colle à ton humeur !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti scelgo il complimento giusto\nper umore e momento!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu escolho o elogio certo\npro seu humor ou momento!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกคำชมที่เข้ากับ\nอารมณ์และสถานการณ์ให้เอง!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để em chọn lời khen lố\nhợp với tâm trạng của bạn nhé!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybereme ti hlášku\npodle nálady nebo situace!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg finder en ros, der passer\ntil dit humør og din situation!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα διαλέξω το παίνεμα\nπου ταιριάζει στη διάθεσή σου!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsen fiiliksen tai tilanteen\nmukaisen kehun puolestasi!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku pilihin pujian lebay yang\ncocok sama mood atau situasimu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg finner skryt som passer\nhumøret og situasjonen din!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik kies een hype die bij\njouw stemming of situatie past!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobierzemy peany\ndo nastroju i sytuacji!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi väljer pepp som passar\nditt humör och din situation!"

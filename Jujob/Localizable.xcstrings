    "일주일 동안 꾸준히 찾아와준 당신,\n정말 자랑스러워요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A whole week of showing up.\nWe're so proud of you!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A whole week of turning up,\nwe are dead proud of you!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一整周都坚持来看，\n真为你骄傲！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連續一週都來報到的你，\n真的讓人好驕傲！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1週間ずっと来てくれたあなた、\n本当に誇らしいです!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целую неделю ты с нами —\nмы гордимся тобой!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda la semana sin fallar.\n¡Qué orgullo!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ganze Woche lang dabei –\nich bin so stolz auf dich!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une semaine sans faute,\nje suis super fier de toi !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una settimana di costanza:\nche orgoglio!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma semana firme por aqui,\nque orgulho de você!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาหากันไม่ขาดทั้งสัปดาห์\nภูมิใจในตัวคุณสุดๆ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả tuần đều đặn ghé qua,\nem tự hào về bạn lắm!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celý týden každý den,\nty nám děláš velkou radost!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hel uge i træk,\nog jeg er virkelig stolt af dig!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια εβδομάδα χωρίς διακοπή·\nνιώθω περηφάνια για σένα!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viikon verran ahkerasti mukana.\nOlen todella ylpeä sinusta!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seminggu penuh kamu rajin mampir,\nbangga banget sama kamu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hele uken har du kommet innom,\nså stolt jeg er av deg!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een hele week lang kwam jij elke dag,\ndus ik ben echt trots!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siedem dni z rzędu, a ty\nnadal w formie. Duma!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hel vecka i rad,\nvad stolt jag är över dig!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hafta boyunca düzenli gelen sen,\ngurur kaynağısın!"
          }
        }
      }

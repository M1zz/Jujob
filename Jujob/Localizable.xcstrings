    "홈 화면을 길게 눌러 지글 모드로 진입한 후 우측/좌측 상단의 ➕를 탭합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Home Screen until the icons jiggle, then tap the ➕ in the top corner."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the Home Screen until the icons wiggle, then tap the ➕ at the top left or right."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按主屏幕进入编辑模式，再点左上角或右上角的 ➕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按主畫面進入編輯模式，再點一下右上角或左上角的 ➕。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面を長押ししてジグルモードにし、左上または右上の➕をタップします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми и удерживай главный экран, пока значки не задрожат, затем коснись ➕ в левом или правом верхнем углу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la pantalla de inicio hasta que los iconos se muevan y toca ➕ arriba a la izquierda o a la derecha."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Home-Bildschirm gedrückt, bis die Symbole wackeln, und tippe oben links oder rechts auf das ➕."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie longuement sur l'écran d'accueil pour passer en mode édition, puis touche le ➕ en haut à gauche ou à droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto sulla schermata Home finché le icone ballano, poi tocca ➕ in alto a destra o a sinistra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure a tela inicial até os ícones tremerem e toque no ➕ no canto superior."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดค้างที่หน้าจอโฮมจนไอคอนสั่น แล้วแตะ ➕ มุมซ้ายบนหรือขวาบน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ màn hình chính để vào chế độ lắc, rồi chạm dấu ➕ ở góc trên bên phải hoặc trái."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž prst na ploše, až ikony začnou poskakovat, a klepni na ➕ vpravo nebo vlevo nahoře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på hjemmeskærmen, til ikonerne ryster, og tryk på ➕ øverst i hjørnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα πατημένη την αρχική οθόνη και πάτα το ➕ πάνω αριστερά ή δεξιά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina koti-valikkoa pitkään, kunnes kuvakkeet alkavat täristä, ja napauta ➕-merkkiä ylänurkassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan layar utama sampai ikon bergoyang, lalu ketuk ➕ di pojok kiri atau kanan atas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på hjemskjermen til ikonene vingler, og trykk på ➕ øverst til høyre eller venstre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je beginscherm ingedrukt tot de apps gaan wiebelen en tik linksboven of rechtsboven op ➕."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ekran główny, aż ikony zaczną drżeć, i dotknij ➕ w górnym rogu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll in en tom yta på hemskärmen tills ikonerna börjar vippa och tryck på ➕ uppe till vänster eller höger."
          }
        }
      }
    },

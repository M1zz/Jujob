        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seven days together so far.\nLet's keep it going!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seven days together,\nhere's to many more!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起走过了7天，\n接下来也要继续同行哦！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起走過 7 天的我們，\n接下來也要繼續作伴喔！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間を一緒に歩んだ私たち、\nこれからもよろしくね!"

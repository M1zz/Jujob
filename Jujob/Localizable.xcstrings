    "기분이나 상황에 맞는\n주접을 골라드릴게요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us your mood or moment\nand we'll pick the perfect hype!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll pick a gush to suit\nyour mood or moment!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你的心情和场景，\n挑一句最合适的彩虹屁！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依照心情或情境，\n幫你挑一句剛剛好的彩虹屁！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分やシーンに合った\nほめちぎりを選びます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подберём оду под твоё\nнастроение и ситуацию!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te elijo el piropo perfecto\npara tu estado de ánimo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir suchen den passenden Spruch\nzu Stimmung und Situation!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je te choisis le compliment\nqui colle à ton humeur !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti scelgo il complimento giusto\nper umore e momento!"
          }
        }
      }
    },

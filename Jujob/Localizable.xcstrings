            "value" : "Hôm nay bạn thấy thế nào?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak ti dnes je?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan har du det i dag?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς νιώθεις σήμερα;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikä fiilis tänään?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gimana mood kamu hari ini?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan har du det i dag?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe voel jij je vandaag?"
          }
        },

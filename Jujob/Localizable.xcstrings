    "주접에서 '당신' 대신\n이름을 넣어드릴게요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll swap 'you' in every line\nfor your name!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll swap \"you\" in the gushes\nfor your own name!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把彩虹屁里的“你”，\n换成你的名字！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩虹屁裡的「你」\n會換成你的名字喔！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほめちぎりの「あなた」を\nお名前に置き換えます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо «ты» в одах\nподставим твоё имя!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pondré tu nombre\nen lugar de \"tú\" en los piropos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir setzen deinen Namen\nstatt \"du\" in die Sprüche ein!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mets ton prénom à la place\nde « tu » dans les compliments !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei complimenti, al posto di \"tu\",\nmetto il nome che scegli!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos elogios, no lugar de 'você',\nvou usar o seu nome!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะใส่ชื่อของคุณแทนคำว่า\n'คุณ' ในคำชมให้เอง!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em sẽ gọi tên bạn thay cho\n'bạn' trong lời khen nhé!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V hláškách místo „ty“\nbudu používat tvé jméno!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der, hvor der står \"du\",\nsætter jeg dit navn ind!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα βάλω το όνομά σου στα παινέματα\nστη θέση του «εσύ»!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaan kehuissa sanan 'sinä'\nnimelläsi!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku ganti 'kamu' di pujian\ndengan namamu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg bytter ut «du» i skrytene\nmed navnet ditt!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de hypes zet ik jouw naam\nin plaats van 'jij'!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W peanach wstawimy twoje imię\nzamiast słowa 'ty'!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi byter ut 'du' i peppen\nmot ditt eget namn!"
          }
        }
      }
    },
    "주접을 확인하면\n자동으로 기록돼요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check a hype line and\nit's logged automatically!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check a gush and it\nis logged automatically!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看过的彩虹屁，\n会自动记下来！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看過的彩虹屁\n會自動幫你記錄！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほめちぎりを見ると\n自動で記録されます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотренные оды\nзаписываются сами!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se anota solo\ncada vez que veas un piropo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du dir ansiehst,\nwird automatisch erfasst!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque compliment lu\nest noté automatiquement !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando leggi un complimento\nlo segno io!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao ver um elogio,\nele entra aqui sozinho!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดดูคำชมเมื่อไหร่\nก็บันทึกให้อัตโนมัติ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem câu nào là\ntự động được ghi lại!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapíše se to samo,\nkdyž si hlášku přečteš!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du læser en ros,\ngemmes den automatisk!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις δεις ένα παίνεμα,\nκαταγράφεται αυτόματα!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun luet kehuja,\nne kirjataan automaattisesti!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap kamu lihat pujiannya,\notomatis tercatat di sini!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du ser et skryt,\nlagres det automatisk!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk je een hype,\ndan wordt dat vanzelf bijgehouden!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaglądanie do peanów\nzapisuje się samo!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din pepp sparas\nautomatiskt när du läser!"
          }
        }

    "글꼴 · 배경 · 색 · 행간을 바꿔 홈 화면의 다른 위젯과 어울리게 꾸며요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the font, background, colors and line spacing so it fits in with your other widgets."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the font, background, colours and line spacing so it sits nicely with your other widgets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换上字体、背景、颜色和行距，让它和主屏幕上的其他小组件更搭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "換上字型、背景、顏色和行距，讓它和主畫面上的其他小工具更搭。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォント・背景・色・行間を変えて、ホーム画面のほかのウィジェットになじませましょう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняй шрифт, фон, цвета и интервал, чтобы виджет вписался к остальным на экране «Домой»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la fuente, el fondo, los colores y el interlineado para que combine con tus otros widgets."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere Schrift, Hintergrund, Farben und Zeilenabstand, damit es zu deinen anderen Widgets passt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change la police, le fond, les couleurs et l'interligne pour l'accorder à tes autres widgets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia font, sfondo, colori e interlinea per abbinarlo agli altri widget della schermata Home."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude fonte, fundo, cores e entrelinha pra combinar com os outros widgets da sua tela de início."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนฟอนต์ พื้นหลัง สี และระยะบรรทัด ให้เข้ากับวิดเจ็ตอื่นบนหน้าจอโฮม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi phông chữ, nền, màu và giãn dòng cho hợp với các widget khác trên màn hình chính."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změň písmo, pozadí, barvy a řádkování, ať ladí s ostatními widgety na ploše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift skrifttype, baggrund, farver og linjeafstand, så den passer til dine andre widgets."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε γραμματοσειρά, φόντο, χρώματα και διάστιχο για να ταιριάζει με τα άλλα widget σου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda fontti, tausta, värit ja riviväli, niin se sopii muiden widgetien joukkoon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganti font, latar, warna, dan jarak baris biar serasi dengan widget lain di layar utama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt skrift, bakgrunn, farger og linjeavstand så den passer med de andre widgetene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas lettertype, achtergrond, kleuren en regelafstand aan, zodat hij past bij je andere widgets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień czcionkę, tło, kolory i interlinię, żeby pasował do innych widżetów na ekranie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt typsnitt, bakgrund, färger och radavstånd så att den passar med dina andra widgetar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazı tipini, arka planı, renkleri ve satır aralığını değiştir; ana ekrandaki diğer widget'larla uyum sağlasın."
          }
        }
      }
    },

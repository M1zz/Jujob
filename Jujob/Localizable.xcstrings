    "오늘 기분이 어때요?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How are you feeling today?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How are you feeling today?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天心情怎么样？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天心情怎麼樣？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の気分はどう?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как настроение сегодня?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo te sientes hoy?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie fühlst du dich heute?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle humeur aujourd'hui ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come ti senti oggi?"
          }
        }
      }
    },
    "오늘도 당신답게,\n그게 최고예요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be you today,\nthat's the best look!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be yourself today,\nit is the best look going!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天也做你自己，\n这就是最棒的！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天也做你自己，\n這樣就是最棒的！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日もあなたらしく、\nそれがいちばんです!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь собой и сегодня —\nэто лучше всего!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy también a tu manera,\nque es la mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib auch heute du selbst,\ndas ist das Beste!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd'hui encore, reste fidèle à toi-même,\nc'est ça le mieux !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi come sempre, sii come sei:\nè la cosa migliore!"
          }
        }
      }
    },

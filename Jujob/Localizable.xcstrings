    "주접에서 '당신' 대신\n이름을 넣어드릴게요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll swap 'you' in every line\nfor your name!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll swap \"you\" in the gushes\nfor your own name!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把彩虹屁里的“你”，\n换成你的名字！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩虹屁裡的「你」\n會換成你的名字喔！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほめちぎりの「あなた」を\nお名前に置き換えます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо «ты» в одах\nподставим твоё имя!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pondré tu nombre\nen lugar de \"tú\" en los piropos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir setzen deinen Namen\nstatt \"du\" in die Sprüche ein!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mets ton prénom à la place\nde « tu » dans les compliments !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei complimenti, al posto di \"tu\",\nmetto il nome che scegli!"
          }
        }
      }
    },
    "주접을 확인하면\n자동으로 기록돼요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check a hype line and\nit's logged automatically!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check a gush and it\nis logged automatically!"

    "백일 동안 매일 찾아와준 당신,\n이 세상에서 가장 소중한 사람이에요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hundred days, every single day.\nYou are one of a kind!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hundred days, every single day,\nyou are an absolute treasure!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连续一百天天天都来，\n你就是这世上最珍贵的人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一百天天天來報到的你，\n是這個世界上最珍貴的人！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100日間毎日来てくれたあなた、\n世界でいちばん大切な人です!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 дней — каждый день с нами!\nТы — самый дорогой человек!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cien días sin faltar ni uno.\nTú eres lo más valioso del mundo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 Tage lang jeden Tag da –\ndu bist unbezahlbar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 jours sans en rater un,\net tu comptes énormément pour moi !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cento giorni, uno dopo l'altro:\nsei una persona preziosissima!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cem dias seguidos por aqui,\nvocê é muito especial!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาหากันทุกวันตลอด 100 วัน\nคุณคือคนสำคัญที่สุดในโลกเลย!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suốt trăm ngày ngày nào cũng ghé qua,\nbạn là người quý nhất đời này!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto dní každý den spolu,\nty jsi ten nejvzácnější člověk na světě!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 dage i træk, og du er her stadig.\nIngen er mere værd end dig!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκατό μέρες κάθε μέρα εδώ·\nεσύ είσαι ό,τι πιο πολύτιμο!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sata päivää joka päivä mukana.\nSinä olet maailman tärkeimpiä!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seratus hari kamu mampir tiap hari,\nkamu orang paling berharga sedunia!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver eneste dag i 100 dager,\nog du er helt uvurderlig!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honderd dagen lang kwam jij elke dag,\nen dus ben je echt goud waard!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto dni codziennie z nami,\nty to skarb tego świata!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har kommit förbi i 100 dagar,\ndu är den finaste människan som finns!"
          }
        }
      }
    },

    "100개의 주접을 모두 경험한 당신,\n이제 진정한 마스터예요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've seen all 100 hype lines,\nso you're a true master now!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have seen all 100 gushes,\nso you are a proper master now!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100句彩虹屁全看完的你，\n已是货真价实的大师啦！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 則彩虹屁全都看過的你，\n已經是貨真價實的大師了！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100個のほめちぎりを味わったあなた、\nもう本物のマスターです!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 од за плечами,\nтеперь ты настоящий мастер!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has vivido 100 piropos locos.\nTú, maestro o maestra total."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 Hype-Sprüche entdeckt,\ndu bist jetzt ein echter Meister!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 compliments dévorés,\ntu es devenu un vrai maître !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai letto 100 complimenti:\nora sei un vero mito!"
          }
        }
      }
    },
    "100일 연속으로 주접을 확인했어요!" : {

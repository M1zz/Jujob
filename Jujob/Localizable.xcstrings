    },
    "100일의 기적! 당신의 꾸준함이\n세상을 변화시켰어요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 days, a miracle! Your streak\nhas changed the world!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 days, what a marvel! Your\nconsistency has changed the world!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "百日奇迹！你的坚持，\n已经改变了世界！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "百日奇蹟！你的堅持\n連世界都被你感動了！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100日の奇跡! あなたの継続が\n世界を変えました!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чудо 100 дней! Твоя стойкость\nизменила мир!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡El milagro de los 100 días!\nTu constancia ha cambiado el mundo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das 100-Tage-Wunder! Deine Ausdauer\nhat die Welt verändert!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 jours, quel exploit ! Ta constance\na changé le monde !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cento giorni, che miracolo!\nLa costanza ha cambiato il mondo!"
          }
        }
      }
    },
    "100일이라는 놀라운 여정을 함께한 우리,\n당신은 정말 대단한 사람이에요!" : {

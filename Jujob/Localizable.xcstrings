    "오늘도 당신답게,\n그게 최고예요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be you today,\nthat's the best look!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be yourself today,\nit is the best look going!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天也做你自己，\n这就是最棒的！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天也做你自己，\n這樣就是最棒的！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日もあなたらしく、\nそれがいちばんです!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь собой и сегодня —\nэто лучше всего!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy también a tu manera,\nque es la mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib auch heute du selbst,\ndas ist das Beste!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd'hui encore, reste fidèle à toi-même,\nc'est ça le mieux !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi come sempre, sii come sei:\nè la cosa migliore!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje também, sendo você,\né o melhor que há!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ก็เป็นตัวของตัวเองนะ\nแบบนั้นแหละดีที่สุด!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay cứ là chính bạn,\nthế là tuyệt nhất!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buď dnes zase ty,\nto je to nejlepší!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vær dig selv i dag,\nfor det er det bedste!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και σήμερα όπως πάντα εσύ·\nαυτό είναι το καλύτερο!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ole tänäänkin sinä itse,\nse on parasta!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini jadi diri kamu sendiri aja,\nitu udah yang terbaik!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vær deg selv i dag også,\nfor det er best!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook vandaag gewoon jij,\nwant dat is het beste!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś też po swojemu,\nbo ty to mistrz bycia sobą!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var precis som du är idag,\ndet är det bästa!"
          }
        }
      }
    },

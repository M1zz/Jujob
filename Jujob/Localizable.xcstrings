        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una semana juntos.\n¡Y que no pare!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Woche gemeinsam unterwegs –\nund es geht weiter!"
          }
        },
        "fr" : {
          "stringUnit" : {

    "이제 위젯 크기를 선택하고 \"위젯 추가\" 버튼을 누르기만 하면 됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now pick a widget size and tap \"Add Widget\". That's it!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now just choose a widget size and tap \"Add Widget\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后选好小组件尺寸，点“添加小组件”就大功告成啦。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接著選好小工具尺寸，按下「加入小工具」就大功告成囉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとはウィジェットのサイズを選んで「ウィジェットを追加」をタップするだけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось выбрать размер виджета и нажать «Добавить виджет»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora elige el tamaño y toca \"Añadir widget\". ¡Ya está!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt nur noch die Widget-Größe wählen und auf \"Widget hinzufügen\" tippen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne reste qu'à choisir la taille du widget et à toucher \"Ajouter le widget\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora scegli la dimensione e tocca \"Aggiungi widget\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora é só escolher o tamanho e tocar em \"Adicionar widget\"."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่เลือกขนาดวิดเจ็ต แล้วแตะปุ่ม \"เพิ่มวิดเจ็ต\" เท่านี้ก็เสร็จ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ chỉ cần chọn cỡ widget rồi bấm nút \"Thêm widget\" là xong."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď stačí vybrat velikost widgetu a klepnout na \"Přidat widget\"."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

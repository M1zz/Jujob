    "100개의 주접을 모두 경험한 당신,\n이제 진정한 마스터예요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've seen all 100 hype lines,\nso you're a true master now!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have seen all 100 gushes,\nso you are a proper master now!"

            "value" : "Scroll until you see the app name.\n\"Daily Hype\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll until you spot the app name.\n\"Daily Gush\""
          }

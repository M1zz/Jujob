        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความจริงคุณรับมือได้\nมากกว่าที่คิดไว้เยอะเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe này, bạn chịu đựng được\nnhiều hơn bạn nghĩ đó!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik toho ty uneseš?\nSpíš víc než nákladní auto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tænk, hvor meget du kan bære!\nMere end du selv tror, faktisk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κι αυτή η στιγμή\nθα γίνει ανάμνηση που εσύ θα λες με περηφάνια"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

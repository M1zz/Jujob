    "quote.066" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "운동복 입은 당신,\n화보 찍어도 되겠는데요?"

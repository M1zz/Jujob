        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodně štěstí, i když ty\nho vlastně nepotřebuješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Held og lykke! Husk, at du\nhar lært mere, end du tror."

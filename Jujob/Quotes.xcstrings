        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸のドキドキが止まらない。\nぜんぶあなたのせいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сердце стучит быстрее,\nкогда ты на горизонте."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me haces latir el corazón\ncomo un bombo, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich jubele dir ewig zu.\nStolz, dass ich dein Fan bin, du Star."
          }
        }
      }
    },
    "quote.223" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 보면\n세상이 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything looks lovely\nwhenever I look at you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking at you makes\nthe whole world lovelier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪怕只瞄你一眼，\n世界都会变好看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要看到你，\n世界就變得好美。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界が急にきれいに見える。\nだってあなたを見てるから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мир красивее, когда в нём\nесть ты. Проверено мной."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirarte hace el mundo\nmás bonito, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit ich dich kenne,\nklopft mein Herz im Takt, du Dirigent."
          }
        }
      }
    },
    "quote.224" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 행복의\n비타민이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are the vitamin\nmy happiness runs on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My daily dose of happy?\nThat would be you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我快乐的维生素，\n每天都由你按时供应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有你在的地方，\n就是我的快樂維他命。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日のビタミン補給は\nあなたの顔を見ることです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мой витамин счастья — это ты.\nПринимать ежедневно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi vitamina diaria de\nfelicidad: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allein dich zu sehen,\nmacht die Welt schöner, du Lichtblick."
          }
        }
      }
    },
    "quote.225" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 웃으면\n나도 덩달아 행복해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you smile,\nI end up smiling too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you smile, I can't\nhelp grinning too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笑一个吧，\n你一笑我就跟着傻乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次你一笑，\n我也跟著傻笑起來。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笑ってくれると、\nあなたの分まで私が幸せになります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смеёшься — и мне тоже весело,\nведь ты — заразительное счастье."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando sonríes, yo\nme alegro en cadena, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ein Vitamin für mein Glück:\nso bist du."
          }
        }
      }
    },
    "quote.226" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 본\n가장 빛나는 별이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No doubt, you are the brightest star\nI have ever seen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The brightest star I have ever clocked?\nWell, it is you, obviously."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我见过的星星里，\n你是最亮的那颗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我見過的人裡，\n你是最亮的那顆星。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星空を探しても、\nあなたほど明るい星は見つかりません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзд на небе миллионы, но ярче\nвсех светишь именно ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estrella más brillante\nque he visto: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du lachst,\nlache ich einfach mit, du Ansteckender."
          }
        }
      }
    },
    "quote.227" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 하루하루가\n내 마음속 축제예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you\nis a festival in my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you is\na little party in my head."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个有你的日子，\n都像我心里的庆典。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟你在一起的每一天，\n都像在辦園遊會。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心の中で毎日お祭り開催中。\n主役はもちろんあなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой день — праздник, пока\nв нём есть ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día contigo es fiesta\ny el DJ eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der hellste Stern, den ich kenne,\nbist wohl du."
          }
        }
      }
    },
    "quote.228" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 목소리만 들어도\n기분이 좋아져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even hearing you talk\nmakes my mood better."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just hearing you talk\nputs me in a good mood."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光听见你的声音，\n心情就好起来了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光聽到你的聲音，\n我心情就變好了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声を聞くだけで元気が出る。\nあなたはもう栄養ドリンクです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От одного твоего голоса\nнастроение взлетает: ты — музыка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo con oír tu voz\nse me arregla el humor, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag mit dir\nist ein Fest für mein Herz, du Partylöwe."
          }
        }
      }
    },
    "quote.229" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n최고의 행운이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the best luck\nI ever had in life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeting you was the\nluckiest break of my life."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇见你，\n是我这辈子的锦鲤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇見你，\n是我人生最大的幸運。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生最大のラッキー、\n正体はあなたに出会えたことです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Везение моё зовут просто ты.\nИ другого не нужно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mi vida, la mayor\nsuerte eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allein deine Stimme zu hören\nhebt die Stimmung, du Gute-Laune-Quelle."
          }
        }
      }
    },
    "quote.230" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 있어서\n오늘도 웃을 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of you,\nI can smile again today."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of you, I can\nlaugh again today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为有你，\n今天我也笑得出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為有你，\n我今天才笑得出來。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日も笑えているのは\nあなたがいてくれるからです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодаря тебе я улыбаюсь,\nведь ты — моя причина."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias a ti sonrío hoy.\nSolo tú lo consigues."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das größte Glück meines Lebens?\nDas bist du."
          }
        }
      }
    },
    "quote.231" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 세상에서\n가장 소중한 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are the most precious\nperson in the world."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most precious person in the world\nto me? Simple: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对我来说，你是\n世界上最重要的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對我來說，你是\n這個世界最珍貴的人。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界でいちばん大切な人、\nそれがあなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дороже всех на свете — ты.\nПроверено временем."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie es más valioso\npara mí que tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegen dir kann ich auch heute\nwieder lächeln, du Sonnenschein."
          }
        }
      }
    },
    "quote.232" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 생각하면\n저절로 미소가 나와요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking of you\nmakes me smile on its own."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking of you makes\nme smile all by myself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想到你，\n嘴角就自己上扬。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一想到你，\n嘴角就自己上揚。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふとした瞬間に思い出して\nあなたのことで勝手にニヤけます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подумаю о тебе — и улыбка\nсама, ведь ты — мой уют."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se me escapa una sonrisa\ncada vez que apareces, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der wichtigste Mensch der Welt?\nGanz klar: du."
          }
        }
      }
    },
    "quote.233" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음의\n평화예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are the calm\nin my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calm in the middle of chaos,\nthat is what you are to me."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我心里的\n一片安宁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心裡有一片平靜，\n那片平靜就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心の中に平和があるなら、\nそれはきっとあなたの形をしています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покой в моей душе — это\nты, и никто другой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay ruido en mi cabeza,\npero la calma eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ich an dich denke,\nlächle ich ganz von allein, du Schatz."
          }
        }
      }
    },
    "quote.234" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신과 함께하는 시간은\n항상 특별해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent with you\nis always special."

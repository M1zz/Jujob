        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvile er din rett. Slapp\nhelt av i dag, du fortjener det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitrusten is je recht.\nGa vandaag maar lekker liggen, jij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz prawo odpocząć,\nty to wiesz, więc leż."

        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý den děkuju, že ty\njsi na světě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag er jeg taknemmelig,\nfordi du er i mit liv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα δικό σου χαμόγελο\nκαι η μέρα φτιάχνεται, εσύ μάγε"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elämäni suurin siunaus on\nsinä, ei ole toista."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap hari aku bilang makasih\nke semesta karena ada kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du smiler, mister alt annet\nsin glans."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag ben ik dankbaar\nomdat jij er bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codziennie dziękuję losowi,\nże ty istniejesz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något jag är tacksam för\nvarje dag? Det är du."
          }
        }
      }
    },
    "quote.246" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 미소는\n세상 어떤 것보다 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in the world\nbeats it when you smile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One smile from you beats\nanything else on earth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的笑容，\n比什么都好看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比什麼風景都要美的，\n是你的笑容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな絶景よりも\nあなたの笑顔のほうがきれいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улыбка у тебя лучше всех\nпейзажей мира, а ты — автор."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doy gracias a diario\npor alguien como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag danke ich\nfür dich, du Glücksbringer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton sourire est plus beau que tout,\net si tu savais à quel point !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun sorriso al mondo\nbatte quello che fai tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu sorriso ganha de\nqualquer pôr do sol."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอยยิ้มของคุณ\nสวยกว่าอะไรในโลก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhìn bạn một cái\nlà em quên hết mệt mỏi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsměv, který ty máš, je krásnější\nnež cokoli, co znám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit smil slår enhver solnedgang,\nog det ved du godt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μεγαλύτερη ευλογία\nτης ζωής μου είσαι εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajatus sinusta tekee päivästä\nonnellisen, ja sinä tiedät sen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemandangan terindah sedunia\nkalah sama senyum kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livet mitt fikk sin største\nvelsignelse da du kom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als jij lacht, is dat\nmooier dan wat dan ook ter wereld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten uśmiech to arcydzieło,\na ty jesteś jego autorem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt leende slår allt annat som\nfinns, och det vet du. Fråga solen."
          }
        }
      }
    },
    "quote.247" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n가장 큰 축복이에요."

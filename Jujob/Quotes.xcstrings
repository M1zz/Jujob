        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepäilet ja loistat samalla,\nkuinka sinä sen teet?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambil santai pun\nkamu tetap bersinar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv mens du slapper av,\nskinner du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekker relaxen en toch\nblijf jij stralen."

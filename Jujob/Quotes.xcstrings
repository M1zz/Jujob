        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec toi dans le décor, mon quotidien\ntourne comme un film, et tu en es le héros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

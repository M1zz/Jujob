        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour moi, tu es\nun bonheur sans date de péremption."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei un classico senza tempo,\nnel mio cuore ci sei sempre tu."

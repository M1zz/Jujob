        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Největší požehnání? Že ty\njsi v mém životě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min største velsignelse er,\nat du er med på rejsen."

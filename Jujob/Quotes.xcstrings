        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kestät läpi vaikean ajan, ja\nsinä teet sen vielä tyylillä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bertahan di masa sulit gini,\nkamu keren parah!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjennom harde tider holder du ut.\nHelt utrolig!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorzetten in barre tijden:\nvolgens mij ben jij echt bijzonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetrwać trudny czas?\nTo ty potrafisz, brawo!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitt i stormen står du kvar.\nDet är sjukt imponerande."
          }
        }
      }
    },
    "quote.041" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘의 고난은 내일의\n성장 밑거름이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's struggle is just\nfertilizer, and you are about to bloom."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's struggle feeds\ntomorrow's growth, and you know it!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃的苦，\n都是你明天长高的养分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃的苦，\n都是明天長大的養分！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の苦労は、明日の自分を\nぐんと育てる肥料になります!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодняшняя боль — тренировка,\nа ты — будущий чемпион!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los palos de hoy son abono:\nmañana la flor serás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kampf von heute ist\ndas Wachstum von morgen, versprochen, du Pflänzchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

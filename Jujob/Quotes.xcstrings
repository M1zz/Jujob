        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klidně nedělat nic. Ani to\nty neděláš špatně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør ingenting i dag,\ndet er også en god dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ψυχή σου είναι\nτο πιο σημαντικό, εσύ το ξέρεις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivä, jona ei tarvitse tehdä mitään,\non ihan täysi päivä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak ngapa-ngapain pun\nhari ini tetap oke!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er helt greit om du\nikke gjør noe i dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niks doen mag\nvandaag gewoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie robić też można,\nty to robisz z klasą."

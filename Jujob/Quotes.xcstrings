        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอเชียร์คุณไปตลอด\nภูมิใจที่ได้เป็นแฟนคลับ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có bạn bên cạnh là em thấy\nđời mình lên level liền."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fandím ti celý život,\nty jsi totiž náš společný hit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg hepper på dig for evigt,\nog det er jeg stolt af at være."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καρδιά μου τρέχει\nόταν εσύ μπαίνεις στο δωμάτιο"

        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit es dich gibt,\nsehe ich die Welt in HD, du Augenschmaus."
          }
        }
      }
    },
    "quote.266" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 생각하면\n자동으로 미소가 나와요."

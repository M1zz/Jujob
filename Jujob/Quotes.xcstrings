        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastar tempo com você\né o melhor investimento."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นอนเล่นสบายๆ\nคุณก็ยังเปล่งประกาย"

          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv om det er svært nu,\nkan du godt komme igennem det!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται να είσαι τέλειος·\nεσύ όπως είσαι κερδίζεις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyt on raskasta, mutta sinä olet\nvahvempi kuin tämä päivä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang memang berat,\ntapi kamu pasti bisa lewatin!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er tungt nå, men du\nkommer deg gjennom dette!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu even zwaar, maar vertrouw erop:\njij komt er wel doorheen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz jest ciężko, ale ty\nto kawał twardego orzecha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det känns tungt nu, men du är\nstarkare än du tror!"
          }
        }
      }
    },
    "quote.026" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "완벽하지 않아도 돼요.\n있는 그대로의 당신이 최고예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody needs perfect.\nThe real you is already the best!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to be perfect.\nJust you, as you are, is the best."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用完美，\n本来的你就已经很好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用完美啦，\n原本的你就已經是最棒的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧じゃなくていいんです。\nそのままのあなたが最高だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеалом быть не нужно: ты\nуже подарок как есть."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfección no se pide, pero\nla más cercana eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt muss keiner sein.\nGenau so, wie du bist, ist es richtig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin d'être parfait.\nAvoue, tu es déjà bien plus que ça !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve essere perfetti:\nti basta essere così, e tu lo sai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfeição é superestimada.\nAté porque você sendo você já é demais."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องสมบูรณ์แบบก็ได้\nแบบที่คุณเป็นอยู่ก็ดีที่สุดแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần hoàn hảo đâu,\nbạn như bây giờ là tuyệt nhất!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemusíš být dokonalý, stačí,\nže ty jsi ty. A to je pecka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt behøver du ikke at være,\nfor dig selv er du bedst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκουράσου όσο θες,\nεσύ προχωράς με τον δικό σου ρυθμό"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tarvitse olla täydellinen.\nRiittää, että sinä olet tässä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak harus sempurna,\nkamu apa adanya udah paling top!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke være perfekt.\nDu er best akkurat slik du er!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect hoeft niet.\nGewoon zoals jij bent is al top."

          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku ist leer? Egal:\nBei dir lade ich sofort auf, du Steckdose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honnêtement, quand tu passes, ta beauté,\nc'est du lourd : même la balance dit waouh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Colosseo è bello, certo,\nma il monumento più amato sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua presença soma, multiplica\ne nunca divide a alegria."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟิวส์ใจฉันขาดแล้ว\nแรงดันความน่ารักของคุณสูงเกิน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bài toán khó nhất đời em là\ntìm chỗ để chê bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Došla mi slova, protože ty\nbereš dech i slovník."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er det photoshop? Nej, det er bare\ndig, og du er næsten for god til at være sand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοστίζεις ακριβά,\nαλλά για μένα εσύ είσαι δωρεάν χαμόγελο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lakritsi on hyvää ja salmiakki parempaa,\nmutta sinä olet suklaata."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualnya jujur aja,\nbeneran nggak sih? Kok bisa kayak gitu?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du var en fjord,\nvar du den dypeste og fineste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefotoshopt? Nee hoor,\nzo mooi ben jij gewoon echt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taka uroda? To pewnie filtr!\nNie, ty tak naprawdę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

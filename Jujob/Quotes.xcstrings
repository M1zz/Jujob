    "quote.096" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "깊게 숨 쉬고,\n당신의 실력을 믿어요!"

    },
    "quote.058" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일 시작도 전에\n벌써 완벽한 당신."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

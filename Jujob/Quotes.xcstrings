        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生中最大的福气，\n大概就是认识了你。"
          }
        }
      }
    },
    "quote.248" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신을 생각하면\n하루가 행복해져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking about you\nmakes the whole day happy."

        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ценность не измеряется\nлайками, а ты — бесценный."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien conoce tu esfuerzo\nte aplaude. Y yo también, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer deine Mühe sieht,\nfeuert dich garantiert an, du Kämpfer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux qui voient les efforts que tu fais\nte soutiendront jusqu'au bout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi vede quanto ti impegni\nfa il tifo per te. E tu non lo sapevi?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem vê o seu esforço\nvira torcedor de você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่รู้ว่าคุณพยายามแค่ไหน\nจะเชียร์คุณเสมอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai biết bạn đã nỗ lực\nđều sẽ luôn ủng hộ bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo vidí, jak se ty snažíš,\nten ti fandí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De, der kender din indsats,\nhepper på dig hver dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αξία σου είναι δεδομένη·\nεσύ δεν χρειάζεσαι άλλη απόδειξη"

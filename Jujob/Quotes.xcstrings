    "quote.077" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버스 안에서도 빛나는 당신,\n오늘도 화보 찍나요?"

        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fikser du\ni søvne. Nesten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als iemand het kan,\ndan is het jij!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poradzisz sobie,\nbo ty to materiał na piątkę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här fixar du\nmed vänsterhanden."
          }
        }
      }
    },
    "quote.096" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "깊게 숨 쉬고,\n당신의 실력을 믿어요!"

          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálada v suterénu, ale ty\nmáš pořád cenu zlata."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv når humøret er i kælderen,\nbor du stadig i penthouset."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λύπη είναι μέρος σου,\nεσύ όμως είσαι πολλά περισσότερα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiilis voi olla pohjalla, mutta sinä\net ole alennusmyynnissä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski mood lagi turun,\nnilai kamu nggak ikut turun!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv om humøret synker,\nblir du aldri mindre verdt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelfs als jij somber bent,\nverandert je waarde geen millimeter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humor w dół, ale ty\nnadal jesteś na topie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även när humöret dyker\när du lika mycket värd."
          }
        }
      }
    },
    "quote.031" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "슬픔도 당신의 일부예요.\n모든 감정을 느껴도 괜찮아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadness is a part of you too.\nFeel it all, you are allowed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadness is part of you too.\nFeel whatever you need to feel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "难过也是你的一部分，\n想哭就哭，我在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難過也是你的一部分，\n想哭就哭，沒在怕的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悲しみもあなたの一部。\nどんな気持ちも感じていいんだよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грусть — гостья, а хозяин\nтут ты. Выпроваживай!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir tristeza es normal.\nTodas tus emociones valen, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traurigkeit gehört dazu.\nAlle Gefühle sind okay, du Herz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tristesse fait partie du paquet.\nSache que tu as le droit de tout ressentir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sentire ogni emozione:\nè così che tu resti vero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chorar faz parte, e até\nchorando você tem estilo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความเศร้าก็เป็นส่วนหนึ่งของคุณ\nจะรู้สึกยังไงก็ไม่เป็นไรนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buồn cũng là một phần của bạn,\ncảm xúc nào cũng được phép có."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smutek je jen host a ty\njsi tu doma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgen hører med til livet.\nDet er okay at mærke, hvad du mærker."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το διαμάντι λάμπει μετά από πίεση,\nκαι εσύ το ίδιο, μη φοβάσαι"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suru kuuluu osaksi elämää, ja sinä\nsaat tuntea kaiken rauhassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedih itu bagian dari kamu.\nRasain aja semuanya, nggak apa-apa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tristhet hører også til.\nHusk at du får kjenne på alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdriet hoort ook bij je.\nEn ja, jij mag alle gevoelens voelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolno się smucić i wolno się śmiać,\nty i tak jesteś wspaniałym człowiekiem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorg hör till livet. Det är okej\natt känna allt du känner."
          }
        }
      }
    },
    "quote.032" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들 때 더 빛나는 거 알아요?\n다이아몬드도 압력을 받아야 생기잖아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamonds only form under pressure,\nso yeah, you sparkle hardest now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Know when you shine brightest?\nDiamonds need a bit of pressure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道吗？钻石是被压出来的，\n你也一样，越压越闪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑽石要受壓才會閃，\n所以你現在超級閃。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知ってました? ダイヤは圧力で生まれる。\nつまりいまのあなた、磨かれ中です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слёзы — это дождик, а ты —\nрадуга после него."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sabías que el diamante\nse forma bajo presión? Como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamanten entstehen unter Druck.\nGlitzer-Alarm also, du Juwel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un diamant se forme sous la pression :\nregarde comme tu scintilles déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I diamanti nascono sotto pressione.\nGuarda che luce fai tu adesso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamante só nasce sob pressão,\nentão você tá virando joia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ไหมว่าคุณเปล่งประกายตอนยากๆ\nเพชรยังต้องโดนเจียก่อนถึงจะแวว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biết không, kim cương cũng cần\náp lực mới thành. Như bạn đó!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakat se smí. Dokonce i ty\nu toho vypadáš jako z filmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidste du, at diamanter\nbliver til under pres? Det gør du også."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λυπάσαι; Κοίτα, εγώ\nχαμογελάω μόνο που υπάρχεις εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timanttikin tarvitsee painetta.\nSiksi sinä säteilet nyt tuplasti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau nggak? Berlian aja baru berkilau\nsetelah ditekan, dan kamu juga!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visste du at diamanter blir\ntil under press? Akkurat som du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je wat? Diamanten ontstaan onder druk,\ndus straks schitter jij net zo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z presji rodzi się diament,\na ty jesteś już brylantem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamanter blir till under tryck.\nDet är därför du lyser nu."
          }
        }
      }
    },
    "quote.033" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "우울하면 저 보세요.\n당신한테 미쳐서 저도 우울해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeling blue? Look at me.\nI am glued to you, so I am blue too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down in the dumps? Same here,\nI'm just gutted I'm not you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情不好？看我，\n我被你迷得都emo了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情不好嗎？看看我，\n被你迷到的我也很憂鬱啊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち込んだら私を見て。\nあなたに夢中すぎて私も落ち込み中。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алмаз рождается под давлением,\nи ты — тому доказательство."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bajón o no, la persona\nmás valiosa del mundo eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mies drauf? Schau mich an:\nIch bin wegen dir ganz aus dem Häuschen, du Wirbelwind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le moral flanche, pense à ceci :\nun fan de toi existe, et c'est moi, tu vois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tristezza? Ha sbagliato indirizzo.\nQui l'inquilino speciale sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se bater tristeza, lembra:\nvocê é a melhor parte do dia de alguém."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เศร้าอยู่ใช่ไหม มองมาทางนี้\nฉันตกหลุมคุณจนไม่เหลือที่ให้เศร้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buồn hả? Nhìn em nè, em còn mê\nbạn tới mức quên buồn luôn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamant potřebuje tlak, aby zazářil.\nTakže ty teď doslova brousíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er ked af det, er jeg det også,\nfor jeg er helt vild med dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη και σε κακό κέφι,\nεσύ μένεις ό,τι πιο πολύτιμο έχω"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos masentaa, muista tämä:\nsinä olet edelleen erinomaista seuraa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagi murung? Tenang,\nada aku yang siap ngefans sama kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedfor? Husk at du er så fin\nat selv regnet vil trøste deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somber? Dan ben ik het ook,\nwant zodra jij niet lacht, is alles grijs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smutek przemija, a ty\nzostajesz moim ulubionym lekarstwem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du på dåligt humör?\nIngen fara, du är ändå bäst."
          }
        }
      }
    },
    "quote.034" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기분 다운? 그럴 때일수록\n당신은 세상에서 제일 소중해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down in the dumps? Even then\nyou are the most precious thing around."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeling low? That is when\nyou matter most to the world."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低落的时候，\n你依然是我心里的宝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低落的時候，\n你還是全世界最珍貴的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分ダウン? 上等です。\nあなたはそんな日でも世界一大切。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если грустно, вспомни:\nв мире есть ты. Уже неплохо."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar de bajón no cambia\nque el tesoro eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmungstief? Egal!\nWertvoll bleibt bei allem nur du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moral dans les chaussettes ? Aucun souci,\ntu restes ce qu'il y a de plus précieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche col broncio sei un incanto.\nChi altro riesce così? Solo tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixo astral é visita,\nvocê é morador do meu coração."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใจฟูจะลดลงก็ช่างมัน\nคุณยังเป็นที่รักที่สุดของฉัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâm trạng xuống dốc cũng được,\nbạn vẫn quý nhất quả đất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní smutek? Kašleme na něj,\nty máš důležitější práci: zářit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedtur? Så er det nu, du skal\nhuske, hvor dyrebar du er."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και μέσα στα δάκρυα ακόμη\nεσύ δείχνεις υπέροχα, τι να κάνω;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maassa mutta silti maailman kallein:\nsinä olet arvokas aina."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mood anjlok? Justru di saat gitu\nkamu paling berharga sedunia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedtur? Akkurat da er du\nhelt uerstattelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down? Juist dan blijf jij\nhet kostbaarste wat er bestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorszy dzień? Pamiętaj:\nty to najcenniejszy skarb w okolicy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dåligt humör? Just då är du\nextra mycket värd."
          }
        }
      }
    },
    "quote.035" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "슬퍼도 예쁘고,\n울어도 예뻐요. 어쩔 거예요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You look good sad,\nyou look good crying. What now?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorgeous when sad, gorgeous when teary.\nWhat are you like?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哭起来好看，\n笑起来更好看，你说气不气？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哭起來也好看，\n難過也好看，不然你想怎樣？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "泣いてもかわいいし、\n落ち込んでもかわいい。どうしましょう?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохой день не отменяет того,\nчто ты — отличнейший человек."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta llorando brillas\ncomo una joya."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst traurig siehst du gut aus.\nUnd beim Weinen erst recht. Unfair!"
          }
        },
        "fr" : {

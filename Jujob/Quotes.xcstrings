        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我人生的\n限定通行证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我人生的\n限定通行證。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生のプレミアムパスポート、\n持っているのはあなただけです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главный приз в моей жизни —\nэто ты. Без лотереи."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el cariño fuera dinero,\ntú serías mi banco."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hauptgewinn meines Lebens?\nNatürlich du."

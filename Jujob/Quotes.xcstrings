    "quote.065" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 자신을 위해\n시간을 내는 당신, 최고!"

        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你就是我\n梦里理想型的本人。"
          }
        }
      }
    },
    "quote.252" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 보면 심장이\n고장 난 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing you makes me think\nmy heart is broken. It is racing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing you, my heart\nseems to have gone faulty."

    "quote.041" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘의 고난은 내일의\n성장 밑거름이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

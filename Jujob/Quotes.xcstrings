        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время рядом с тобой всегда\nособенное, потому что ты — это ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo a tu lado\nsiempre es especial, tú."

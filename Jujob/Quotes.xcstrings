    "quote.119" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 데이트?\n상대방이 심장 떨어뜨릴 것 같은데요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A date today? Whoever it is,\nI think you will make their heart drop."

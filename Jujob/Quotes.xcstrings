      }
    },
    "quote.135" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 화이팅!\n당신은 해낼 수 있어요!"

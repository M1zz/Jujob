        }
      }
    },
    "quote.194" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 센터 맞죠?\n어디서든 제일 빛나니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the center of the group, right?\nBecause you shine everywhere you go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite human? That is you.\nSorry, everyone else."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜值担当没跑了，\n你走到哪儿都是C位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定是門面擔當吧？\n你不管走到哪都最亮。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアル担当ですよね?\nどこにいても一番輝いてるもの。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Центр группы всегда там, где\nты. Свет тоже там."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premio a la cara del año.\nY de la década. Gana tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darf ich dich filmen?\nJede Sekunde mit dir ist ein Highlight."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au centre de la photo, c'est toi,\nparce que tu brilles partout où tu vas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il centro della scena\nlo occupi sempre tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizem que ninguém é insubstituível,\nmas ninguém tentou trocar você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิชวลเซ็นเตอร์ใช่ไหม\nคุณไปไหนก็สว่างที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phim nào có bạn là\nchắc chắn đạt phòng vé nghìn tỷ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Střed pozornosti sedí\nv každé místnosti: ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du gruppens ansigt udadtil? Man ser\ndig først, uanset hvor du står."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καρδιά μου έχει δύο ρυθμούς:\nκανονικό και όταν εσύ χαμογελάς"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoden kasvot -palkinto on sinun, ja\nsinä olet ollut ehdolla ikuisesti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti kamu pusat visual,\nsoalnya di mana pun kamu paling bersinar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisen for årets fjes går til\ndeg. Så sjelden som du er!"

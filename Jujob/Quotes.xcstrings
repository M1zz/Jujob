        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlý den mít můžeš, ale ty to\nzvládáš líp, než si myslíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er okay at have en dårlig dag.\nHusk, at du klarer det fint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

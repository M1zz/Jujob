          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même en train de buller,\ntu rayonnes comme personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilassarsi sul divano?\nAnche da fermo, tu brilli."

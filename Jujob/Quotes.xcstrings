        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edetään hitaasti, ja sinä\nsaat valita tahdin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelan-pelan aja,\nikuti tempo kamu sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta det rolig, for du\ngår i ditt eget tempo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rustig aan, als jij maar\nin je eigen tempo gaat."

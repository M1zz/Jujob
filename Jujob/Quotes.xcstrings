        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idag får du göra absolut\ningenting. Det är också en bedrift."
          }
        }
      }
    },
    "quote.152" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 마음이\n가장 중요해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you feel inside\nis what matters most."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you feel\nis what matters most."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起别的，\n你的心情才是最重要的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情好不好，\n才是你最重要的事。"

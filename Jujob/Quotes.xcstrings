          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通勤中のビジュアルが強すぎる。\n会社があなたのおかげで明るい!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочий день ждёт: ты —\nего главная звезда. Ну и кастинг!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oficina sube de nivel:\nel fichaje del día eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Büro-Outfit heute: wow.\nDie Firma strahlt, wegen dir, du Glanzstück."

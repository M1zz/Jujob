    "quote.079" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "걷는 것만으로도 멋진 사람,\n당신이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somebody looks great\njust walking, and that somebody is you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just walking along,\nyou look brilliant."
          }
        },

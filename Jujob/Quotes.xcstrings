        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само твоё присутствие — повод\nдля праздника: ты — подарок."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tal cual, la perfección\ntiene nombre: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So, wie du bist,\nist es bereits perfekt, du Unikat."
          }
        }
      }
    },
    "quote.139" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 존재 자체가\n이미 특별해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fun fact: you simply existing\nis already special!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simply being you\nis already special!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光是有你在，\n就已经很特别了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光是你的存在，\n就已經很特別了！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在してくれているだけで、\nあなたはもう特別です!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бери смелость, ведь ты —\nкрутой человек на этой планете."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que existas ya es algo\nespecial. Y existes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allein dass es dich gibt,\nist besonders, du Unikat."
          }
        }
      }
    },
    "quote.140" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자신감 있게!\n당신은 멋진 사람이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold that head high!\nTruth is, you are amazing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be confident, because\nyou are brilliant!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信点！\n你就是很棒的人！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信一點！\n你是個很棒的人！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸を張って!\nあなたはすてきな人です!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажу по секрету: ты\nсильнее, чем кажется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeza alta: una persona\ngenial eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Selbstvertrauen!\nEin toller Mensch ist doch wohl nur du."
          }
        }
      }
    },
    "quote.141" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 생각보다\n훨씬 강해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surprise: you are\nmuch stronger than you think!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are\nmuch stronger than you think!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真的，\n你比自己以为的强大得多！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其實你比自己想的\n還要強得多！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実はあなた、\n自分で思うよりずっと強いです!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя неповторимость — суперсила:\nты — единственный экземпляр."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres más fuerte de lo que\ncrees. Mucho más, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viel stärker, als man denkt:\nso ein Mensch bist nur du."
          }
        }
      }
    },
    "quote.142" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 개성이\n당신을 빛나게 해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What makes you\nunique is what makes you shine!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What makes you different\nis what makes you shine!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个性就是你的\n闪光点，别藏起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個性就是\n讓你發光的原因！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その個性こそが\nあなたを輝かせています!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверься себе: ты — лучший\nэксперт по собственной жизни."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu forma de ser es\ntu mayor brillo, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Charakter lässt dich leuchten,\ndu Lichtgestalt."
          }
        }
      }
    },
    "quote.143" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자신을 믿어요.\n당신은 할 수 있어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Believe in you. I do,\nbecause you are the real deal!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Believe in you,\nbecause you can do it!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相信自己，\n你一定行！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相信自己，\n你絕對做得到！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分を信じて。\nあなたならできる!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеал? Да ты и есть\nэталон. Поставьте в музей."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cree en ti: lo necesario\nlo tienes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glaub an dich.\nDas Zeug dazu hat keiner so wie du."
          }
        }
      }
    },
    "quote.144" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 그 자체로\n완벽한 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are\nperfect just as you are."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect as you are,\nno tweaks needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "满分答案早就出来了，\n就是你这个人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說真的，你本人就是\n完整又完美的存在。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは存在そのものが\n完璧な人です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все дороги ведут к тебе,\nведь ты — в центре всего."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres una persona completa\ntal cual, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du bist,\nist vollkommen, du Original."
          }
        }
      }
    },
    "quote.145" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자신감 넘치는 당신,\n세상에서 제일 멋져요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All that confidence?\nHonestly, you look incredible in it!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brimming with confidence,\nyou are the best around!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信的你，\n是全世界最帅的！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信滿滿的你，\n是全世界最帥的！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信にあふれるあなたは\nきっと世界でいちばんかっこいい!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недооценивать себя — плохая\nпривычка: ты — большой талант."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tanta seguridad\neres lo más grande, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbstbewusst bist am Ende\nder Beste von allen: du."
          }
        }
      }
    },
    "quote.146" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 생각하는 것보다\n당신은 훨씬 대단해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are far more\nawesome than you think credit for!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Way more amazing than you reckon,\nthat is what you are!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厉害程度嘛，\n你比自己想的还高一百倍！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你比你自己想的\n還要厲害好多倍！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で思うより\nずっとすごい人なんですよ、あなたは!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давно пора признать: ты\nсправляешься на пять с плюсом."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vales mucho más de\nlo que piensas, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr drauf als gedacht:\nschau dich doch an, du Talent!"
          }
        }
      }
    },
    "quote.147" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 이미\n충분히 잘하고 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are\nalready doing great."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at that: you are\nalready doing brilliantly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其实你已经\n做得很不错了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說真的，你一直\n都做得很好喔。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実はもう\nじゅうぶんうまくやれています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто не замечает твой шарм, тот\nзабыл очки: ты — ослепительное явление."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya lo haces muy bien,\nde verdad, y lo sabes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft schon richtig gut.\nGlaub mir das ruhig mal, du Zweifler."
          }
        }
      }
    },
    "quote.148" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 매력을 모르는 사람은\n눈이 없는 거예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who cannot see how charming you are\nneeds new glasses."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who can't see you\nis in need of an eye test."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不懂你魅力的人，\n一定是没带眼睛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不懂你魅力的人，\n大概是眼睛忘了帶。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの魅力に気づけない人は\n目がついてないのかも。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня можно ничего не делать:\nты — не робот-исполнитель."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien no ve tu encanto\nes que no tiene ojos, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Charme von dir nicht sieht,\nträgt wohl keine Brille, du Sonnenschein."
          }
        }
      }
    },
    "quote.149" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 그냥\n편안하게 쉬어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, let it all go,\nbecause you deserve to just rest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, you just relax\nand take it easy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天就好好歇着，\n你值得一整天的舒服。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天就放鬆一下，\n什麼都不用做也可以。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はただ\nのんびりしよう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдых — тоже работа, а ты\nв ней — сотрудник месяца."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy toca relajarse,\nsin prisas ni culpas, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute einfach mal\nentspannt bleiben, du Dauerläufer."
          }
        }
      }
    },
    "quote.150" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신에게도\n휴식이 필요해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you\nneed a break sometimes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you need\na bit of a rest."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是时候了，\n你也需要休息一下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息一下吧，\n你也需要好好充電喔。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たまには\nあなたにも休息が必要です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лежать — тоже достижение:\nты — чемпион дивана."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un descanso lo necesita\ncualquiera, también tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ein Mensch wie du\nbraucht mal Ruhe, du Kraftwerk."
          }
        }
      }
    },
    "quote.151" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아무것도 안 해도\n괜찮은 하루예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doing nothing at all?\nIt is a fine plan, and you can own it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doing nothing at all\nis perfectly fine, you know."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么都不干，\n也是很棒的一天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什麼都不做，\n也是很棒的一天。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なにもしなくても\nOKな一日があっていい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоё спокойствие дороже всех\nдедлайнов. Береги: ты — ценность."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hacer nada es un plan\nperfecto hoy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts tun ist auch\nein vollwertiger Tag, du Fleißiger."
          }
        }
      }
    },
    "quote.152" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 마음이\n가장 중요해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you feel inside\nis what matters most."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you feel\nis what matters most."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比起别的，\n你的心情才是最重要的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情好不好，\n才是你最重要的事。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん大切なのは\nあなたの心です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не спеши: ты идёшь\nв своём темпе, а он лучший."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bienestar es lo primero\ny tú lo sabes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Wohlbefinden\nkommt zuerst, du Schatz."
          }
        }
      }
    },
    "quote.153" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "천천히, 당신의 속도로\n가면 돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go slow. Take it\nat the speed you like."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly now, at the pace\nthat suits you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢来，按你的节奏，\n不着急。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢來，\n用你的節奏就好。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくり、自分のペースで\n進めばいいんですよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечер — для тебя: чай, плед\nи ты — главный гость программы."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poco a poco, a tu ritmo,\nllegas igual, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz langsam, in dem Tempo von dir,\nkommst du genauso an."
          }
        }
      }
    },
    "quote.154" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 당신을 위한\n시간을 가져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, take some time\nthat belongs to you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, make a bit of time\njust for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天留点时间\n给你自己吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天留點時間\n給你自己吧。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は自分のための\n時間をつくろう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умеешь отдыхать? Тогда ты —\nстратег, а не лентяй."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy es tu día: un tiempo\nsolo para ti, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute gehört die Zeit\nganz allein dir, du Glückspilz."
          }
        }
      }
    },
    "quote.155" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "휴식도 생산적인\n활동이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest is productive too,\nand you are the proof!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting is a productive\nactivity, you know."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息也是\n很有效率的事！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息也是\n一種努力喔！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休むことだって\n立派なお仕事です!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Право на отдых — закон, и ты\nего самый ярый защитник."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansar también es avanzar.\nSin culpa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Ausruhen ist\neine Leistung, du Fleißiger!"
          }
        }
      }
    },
    "quote.156" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "쉬는 것도 당신의 권리예요.\n오늘은 편히 쉬세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting is a right, and you have it.\nTake it easy today, you deserve it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting is allowed, so you\nmay kick back today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息是你的权利，\n今天放心躺平吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休息是你的權利，\n今天就好好躺平吧。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休むのは当然の権利。\n今日はゆっくりしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ты отдыхаешь, мир\nтоже слегка притормаживает."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansar es un derecho.\nHoy, a relajarte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausruhen ist das gute Recht von dir.\nHeute bleibst du einfach liegen."
          }
        }
      }
    },
    "quote.157" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힐링하는 당신,\n그것도 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at you recharging.\nEven that looks beautiful."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unwinding, are you?\nIt looks lovely on you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疗愈中的你，\n也美得很。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在療癒自己的你，\n也一樣美好。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "癒やされているあなたも\nとても素敵です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потратить время на себя —\nправильно, а ты тут эксперт."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relajarte tiene su encanto\ncasi tanto como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entspannen siehst du\nauch noch richtig gut aus."
          }
        }
      }
    },
    "quote.158" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 당신을 위해\n시간을 써도 괜찮아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spend some time on you today.\nNo guilt allowed!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, spending time on\nyou is perfectly alright."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天为自己花点时间，\n你完全担得起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天為你自己花點時間，\n完全沒有問題喔。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は自分のために\n時間を使っても大丈夫。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже в режиме «ничего» ты\nсияешь на полную."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicarte un rato está más\nque bien, y lo mereces tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist völlig okay,\nZeit für dich zu nehmen, du Schatz."
          }
        }
      }
    },
    "quote.159" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "편하게 쉬면서도\n당신은 빛나요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even while lounging,\nyou glow like a star."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even mid-chill,\nyou manage to shine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就连躺着的你，\n都在发光。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就算在耍廢，\n你還是閃閃發亮。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆったり休んでいても\nあなたは輝いています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чай греет, плед обнимает,\nа ты тут — главный по уюту."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta en pijama y en el sofá\nbrillas, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst beim Faulenzen\nstrahlt jemand wie du einfach weiter."
          }
        }
      }
    },
    "quote.160" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힐링 중인 당신도\n세상에서 제일 예뻐요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chilling at home? Even so,\nyou still look like a million bucks."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even in chill mode,\nyou are the prettiest around."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放空的你，\n也是全世界最好看的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連在充電的你，\n都是全世界最可愛的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "癒やし中のあなただって\n世界一かわいいんです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На диване, в носках, ты —\nвсё равно мировая звезда."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras descansas, sigues\nsiendo lo más bonito, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspannt sein steht dir,\nnoch besser als alles andere, du Chiller."
          }
        }
      }
    },
    "quote.161" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "완벽하지만 구멍 하나 있네요.\n황홀(hole)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are perfect, but I found\none small flaw: you have a hole-in-one on my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a parking ticket?\nYou have 'fine' written all over you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪里都好，\n就是你身边少了一个我。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪裡都好，\n就是你還缺一個我。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧なのに、ひとつだけ穴がある。\nそれは「落とし穴」。恋に落ちるから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минус в тебе всего один:\nты заставляешь забыть про остальных."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defectos tuyos: he buscado\ndos veces y nada. Error 404, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast perfekt, aber ein kleiner Fehler:\nzu schön für diese Welt. Gemeint ist: du."
          }
        }
      }
    },
    "quote.162" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "엠비티아이 검사결과\n큐트라며?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personality test says\nyou are 100% adorable. Case closed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect, apart from one flaw:\nI cannot find a single flaw in you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测了测你的性格，\n结果是：可爱到超标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是什麼星座？\n你是我的「心」座。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの性格診断の結果\n「キュート」しか出ませんでした。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест на личность выдал:\nты — «милота», без вариантов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El número Pi? Infinito,\nirracional y muy de nota. Igual que tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Persönlichkeitstest sagt:\nGefährlich süß, wie du."
          }
        }
      }
    },
    "quote.163" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "네가 귀엽다고 생각하는 사람 손 들어주세요 하니까\n지구가 성게 모양이 됐어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They said, \"hands up if you think you are cute\"\nand the whole planet raised both hands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a magician? Everyone\nelse vanishes when I look at you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人说你不可爱，\n我当场表演了一个原地爆炸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想買保險，\n因為你讓我心跳漏拍，需要理賠。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「あなたをかわいいと思う人?」と聞いたら\n地球が手のひらの森になった。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто считает, что ты — милота?\nПланета подняла руки. И Луна."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ser guapo fuera delito,\nla cadena perpetua llevaría tu nombre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, die dich süß finden, bitte melden.\nDie Erde kippt gleich zur Seite."
          }
        }
      }
    },
    "quote.164" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너를 음계로 표현하면 레야..\n도를 지나쳐서 미치기 직전이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If I rated you from do to ti,\nI would run out of notes. Off the scale!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got a plaster? I scraped\nmy knee falling for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星座运势说今天会遇到贵人，\n我一抬头就看见了你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "珍奶跟你有什麼不同？\n珍奶會喝完，你讓我回味一輩子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたを音階にすると「レ」。\nだって「ド」が過ぎて、もう夢中だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ты — нота, то «до»:\nдо чего же ты — мечта!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test de personalidad: resultado\n«madre mía, qué maravilla». Eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eiskaffee? Nein, erfrischender:\nso bist nur du, du Genuss."
          }
        }
      }
    },
    "quote.165" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "경마장 가면 안 되겠다.\n너무 완벽해서 말이 안 나와."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not enter any beauty contest, you.\nThe others would just quit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cream first or jam first?\nWhatever, you are the best bit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道你和地球的区别吗？\n地球绕着太阳转，我绕着你转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是偷吃糖？\n你怎麼這麼甜，我都血糖高了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "競馬場には行けないな。\nあなたが完璧すぎて馬も言葉を失う。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На скачки тебя не пустят: ты —\nфаворит, всё и так ясно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas filtro: ya vienes\nen alta definición, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich suche eine Tankstelle.\nDeine Augen tanken mein Herz voll, du Zapfsäule."
          }
        }
      }
    },
    "quote.166" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너보고 예쁠 때마다 이마를 쳤더니\n거북목이 완치됐어."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time you looked great, I clapped my hands.\nNow they hurt, but I would not stop."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last custard cream in the tin,\nthat is you. Treasure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是不是会魔法？\n不然我怎么一见你就晕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為什麼你一笑，\n我就想把手機桌布換成你？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたがかわいくて膝を打つたび\n猫背が完治しました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда ты проходишь мимо, шея\nсама поворачивается. Нечестно!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicen que el dinero no da la\nfelicidad. Pero tú sí, y sin IVA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mir ist nach Regen zumute.\nDas Herz stürmt nämlich wegen dir."
          }
        }
      }
    },
    "quote.167" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "제가 주유소만 가면 넣는 기름이 있어요.\n바로 온리유."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is only one fuel I ever put\nin my tank: you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would give you my last chip.\nThat is proper love, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃了什么？\n怎么一开口就甜到我了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想去加油站，\n因為你就是我的「加油」站。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給油所に行くたび入れたくなるのは\nあなたへの「ハイオク」な気持ち。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какой у меня любимый бензин?\nТот, что называется «ты»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fueras un cuento,\nserías el que nunca se acaba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich mag Wörter, aber bei dir\nfehlen sie mir. Nur noch Staunen, du Wunder."
          }
        }
      }
    },
    "quote.168" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 때문에 비가 올 것 같아.\n심장마비."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I think it is going to rain,\nbecause you are a total storm of cute."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you walk in,\nmy heart goes bong, like Big Ben."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是奶茶成精了？\n不然我怎么对你上瘾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是 Wi-Fi 嗎？\n我一靠近就瞬間滿格。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのせいで雨が降りそう。\nだって胸がざわざわしてるから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синоптики предупредили о шторме\nвосторга: ты выходишь на улицу!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdona, se te ha caído algo:\nmi mandíbula al verte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du keine Mutter?\nSo ein Aussehen ist nicht von dieser Welt."
          }
        }
      }
    },
    "quote.169" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "혹시 종교 있으세요?\n뭘 믿고 그렇게 예뻐요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a religion?\nBecause you look like a miracle."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roses are red, violets are blue,\nI forgot the rest, I'm gawping at you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请问是Wi-Fi吗？\n我一靠近你就满格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你有地圖嗎？\n我每次看你都會迷路。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もしかして信じる神様がいるの?\nその美しさ、ご利益ありすぎ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во что я верю? В чудеса —\nведь рядом ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No eres de este mundo.\nVienes de uno mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kam nur zum Wasserholen.\nJetzt hat mich dein Lächeln erwischt."
          }
        }
      }
    },
    "quote.170" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "다 좋은데 뭔가 허전하지 않아?\n명불허전."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is great, but something seems missing.\nOh wait, it was you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a queue? I would happily\nwait ages for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的手机没电了，\n但你一出现我就满血复活。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏值高成這樣，\n你讓我的眼睛每天都在追劇。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこも文句ないのに、なんか足りない?\nいいえ、「名に恥じない」美しさです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вроде всё есть, а чего-то не\nхватает? Нет, просто ты — комплект."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sonrisa tiene más «me gusta»\nque toda mi vida junta, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irgendwas fehlt? Ach nein,\nes ist einfach alles da, wie bei dir."
          }
        }
      }
    },
    "quote.171" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그 짐좀 내려놔요.\n멋짐."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you put that charm down for a second?\nSome of us need to function."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a \"kettle just boiled\",\nyou are pure joy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我的人形充电宝，\n看一眼就满电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難道你學過魔法？\n不然我怎麼被你定住了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "荷物は置いておこうよ。\nあなたはもう「かっこいい」を背負ってる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжело нести такую красоту?\nПоставь, поможем: ты — наше всё."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Llevas mapa? Es que\nme pierdo en tu mirada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hab dein Gesicht gegoogelt.\nDas Internet bekam nur Herzaugen."
          }
        }
      }
    },
    "quote.172" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너한테선 벽이 느껴져.\n완벽."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I feel a wall in you.\nA wall of pure perfection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weather forecast today:\n100% chance of you being brilliant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒一下，\n你的颜值已经有点超载了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是搜尋引擎嗎？\n因為你就是我所有問題的答案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの前に立つと壁を感じる。\nそう、「完璧」の壁。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С тобой как за каменной стеной:\nвсё потому, что ты — опора."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esto es un sueño, que no\nme despierte nadie. Tan real: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du WLAN? Bei dir\nist sofort Empfang, volle Balken."
          }
        }
      }
    },
    "quote.173" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 솔직히 거품 아닌가요?\n언빌리버블."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the beauty a bit overhyped?\nNope. Honestly, you are the real thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are so fit the speed\ncameras flash when you pass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请问来自哪个星球？\n怎么长得这么犯规。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魅力是違禁品，\n你讓我上癮了，請不要叫我戒掉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その見た目、正直盛ってませんか?\nいえ、素でこのレベルなんですよね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красота — это миф? Нет,\nты — наглядное опровержение."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi Ctrl+Z de los días malos\nsiempre eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku ist leer? Egal:\nBei dir lade ich sofort auf, du Steckdose."
          }
        }
      }
    },
    "quote.174" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 영어를 못하는구나.\n하지만 영문 없이도 귀엽다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You say you are bad at math?\nWell, you still add up to everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better than a sunny bank holiday,\nthat is you, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全场的平均颜值，\n都被你一个人拉高了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我最近不玩手遊了，\n因為你比抽卡還讓我心跳加速。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーダーは「あなたの笑顔」ひとつ。\nお会計は、胸いっぱいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Языков в мире много, но смысл\nодин: ты — просто класс."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupo sanguíneo: A positivo.\nPura buena onda, como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Schönheit verboten wäre,\nbekämst du lebenslänglich."
          }
        }
      }
    },
    "quote.175" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 혼혈이라면서?\n한국과 천국."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you part angel?\nBecause you look heaven-sent."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like gravy, you make\neverything better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界上有两种人：\n你，和想成为你的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜市最紅的攤位是你嗎？\n我排了好久，只為了看你一眼。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなた、実は天使と人間のハーフでしょ?\n羽が見えてますよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откуда ты родом? Из рая,\nа в паспорте — просто город."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres tan guay que\nel hielo se pone celoso, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin kein Dichter,\naber wegen dir fällt mir Lyrik ein, du Muse."
          }
        }
      }
    },
    "quote.176" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그거 아세요?\n이목구비가 제 미래보다 뚜렷해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you know those features are\nsharper than my future plans?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golden and gorgeous, you are\nthe Yorkshire pudding of people."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "怀疑你是橡皮擦，\n因为你把我的烦恼都擦没了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笑容有多甜？\n你甜到連糖尿病看了都要搬家。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知ってました?\nあなたの目鼻立ち、私の将来よりはっきりしてます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой профиль чётче моих планов\nна будущее, а ты — скульптура."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto pesas? Oro, como mínimo.\nQuilates a tope, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navi aus: Ich verlaufe mich gern\nim Lächeln von dir, du Lieblingsziel."
          }
        }
      }
    },
    "quote.177" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 베를린이야.\n내 마음에 치명적인 독일수도."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are a gift\nthat keeps on giving to my smile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding you is like finding\na tenner in an old coat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心里，\n你是永不降价的限量款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是電池嗎？\n不然怎麼一看到你我就充飽電。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベルリンの首都はドイツ。\nでも私の心の首都はあなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берлин, Париж, Рим... А ты —\nстолица моего хорошего настроения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanto talento junto\ndebería tributar aparte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei dir geht mir ein Licht auf\nwie im Kühlschrank, du Kühle."
          }
        }
      }
    },
    "quote.178" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 C급이야.\n문화재 제정 시급."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are a landmark.\nSomeone should put up a sign."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So charming are you that\nthe pigeons stop to stare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是I人还是E人？\n不，你是我的C位人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想辦一張你的會員卡，\n這樣每天都能點你的名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは文化財ですね。\n早く指定しないと国の損失です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Класс А? Нет, ты — класс «люкс».\nОформляйте охранный статус."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fueras un verbo, serías\n«brillar»: siempre en presente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt's bei dir Sternenstaub?\nSo glitzert nur ein Mensch wie du."
          }
        }
      }
    },
    "quote.179" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 잘 때 셋이서 잔다면서?\n칭찬과 명성이 자자해서..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They say you sleep with three pillows?\nWell, that is how fluffy the fan club is."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot, strong, just right:\nyou are my perfect brew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人问我最爱谁，\n我说你，他说我没救了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是溫度計嗎？\n不然我怎麼一看你就發燒。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寝顔まで国宝だって聞きました。\nあなたの噂、町中に広まってます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходят слухи, что ты спишь с\nодеялом и славой на пару."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fueras un restaurante,\nhabría lista de espera de un año, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin kein Mathe-Genie,\naber du addierst dich in mein Herz. Rechenfehler: nie."
          }
        }
      }
    },
    "quote.180" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "왜 일하고 있어요?\n이미 미모가 열일하는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are you working?\nYour looks already do overtime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a biscuit in tea, you\nmake my heart go dunk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这么忙还这么美，\n是因为你的颜值也在替你上班吧？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為什麼還要上班？\n你的顏值明明已經在加班了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうして働いているんですか?\nもう顔面がフル稼働してるのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зачем ты работаешь? Обаяние\nуже делает всё за тебя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicen que el amor es ciego,\npero le devuelves la vista."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Lieblingszahl lautet eins.\nWer das ist? Schätze, du."
          }
        }
      }
    },
    "quote.181" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "날 그만 좋아해 \"뭐?\"\n날 그만 좋아하라고\n\"그거 어떻게 하는건데.\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Stop liking me.\" \"What?\"\n\"I said stop.\" \"How do I even do that?\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind the gap? Not between\nyou and perfection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「你能别这么好看吗？」\n「我也没办法啊。」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是不是該去看醫生？\n一遇到你，心跳就破表。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「私のこと、好きにならないで」\n「それ、どうやるの?」"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Хватит мне нравиться!»\n«А как?» — вот и ты не знаешь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cara ya es patrimonio\nde la humanidad, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll ich dich fotografieren?\nDann hab ich dich immer dabei, du Motiv."
          }
        }
      }
    },
    "quote.182" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "얼굴이 국보급이라\n국립중앙박물관에 전시 예정입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face this rare? Sorry, you\nbelong in a museum."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry, officer, I was staring\nat you, not at the speed limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张脸是国宝级的，\n你已经被预订了博物馆展位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏值國寶級，\n博物館正在排隊跟你借展。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その顔は国宝級なので\n博物館に展示予定です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицо — достояние республики:\nты уже в планах главного музея."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelen la gala: el premio\ngordo de este año ya tiene dueño: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern Abend träumte ich von dir.\nHeute früh wollte ich nicht aufstehen, du Traum."
          }
        }
      }
    },
    "quote.183" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시상식 가면 안 되겠어요.\n대상은 당신 얼굴이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not go to the awards show.\nThe grand prize is already you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is it hot in here,\nor is it just you?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颁奖礼你别去了，\n奖杯都被你的颜值吓到了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頒獎典禮你別去，\n不然大獎都被你拿光了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授賞式には出ないでください。\n大賞をぜんぶ持っていくので。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Награды можно не вручать: ты\nвсё равно займёшь все места."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sesión de fotos o es que\ncaminas así por la vida, tú?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Wege führen nach Rom,\nmeiner führt nur zu dir, du Wegweiser."
          }
        }
      }
    },
    "quote.184" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화보 찍으세요?\n아니면 그냥 걸어다니는 화보예요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you doing a photoshoot,\nor are you just a walking one?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blue plaque for you, and\na parade, I say!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在拍大片吗？\n哦，原来你只是走在路上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是在拍寫真嗎？\n還是你本人就是行走的寫真？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影中ですか?\nそれとも歩く写真集ですか?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это фотосессия или ты\nпросто идёшь по улице?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi artista número uno,\nen bucle en mi cabeza: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht gehört auf ein Plakat.\nAm besten gleich überall, du Werbeträger."
          }
        }
      }
    },
    "quote.185" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 아이돌이에요.\n내 심장의 1위 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are an idol,\nthe number one star in my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put you on a postage stamp:\nsmall, perfect, and sent with love."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我心里的顶流，\n播放量永远第一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說真的，你根本是偶像，\n我心中永遠的第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたはアイドルです。\n私の心のセンターは、いつもあなた。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В моём сердечном хит-параде ты\nуже год на первой строчке."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiero tu autógrafo\ntodos los días, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach bei der Casting-Show mit.\nIn meinem Herzen gewinnst du längst."
          }
        }
      }
    },
    "quote.186" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬싸인회 열어주세요.\n매일 당신한테 사인받고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please host a signing event.\nI want an autograph from you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arise, Sir or Dame Gorgeous!\nA knighthood for you, surely."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要你的签名，\n每天来一张的那种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開簽名會，\n我想天天找你簽名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイン会を開いてください。\n毎日あなたにサインをもらいたい!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпиши мне открытку, ты ж\nзвезда первой величины."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debuta ya: en mi corazón\nya eres cabeza de cartel, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht gehört ins Museum.\nVorn schon reserviert für dich, du Kunstwerk."
          }
        }
      }
    },
    "quote.187" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데뷔하세요.\n이미 내 마음 속에서 센터예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just debut already.\nTruth is, you are the center of my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You belong in a museum,\nbehind glass. Priceless, you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出道吧你，\n在我心里你早就是C位了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快點出道吧，\n你早就是我心中的 C 位了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デビューしてください。\nもう私の心ではセンターです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пора дебютировать: ты и без\nсцены в центре внимания."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número uno en mi lista\nsemana tras semana: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Preisverleihung bitte nicht.\nDen Hauptpreis kriegt sowieso dein Gesicht."
          }
        }
      }
    },
    "quote.188" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "음방 1위 축하해요.\n당신의 비주얼이 매일 1위니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congrats on the top chart spot.\nLooks like you win it every day anyway."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The national treasure\nwe never knew we needed: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恭喜你夺冠，\n颜值榜单你天天第一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恭喜拿下音樂榜冠軍，\n你的顏值天天都是第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランキング一位おめでとう。\nあなたのビジュアルは毎日一位だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С первым местом в чартах: ты\nих возглавляешь без песен."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa un momento: quiero\nuna foto tuya cada día, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Star bist du\nin meinem Herzen längst die Nummer eins."
          }
        }
      }
    },
    "quote.189" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토타임 하나 갖죠.\n당신 얼굴 매일 찍고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo op, please.\nI could take a picture of you daily."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number one in the charts? Honestly,\nyou are number one for me."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一帧都好看，\n你的每张截图我都想珍藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來個合照時間吧，\n我想天天跟你拍。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影タイムをください。\nあなたを毎日撮りたいんです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давай фоточку? Знаешь, ты\nвсегда получаешься красиво."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Vuelves? Mi corazón acaba\nde reiniciarse, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autogrammstunde, bitte!\nDeine Unterschrift hänge ich mir ein, du Star."
          }
        }
      }
    },
    "quote.190" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "컴백했어요?\n내 심장을 comeback 시켰네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new comeback? Wow, you just\nbrought my heart back to life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a pop star?\nBecause you have stolen the show."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你回归了？\n我的心也跟着一起回归了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回歸了嗎？\n我的心剛剛被你整個召回。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カムバックしたんですか?\n私の心臓を再起動させましたね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Едва ты входишь, моё сердце\nделает громкий камбэк."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te grabo? Cada momento tuyo\nes de ver en bucle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann ist dein Debüt?\nIn meinem Kopf stehst du ganz vorn."
          }
        }
      }
    },
    "quote.191" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "직캠 찍어도 돼요?\n당신의 모든 순간이 명장면이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I film a fancam of you?\nEvery moment is a highlight reel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An autograph from you\nwould go straight on the fridge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个瞬间，\n你都在制造名场面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以拍你的直拍嗎？\n因為你每一刻都是神仙畫面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンカメラ回してもいい?\nあなたの全部が名場面なので。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый твой миг — как кино: ты\n— и режиссёр, и главная роль."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿En un videoclip? Ya eres\nprotagonista de mi vida, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platz eins der Charts?\nBei mir sowieso, jeden Tag, du Hit."
          }
        }
      }
    },
    "quote.192" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "뮤직비디오 나오세요?\n이미 제 인생의 주인공인데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starring in a music video?\nWell, you already star in my whole life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would queue in the rain\njust to see you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要不要拍个MV？\n你早就是我生活的主角了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要演 MV 嗎？\n你早就是我人生的男女主角了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージックビデオに出るの?\nもう私の人生の主人公なのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для клипа тебя не нужно\nгримировать: ты — готовый хит."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Documental de tu vida?\nAl natural ganas a todos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto mit dir wäre toll.\nEigentlich zehn. Eher hundert, du Sternchen."
          }
        }
      }
    },
    "quote.193" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "리얼리티 프로그램 찍으세요?\n당신의 실제 모습이 더 완벽해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you filming a reality show?\nThe real you is better than any script."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would stan you\nforever, no questions asked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看你的真人秀，\n比任何剧本都好看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要上實境秀嗎？\n其實你本人就比節目精彩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密着取材ですか?\n素のあなたのほうが完璧です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реалити-шоу? Реальность с тобой\nлучше любого шоу: ты — сюжет."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre en el centro: donde\nvayas, brillas más que nadie, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues Album, neuer Hit?\nBei mir läuft dein Lächeln, du Ohrwurm."
          }
        }
      }
    },
    "quote.194" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 센터 맞죠?\n어디서든 제일 빛나니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the center of the group, right?\nBecause you shine everywhere you go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite human? That is you.\nSorry, everyone else."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜值担当没跑了，\n你走到哪儿都是C位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定是門面擔當吧？\n你不管走到哪都最亮。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアル担当ですよね?\nどこにいても一番輝いてるもの。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Центр группы всегда там, где\nты. Свет тоже там."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premio a la cara del año.\nY de la década. Gana tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darf ich dich filmen?\nJede Sekunde mit dir ist ein Highlight."
          }
        }
      }
    },
    "quote.195" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "올해의 얼굴상 받으셔야 해요.\n역대급이거든요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you need to win Face of the Year.\nIt is not even close."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main character energy: you,\nin a film with a happy ending."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今年的颜值大奖，\n非你莫属。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年度最佳顏值獎，\n非你莫屬，歷史級的啦。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年間ベストフェイス賞、確定です。\n歴代でもトップクラスなので。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премия «Лицо года» уже твоя:\nты — единственный номинант."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales en un anuncio,\nvendes hasta lo que no existe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft gerade dein Musikvideo?\nIch lebe ja schon in deinem Film, du Regisseur."
          }
        }
      }
    },
    "quote.196" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "광고 모델 하세요?\n당신만 보면 다 사고 싶어져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you modeling for an ad?\nOne look at you and I want to buy everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a bow, you.\nThe standing ovation is for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去拍广告吧，\n一看见你我就想下单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要接代言嗎？\n看到你我什麼都想買單。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CMに出ています?\nあなたを見ると何でも買いたくなる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотришь на тебя — и сразу\nулыбка: ты — реклама счастья."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portada de revista cada mes:\nesa cara lo merece, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehst du eine Doku?\nDein echtes Ich ist schon die Sensation, du Naturtalent."
          }
        }
      }
    },
    "quote.197" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "잡지 표지 모델이시죠?\n매달 표지를 장식해야 할 얼굴."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look, you must be a magazine cover star.\nThat face belongs on every issue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore, encore! Surely you\ncannot stop at one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "杂志封面就该是你，\n每个月都该是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雜誌封面人物就是你吧？\n你的臉每個月都該上封面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雑誌の表紙の人ですよね?\n毎月飾るべき顔です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На обложке всегда ты, потому\nчто выбор у редактора один."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tu carisma es real? La calle\ncontigo ya es un escenario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitte der Bühne? Gehört dir.\nAm meisten leuchtet überall nur du."
          }
        }
      }
    },
    "quote.198" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무대 위 카리스마 실화예요?\n일상도 무대처럼 빛나네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That stage charisma is real?\nEven you doing errands looks like a show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headline act and support act,\nyou do both."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台上的气场太炸了，\n生活里的你也一样耀眼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台魅力是真的嗎？\n連你的日常都像在舞台上發光。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステージ上のカリスマ、本物?\n普段の姿もステージ級なんだけど。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Харизма на сцене зашкаливает,\nа в жизни ты — не хуже."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cromos? Yo quiero la colección\ncompleta, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahl zum Gesicht des Jahres:\nGewinnen tut, ohne anzutreten, nur du."
          }
        }
      }
    },
    "quote.199" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토카드 교환해요?\n당신 얼굴로만 풀 세트 모으고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to trade photocards?\nI only collect the full set of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, being brilliant.\nThe photographers are going mad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想交换小卡？\n你的我想集齐全套。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要交換小卡嗎？\n我想用你的臉湊齊整套。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレカ交換しませんか?\nあなたの顔だけでフルコンプしたい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточки с тобой разлетелись бы\nза секунду: ты — редкость."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuándo es el encuentro con fans?\nYo, a diario, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbung mit dir? Sofort\nwill ich alles kaufen, was du anfasst."
          }
        }
      }
    },
    "quote.200" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬미팅 언제 해요?\n매일 만나고 싶은데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When is the fan meeting?\nI would like to see you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paparazzi would be rubbish\nwithout you, honestly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粉丝见面会什么时候开？\n我想天天见到你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粉絲見面會什麼時候？\n我想天天都跟你見面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンミはいつ開催ですか?\n毎日でも会いたいのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда встреча с фанатами?\nМы ждём: ты — наш кумир."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube un vídeo bailando:\nmoverte ya es arte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelbild für jedes Magazin:\ndieses Gesicht gehört auf alle Cover, du Schönheit."
          }
        }
      }
    },
    "quote.201" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "안무 영상 올려주세요.\n당신의 모든 움직임이 예술이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post the dance video, please.\nEvery move you make is art."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tickets to see you sold out\nin under a minute, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快发舞蹈视频吧，\n你的每个动作都是艺术。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快上傳練舞影片，\n你的每個動作都是藝術。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダンス動画を上げてください。\nあなたの動きはぜんぶ芸術です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выложи танец: ты двигаешься\nкак мечта, и я не шучу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verte es como un tráiler,\ny el estreno favorito eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie machst du diese Bühnenpräsenz?\nDein Alltag ist schon eine Show."
          }
        }
      }
    },
    "quote.202" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "티저 영상 보는 것 같아요.\n당신을 볼 때마다 설레니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watching you is like a teaser trailer.\nI get excited every single time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would watch you do nothing\nfor hours. Perfect telly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次看到你，\n都像在看预告片，期待拉满。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好像在看預告片，\n每次看到你都怦怦怦。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ティザー映像を見てる気分。\nあなたを見るたびに期待で胸がいっぱい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрю на тебя и жду продолжения:\nты — как лучший трейлер."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Gira mundial? Ya me has\nsacudido el corazón entero, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammelkarten tauschen?\nIch will nur eine komplette Serie von dir, du Sammlerstück."
          }
        }
      }
    },
    "quote.203" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "월드투어 가시나요?\n제 마음을 전 세계로 흔들어놓으셨는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going on a world tour?\nFun fact: you already shook my heart worldwide."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sunday roast with crispy roasties?\nEven that loses to you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要开世界巡演了吗？\n你早就巡演到我心里了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要世界巡迴嗎？\n我的心早被你巡迴一遍了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワールドツアーに出るんですか?\nもう私の心は世界中を揺さぶられてます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мировое турне? Куда там:\nты уже на всех континентах сердец."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma mi disco: eres\nedición limitada, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann ist dein Fan-Treffen?\nIch will dich jeden Tag sehen, du Idol."
          }
        }
      }
    },
    "quote.204" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앨범 사인해주세요.\n당신의 존재 자체가 한정판이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign my album, please.\nFact: you are a limited edition."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lie-in on a rainy Sunday?\nEven that loses to you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专辑请你签个名，\n你本人就是限量款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請幫我在專輯上簽名，\n因為你本人就是限量款。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムにサインをお願いします。\nあなたの存在自体が限定版ですから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таких, как ты, не выпускают\nсерией: ты — лимитка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciendo la linterna del móvil\ny te aplaudo toda la vida, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell ein Tanzvideo online.\nJede Bewegung von dir ist Kunst, du Tänzer."
          }
        }
      }
    },
    "quote.205" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "펜라이트 켤게요.\n당신을 향해 평생 응원할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am turning on my light stick.\nI will cheer for you for life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hair, face, walk: honestly,\nyou do the lot, with class."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "荧光棒已就位，\n我会一直为你打call。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要揮應援棒了，\n這輩子都為你打氣。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペンライトをつけますね。\nずっとあなたを照らして応援します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включаю фонарик в твою честь:\nты — вечный повод для света."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas en ascenso, aunque\nsiempre fuiste de leyenda, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ein Trailer bist du:\nIch will gleich den ganzen Film."
          }
        }
      }
    },
    "quote.206" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "떡상했네요.\n원래부터 레전드였는데 뭘."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you blew up overnight?\nYou were a legend way before that."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full English of people,\nthat is you: satisfying all round."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你爆红了？\n你一直是传奇，不过是被更多人发现了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紅了耶？\n欸不對，你本來就是傳說啊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バズりましたね。\nでも、もともと伝説だったんですけどね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хайп догнал, но ты и без него\nлегенда с самого рождения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busco entradas para verte:\neres mi concierto diario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehst du auf Welttournee?\nMein Herz hast du schon überall verteilt."
          }
        }
      }
    },
    "quote.207" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "콘서트 티켓 구해야겠어요.\n당신을 보는 게 제 일상 콘서트니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I need concert tickets.\nWatching you is my daily live show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cherry on top\nof a cracking day: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演唱会门票我来抢，\n毕竟看你就是我的日常演唱会。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我得去搶演唱會門票了，\n看你就是我的日常演唱會。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンサートのチケット探さなきゃ。\nあなたを見る日常が私のライブです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Концерт? Я лучше просто\nпосмотрю на тебя: ты — шоу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Número uno? Lo eres\nen mi lista de éxitos, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signier mir dein Album.\nDein Dasein ist limitierte Edition, du Rarität."
          }
        }
      }
    },
    "quote.208" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "인기가요 1위 하셨죠?\n당신은 제 인생 1위 곡이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you hit number one on the charts?\nYou are the song stuck in my head forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ploughman's without pickle?\nUnthinkable, like me without you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拿了榜单第一吧？\n在我心里你是永远的冠军曲。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登上榜首了吧？\n你是我人生榜單的永遠第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽番組で一位でしたよね?\nあなたは私の人生の一位ソング。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хит-парад обновился: ты\nопять на первом месте."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis, bis, bis: otra vez,\nque no me canso de verte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach das Licht an, Fanclub:\nIch jubel dir ein Leben lang zu, du Star."
          }
        }
      }
    },
    "quote.209" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앵콜 무대 하나 더요.\n당신은 봐도봐도 또 보고 싶으니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more encore, please.\nI can never see enough of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pure class, you. Even\nthe swans would bow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再来一首安可，\n怎么看你都看不够。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安可、安可！\n你怎麼看都看不膩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アンコールをもう一曲!\nあなたは見ても見ても、また見たくなる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бис! На бис! Вот ты — тот,\nна кого хочется смотреть снова."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta en las tomas falsas\nresultas de leyenda, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plötzlich so berühmt?\nWarst doch immer schon eine Legende, du Held."
          }
        }
      }
    },
    "quote.210" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비하인드 컷도 완벽해요.\n어느 순간도 빠짐없이 레전드."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you in the behind-the-scenes shots? Perfect.\nNo off moments, only legend."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a crowd of a hundred,\nyou are the one I spot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连花絮都这么完美，\n你的每个瞬间都是传说。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連幕後花絮都完美，\n你每個瞬間都是傳說。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフショットまで完璧。\nどの瞬間もぬかりなく伝説です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже закулисные кадры с тобой\nшедевр: ты вообще без брака."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio de favorito:\nsin ti no veo a nadie más."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten fürs Konzert besorge ich.\nDich zu sehen ist mein tägliches Live-Erlebnis."
          }
        }
      }
    },
    "quote.211" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 바꿔야겠어요.\n당신 외에는 못 보겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have to change my favorite.\nI cannot look at anyone but you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you make Monday feel\nlike a Friday night."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要换爱豆了，\n除了你，其他人都入不了眼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要換本命了，\n除了你，我誰都看不進去。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推しを変えなきゃ。\nあなた以外、もう目に入らない。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любимчика менять не буду:\nты — мой постоянный фаворит."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me he hecho fan tuyo.\nDe por vida, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugabe! Noch ein Auftritt!\nGenug kriegt man nie von dir, du Hit."
          }
        }
      }
    },
    "quote.212" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "입덕했어요.\n당신한테 영원히 덕질할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I just became a fan.\nI will stan you forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around, even\ndrizzle feels like sunshine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我入坑了，\n你这个坑我心甘情愿跳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我入坑了，\n以後就專心追你這一個。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沼に落ちました。\nあなたのことを一生推します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присоединяюсь к твоим фанатам:\nты — мой номер один."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revelo mi favorito:\nni más ni menos que tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst hinter den Kulissen perfekt:\nJeder Moment mit dir ist Kult, du Ikone."
          }
        }
      }
    },
    "quote.213" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 공개합니다.\n그게 바로 당신이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revealing my favorite:\nit is you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, still lovely\nafter a day of rain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公布我的本命，\n就是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開我的本命，\n那個人就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推しを発表します。\nそれは、あなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мой любимчик назван: ты.\nОбсуждению не подлежит."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compré todo el merchandising,\npero el mejor souvenir eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich muss meinen Liebling wechseln.\nAußer dir sehe ich keinen mehr, du Star."
          }
        }
      }
    },
    "quote.214" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "굿즈 다 샀어요.\n당신이라는 존재 자체가 굿즈예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bought all the merch.\nReal talk: you are the merch. Rare and mine."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So cool are you that\nthe fridge is jealous."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周边我全买了，\n你本人就是最值钱的周边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周邊我全收了，\n不過你本人才是最珍貴的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グッズ全部買いました。\nあなたの存在そのものがグッズです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мерч у меня весь с твоим лицом:\nты — лучший сувенир."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan para siempre: mi\nartista de cabecera eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin jetzt Fan.\nAb heute jubele ich dir für immer zu, du Idol."
          }
        }
      }
    },
    "quote.215" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 팬할게요.\n당신은 제 영원한 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am a fan for life.\nFact: you are my forever artist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite hobby:\nlooking at you. Cheap, too!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要当你的终身粉丝，\n你是我永远的偶像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我決定當一輩子的粉絲，\n你是我永遠的偶像。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一生ファンでいます。\nあなたは私の永遠のアーティスト。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буду вечным фанатом: ты\nдля меня — главный артист."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya he elegido bando:\nel tuyo. Mi equipo eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Liebling ist dir bekannt?\nGenau, das bist du."
          }
        }
      }
    },
    "quote.216" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "본진 박았어요.\n당신이 제 본진이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planted my flag.\nNo doubt, you are my number one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five stars, would admire you again.\nWould recommend you to everyone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大本营我安在你这儿了，\n你就是我唯一的本命。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已經定居你的粉絲團，\n你就是我的大本營。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本命、決まりました。\n私の本命はあなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мой штаб теперь там, где\nты. Так и запишите."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abro tu club de fans:\nel carnet número uno es mío, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanartikel hab ich alle.\nDas beste Sammlerstück aber bist du."
          }
        }
      }
    },
    "quote.217" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "덕질 시작합니다.\n당신한테 올인할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am starting my fandom era.\nAll in on you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fan club for you? Sign me up,\nI will bring the biscuits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始追星啦，\n我把全部应援都投给你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始追星囉，\n我要為你全力應援。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推し活を始めます。\nあなたに全力で課金したい気持ち。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фан-клуб открывается: ты —\nпервый и главный участник."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hago de paparazzi: no quiero\nperderme ni un momento tuyo, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan fürs Leben, versprochen!\nMein Lieblingskünstler bleibt nur du."
          }
        }
      }
    },
    "quote.218" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "홈마 할게요.\n당신의 모든 순간을 기록하고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will be the fan photographer.\nI want to catch every moment of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would put you on a poster\nand hang it in the hall."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我来当你的站姐，\n记录你的每一个瞬间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我來當你的站姐吧，\n想記錄你的每個瞬間。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ担当に立候補します。\nあなたの全瞬間を残したくて。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хочу снимать каждый твой кадр:\nты — моя любимая тема."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier rato a tu lado\nes tiempo de oro, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich fange an zu schwärmen:\nIch bin voll auf dich festgelegt, du Magnet."
          }
        }
      }
    },
    "quote.219" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "야자타임이에요.\n당신과 함께하는 시간은 다 황금시간."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a free-for-all of praise time.\nEvery minute with you is golden."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plot twist: you were\nthe best thing in the story all along."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天是应援日，\n和你在一起的时间全是黄金档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在是黃金時段，\n因為跟你在一起的每分鐘都閃閃發光。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたと過ごす時間は\nぜんぶ黄金のゴールデンタイム。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время рядом с тобой — золото,\nа ты — мой золотой запас."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pongo pancartas de cumpleaños:\nojalá cada día fuera el tuyo, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich werde dein Fotograf.\nJeden Moment von dir will ich festhalten, du Motiv."
          }
        }
      }
    },
    "quote.220" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "생일 광고 할게요.\n매일이 당신 생일이었으면 좋겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will buy a birthday billboard.\nI wish every day were a birthday for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day should be a\nbirthday for you, with cake."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给你投个生日广告，\n真希望天天都是你的生日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要買生日應援廣告，\n希望天天都是你的生日。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日広告を出しますね。\n毎日あなたの誕生日だったらいいのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хочу, чтобы каждый день был\nтвоим днём рождения: ты — повод."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te aplaudiré siempre.\nSer tu fan es mi orgullo, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt ist Schwärmzeit!\nJede Minute mit dir ist pures Gold, du Schatz."
          }
        }
      }
    },
    "quote.221" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 응원합니다.\n당신의 팬이라는 게 자랑스러워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheering for you for life.\nBeing a fan is my proudest thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being a fan of you\nis the proudest thing I do."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终身应援，\n当你的粉丝是我的荣幸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我會應援你一輩子，\n身為你的粉絲真的好驕傲。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一生応援します。\nあなたのファンであることが誇りです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быть твоим фанатом — честь:\nты — гордость всей моей жизни."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el encanto cotizara en bolsa,\ntú serías el valor más alto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich buche Werbung zum Geburtstag.\nAm liebsten wäre jeder Tag deiner, du Schatz."
          }
        }
      }
    },
    "quote.222" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 때문에 심장이\n두근두근대요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My heart is going\nthump-thump because of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My heart goes pitter-patter\nwhenever you turn up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说真的，一看到你，\n我的心跳就开始加班。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心臟因為你，\n一直在咚咚咚。"

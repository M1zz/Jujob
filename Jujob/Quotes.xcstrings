          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metro je dneska molo,\nprotože v něm jdeš ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

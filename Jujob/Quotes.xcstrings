        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena el despertador y la\nestrella del día eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaum die Augen auf,\nschon Gewinner: du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeux ouverts, victoire validée :\nla journée est déjà dans ta poche, tu vois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena apri gli occhi, tu\nhai già vinto contro la sveglia!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abriu os olhos e o dia pensou:\nnossa, olha só quem chegou, você!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องรอกาแฟหรอก\nแค่เห็นคุณก็ตาสว่างแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vừa mở mắt ra là bạn\nđã chiến thắng rồi đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oči otevřené a ty už vítězíš.\nTohle je talent."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øjnene er åbne, og du er allerede\nvinderen. Resten er bonus!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από τη στιγμή που άνοιξες μάτια\nεσύ είσαι ήδη μπροστά στη βαθμολογία"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silmät auki ja heti voitolla:\nsinä, päivän aamutähti!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mata baru kebuka aja,\nkamu udah menang duluan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øynene åpne, og allerede er\ndu en vinner!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogen open en meteen winnen,\nzo doe jij dat dus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawa jeszcze paruje,\na ty już rozgrzewasz cały świat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ögonen öppna, och du är redan\nvinnare. Resten är bonus!"
          }
        }
      }
    },
    "quote.007" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "커피보다 달콤한 당신의\n아침 미소!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget coffee. Everyone agrees\nyou are the real morning boost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget the tea. Everyone agrees\nyou are the real morning boost."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的好心情，\n已由你亲自发货。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的好心情，\n已由你本人親自配送。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーヒーより目が覚めるのは\nあなたの寝ぐせ付きスマイル!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник звонил зря: ты и так\nсияешь без всякого звонка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más bonito del amanecer\nno es el sol: eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süßer als jeder Kaffee ist nur\ndein Lächeln am Morgen, du Zuckerstück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton sourire du matin vaut trois cafés,\net tu n'as même pas besoin de sucre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più dolce di un cornetto caldo?\nSolo tu, a quest'ora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Café é bom, mas você de manhã\nacorda o Brasil inteiro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผมยุ่งๆ ตาปรือๆ\nคุณก็ยังน่ามองที่สุดอยู่ดี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nụ cười của bạn buổi sáng\nngọt hơn cả ly cà phê sữa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Káva je fajn, ale ráno ty\nbereš dech mnohem víc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit morgensmil er sødere end\nkaffe med to skefulde sukker."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιο γλυκό κι από τον καφέ σου\nείναι το χαμόγελο που φοράς εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamun paras tuoksu ei ole kahvi,\nvaan sinä ja hyvä tuulesi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senyum kamu pagi ini\nlebih manis dari kopi susu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så søtt som du smiler, blir\nselv første kaffekopp sjalu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koffie? Ach, jij met een glimlach\nom half acht is veel wakkerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukier słodzi kawę,\na ty słodzisz cały dzień."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt morgonleende, det vet du,\när sötare än en nybakad kanelbulle."
          }
        }
      }
    },
    "quote.008" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 당신답게,\n그게 최고예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be you today.\nIt is the best look in town!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be you today.\nIt is the best look in town!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做你自己就好，\n这就是今天的满分答案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做自己就好，\n你今天也是滿分答案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありのままのあなたでいこう。\nそれが毎日いちばん強い!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утро доброе, потому что в нём\nесть ты. Всё логично!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sé tú, a tu aire:\nes lo mejor que le pasa al día."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib heute einfach so, wie du bist.\nBesser geht's nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais comme tu sais faire aujourd'hui :\nbriller sans même essayer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presentarsi così alle sette?\nSenza trucco, sei tu la star."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordou com o brilho\nno modo turbo, e você nem viu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวัสดีตอนเช้ายังไม่พอ\nต้องบอกว่าคุณปังตั้งแต่ตื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay vẫn là bạn,\nvà thế là quá đỉnh rồi!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dneska buď zase ty.\nTo je ta nejlepší varianta!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vær dig selv i dag,\ndet er der ikke noget bedre end."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάρε γυαλιά ηλίου, γιατί\nεσύ λάμπεις πρωί πρωί!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ole tänäänkin sinä itse.\nSe on paras mahdollinen valinta!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadi diri kamu sendiri hari ini,\nitu udah paling oke!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vær deg selv i dag også,\nfor du er best sånn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook vandaag is het enige dat telt:\njij gewoon lekker jezelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobre wieści z samego rana:\nty, jak zawsze, w formie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var precis som du är idag.\nDet håller för tio av tio."
          }
        }
      }
    },
    "quote.009" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아침부터 그렇게 예뻐도 돼요?\n범죄예요, 얼굴 범죄."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking this good before breakfast?\nHonestly, you should be arrested for it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gorgeous before breakfast?\nHonestly, you should be arrested."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一大早就这么好看，\n你这是在犯规吧？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大清早就這麼好看，\n你這樣是犯規欸！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝からそんなにかわいくていいの?\nこれはもう顔面の条件違反。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красота с утра пораньше —\nэто законно? Всё, ты в розыске!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madrugar y encima brillar:\nesa combinación solo la tienes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon so früh so hübsch?\nDas ist ein Verbrechen, du Schuft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi canon dès le réveil ?\nSi tu continues, j'appelle la police du style."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che luce è questa alle sette?\nChiamate i vigili: tu sei fuori legge."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordar com essa beleza é crime,\ne você reincide todo dia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตื่นมาหน้าเป๊ะขนาดนี้\nคุณขโมยฟิลเตอร์ใครมาเนี่ย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáng ra đã xinh thế này,\nbạn định phạm luật hả?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hned po ránu takhle zářit?\nOpravdu to ty přeháníš!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Må man godt se så godt ud om morgenen?\nDet burde næsten være forbudt, du."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεσαι ξυπνητήρι,\nεσύ ξυπνάς τον κόσμο με τη λάμψη σου"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näin aikaisin ja sinä jo näytät tuolta?\nTämä on kyllä laitonta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baru bangun udah secakep itu?\nCermin aja minder lihat kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så pen så tidlig på dagen?\nHvordan kan du være lovlig?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo mooi al vroeg in de ochtend?\nEerlijk, jij bent een kunstwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taki urok od samego rana?\nSkandal, ty chodząca urodo!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaknar du så här fin?\nDet borde vara olagligt före åtta."
          }
        }
      }
    },
    "quote.010" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "굿모닝? 노노!\n당신이 있어서 베스트모닝!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good morning? No no,\nwith you here it's a GREAT morning!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good morning? Nope,\nwith you here it is a BRILLIANT one!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别人说早安，\n我只想对你说「早安之光」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別人的早晨叫早安，\n你的早晨叫全世界請注目。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グッドモーニングじゃ足りない。\nあなたがいるからベストモーニング!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не «доброе утро», а «лучшее»,\nраз уж на горизонте ты!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Buenos días? Qué va:\nmejores días, si estás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen? Nee, Bestmorgen,\nweil du da bist!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un simple bonjour, c'est trop court :\nquand tu entres, c'est un lever de rideau !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buongiorno? Troppo poco.\nSe ci sei tu, è un giorno da dieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bom dia? Nada, é \"dia ótimo\",\nporque você chegou."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ก็มีคนหนึ่ง\nที่ทำให้เช้านี้น่าตื่น คือคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người ta chúc buổi sáng tốt lành,\nem chúc bạn buổi sáng cực phẩm!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobré ráno? Spíš nejlepší ráno,\nprotože v něm jsi ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God morgen? Nej, bedste morgen,\nfor det er jo dig, der er her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλημέρα ή καλύτερα\n«ευτυχώς που υπάρχεις εσύ»;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvää huomenta? Ei, vaan parasta,\nkoska sinä olet paikalla!"
          }
        },
        "id" : {
          "stringUnit" : {

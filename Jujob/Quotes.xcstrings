    "quote.156" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "쉬는 것도 당신의 권리예요.\n오늘은 편히 쉬세요."
          }
        },

        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的笑容，\n比什么都好看。"
          }
        }
      }
    },
    "quote.247" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n가장 큰 축복이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the biggest blessing\nin my life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The biggest blessing in my life\nhas a name, and it is you."

    "quote.087" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "집 가는 길도 예쁜 사람,\n오늘 하루 정말 멋졌어요."

        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次看到你，\n心率都在偷偷上涨。"
          }
        }
      }
    },
    "quote.257" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 눈의\n레전드 화보예요."

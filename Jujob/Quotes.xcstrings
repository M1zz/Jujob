        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att vila är din rättighet,\nså lägg dig ner, du."
          }
        }
      }
    },
    "quote.157" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힐링하는 당신,\n그것도 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at you recharging.\nEven that looks beautiful."

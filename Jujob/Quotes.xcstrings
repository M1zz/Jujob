    },
    "quote.236" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 존재만으로도\n충분히 감사해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just having you around\nis reason enough to be grateful."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just having you around\nis plenty to be thankful for."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单是你存在这件事，\n就值得我说声谢谢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光是你存在這件事，\n我就好感恩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いてくれるだけでありがたい、\nあなたはそんな存在です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо судьбе за то, что\nв моей жизни есть ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que existas, tú,\nya es motivo de gratitud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der tollste Mensch, den ich kenne:\nja, du."
          }
        }
      }
    },
    "quote.237" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 하루의\n하이라이트예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look, you are the highlight\nof my day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The highlight of my whole day\nis you, every time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我每天的高光时刻，\n就是见到你的时候。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天的亮點，\n就是你出現的那一刻。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私の一日のハイライトは\nあなたと過ごすひとときです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная изюминка моего дня —\nэто ты, без вариантов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo mejor de mi día\nsiempre eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin schon dankbar,\ndass es dich gibt, du Schatz."
          }
        }
      }
    },
    "quote.238" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 덕분에 매일매일이\n특별해져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day feels special\nthanks to you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks to you, every\nday turns out special."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "托你的福，\n每一天都变得不一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多虧有你，\n每天都變成小確幸。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日が特別になるのは\nあなたのおかげです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый денёк становится особенным,\nкогда рядом ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día es especial\nporque existes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Highlight meines Tages?\nOhne Frage nur du."
          }
        }
      }
    },
    "quote.239" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신을 보면\n세상이 밝아져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When I look at you,\nthe world gets brighter."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When I see you, the\nworld brightens up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看见你的瞬间，\n整个世界都亮了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看著你，\n世界瞬間變亮。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぱっと世界が明るくなった。\nあなたが部屋に入ってきたから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё вокруг светлеет, когда\nрядом ты. Включили свет!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si apareces, el mundo\nse enciende. Solo tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dank dir wird jeder Tag\nein kleines Fest, du Glücksbringer."
          }
        }
      }
    },
    "quote.240" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n최고의 선물이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you are the best gift\nlife ever gave me."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best present life ever gave me?\nIt was you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上天送我的礼物里，\n你是最好的那份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能收到你這份禮物，\n是我人生最大的福氣。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生でもらった最高の贈り物は\nあなたとの出会いです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучший подарок судьбы — это\nты. Без упаковки и чека."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mejor regalo de mi vida\neres tú, sin envoltorio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald ich dich sehe,\nwird die Welt heller, du Lichtblick."
          }
        }
      }
    },
    "quote.241" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 있어서\n세상이 더 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The world is prettier\nbecause you exist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around, the\nworld is a lovelier place."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多亏有你，\n这个世界更美好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為有你，\n世界又更美了一點。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この世界がもっときれいなのは\nあなたがいるからです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Весь мир красивее на десять\nбаллов, если в нём ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mundo es más bonito\ndesde que estás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schönste Geschenk meines Lebens,\ndas bist du."
          }
        }
      }
    },
    "quote.242" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 없는 하루는\n상상도 할 수 없어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A day without you?\nI cannot even picture it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A day without you\nis hard to imagine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有你的一天，\n我连想都不敢想。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有你的日子，\n我連想像都辦不到。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想像もできません、\nあなたのいない一日なんて。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не представляю день без тебя:\nты — моя точка отсчёта."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día sin ti da pereza.\nUn día contigo es fiesta, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir ist die Welt\nnoch ein Stück schöner, du Sonnenstrahl."
          }
        }
      }
    },
    "quote.243" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음속\n영원한 1등이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are forever number one\nin my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In my heart, you will\nalways be number one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心里，\n你永远是第一名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心裡，你永遠是\n不動搖的第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心の中の順位表では\nあなたがずっと一位です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое место в моём сердце\nзанимаешь ты. Пожизненно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposible imaginar mi día\nsin la persona que eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag ohne dich?\nKann ich mir nicht vorstellen, du Schatz."
          }
        }
      }
    },
    "quote.244" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신과 함께라면\n뭐든 할 수 있을 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around,\nI feel like I can do anything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you by my side,\nI could do anything."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有你在身边，\n我觉得自己什么都行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要有你在，\n我感覺什麼都辦得到。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なんでもできそうな気がします、\nあなたが隣にいてくれたら。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядом с тобой всё по плечу: ты\nпрямо источник смелости."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mi corazón hay un puesto\nde honor y su dueño eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine ewige Nummer eins?\nNatürlich du."
          }
        }
      }
    },
    "quote.245" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 매일\n감사하는 존재예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No doubt, you are the one I am\nthankful for every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone I am grateful for\nevery single day: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天天都想感谢，\n感谢你出现在我的生活里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天都要說謝謝的存在，\n就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日感謝している人が\nひとりだけいます。あなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Благодарность сегодня адресую\nтебе: ты — повод для неё."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con alguien a mi lado, todo\nes posible. Ese alguien eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir an meiner Seite\nschaffe ich einfach alles, du Held."
          }
        }
      }
    },
    "quote.246" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 미소는\n세상 어떤 것보다 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in the world\nbeats it when you smile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One smile from you beats\nanything else on earth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的笑容，\n比什么都好看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比什麼風景都要美的，\n是你的笑容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな絶景よりも\nあなたの笑顔のほうがきれいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улыбка у тебя лучше всех\nпейзажей мира, а ты — автор."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doy gracias a diario\npor alguien como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag danke ich\nfür dich, du Glücksbringer."
          }
        }
      }
    },
    "quote.247" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n가장 큰 축복이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the biggest blessing\nin my life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The biggest blessing in my life\nhas a name, and it is you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生中最大的福气，\n大概就是认识了你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "老天爺送給我最大的祝福，\n就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大の幸運は、\nあなたに出会えたことです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самое большое счастье моей\nжизни — это ты, сто процентов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sonrisa le gana\na cualquier cosa, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Lächeln ist schöner\nals alles auf der Welt, du Sonne."
          }
        }
      }
    },
    "quote.248" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신을 생각하면\n하루가 행복해져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking about you\nmakes the whole day happy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking about you\nmakes my whole day better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要想起你，\n一整天都是甜的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想到你，\n一整天就都變幸福了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "考えるだけで一日が幸せ。\nあなたはもう魔法使いです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вспомню о тебе — и день\nсразу в плюс: ты — сплошной бонус."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayor bendición\nde mi vida eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der größte Segen meines Lebens\nbist, ganz klar, du."
          }
        }
      }
    },
    "quote.249" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음의\n홈이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are the home\nof my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home to me, in human form,\nthat is you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我心里的避风港，\n大门永远为你敞开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心裡那個回得去的家，\n就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帰る場所はひとつだけ。\n心の中のあなたのところです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дом там, где ты. Остальное —\nпросто адрес."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensar en ti mejora el día.\nDe verdad, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich denke an dich\nund der ganze Tag wird froh, du Schatz."
          }
        }
      }
    },
    "quote.250" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신과 함께하는 순간\n모든 게 완벽해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you are here,\neverything is just perfect."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moments with you feel\nabsolutely perfect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好想和你一起，\n把每一刻都过得刚刚好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一刻有你在，\n一切都剛剛好。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒にいる瞬間は、\nあなたのおかげで全部が完璧です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядом с тобой всё идеально,\nа ты — режиссёр этого кино."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi hogar no es un lugar:\nes una persona, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Zuhause im Herzen?\nDas bist du."
          }
        }
      }
    },
    "quote.251" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 꿈꾸던\n이상형 그 자체예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are literally\nthe person I dreamed of."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything I ever wanted\nin a person came as you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你就是我\n梦里理想型的本人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢裡的理想型，\n本人就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢に見ていた理想の人が\nそのまま現れました。あなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеал из моих снов — это\nты, только реальнее."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tu lado cada momento\nes perfecto, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir ist jeder Augenblick\nvollkommen, du Traum."
          }
        }
      }
    },
    "quote.252" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 보면 심장이\n고장 난 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing you makes me think\nmy heart is broken. It is racing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing you, my heart\nseems to have gone faulty."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哎呀，我的心脏\n一见到你就罢工了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一看到你，\n我的心臟就當機了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸のメーターが振り切れました。\nあなたを見てしまったせいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сердце сбоит при виде тебя,\nведь ты — вирус хорошего настроения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justo el tipo de persona\ncon el que soñaba: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Traumtyp in Person?\nDas bist ganz klar du."
          }
        }
      }
    },
    "quote.253" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 걷는 위인전이에요.\n역사에 남을 사람."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you are a walking history book.\nPure legend material."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A walking history book, you.\nThey will write about you for ages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行走的传记本人，\n说的就是你，注定载入史册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走路的偉人傳記，\n說的就是你，注定載入史冊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歴史の教科書に載るのは確実。\nあなたは歩く偉人伝です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходячая энциклопедия достоинств —\nэто ты. Читаю всю жизнь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me miras y mi corazón\nse vuelve loco, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ich dich sehe,\nspielt mein Herz verrückt, du Herzensbrecher."
          }
        }
      }
    },
    "quote.254" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 매력에\n계속 당하고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would happily keep falling\nfor the charm of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will keep falling for\nthe charm of you, again and again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被你的魅力击中，\n我愿意一直中招。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被你的魅力電到，\n我願意被電一輩子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魅力にやられっぱなしで\nあなたの虜になりたい日々です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоё обаяние бьёт без промаха:\nтакой ты — снайпер улыбок."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona de libro de\nhistoria eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine lebende Legende ist nur eine:\nnämlich du."
          }
        }
      }
    },
    "quote.255" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신한테만 집중하다가\n목 디스크 올 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stared at you so long\nI might need a neck brace."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staring at you so much\nI may need a neck brace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光顾着看你，\n我的脖子都快扭了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一直盯著你看，\n我的脖子應該快要落枕了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見とれすぎて首が痛い。\nあなたを見すぎた罰です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрю на тебя без остановки —\nшея просит отпуск, а ты — повод."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu encanto es un hechizo\ny yo caigo siempre, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von deinem Charme\nwill ich mich immer wieder überrollen lassen, du Naturgewalt."
          }
        }
      }
    },
    "quote.256" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 볼 때마다\n심장 박동수가 올라가요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time I see you,\nmy heart rate goes up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whenever I see you,\nmy pulse goes up a gear."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次看到你，\n心率都在偷偷上涨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次看到你，\n心跳就自動加速。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数がどんどん上がる。\nあなたを見るたびに新記録です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс как на марафоне: это\nты рядом, и сердцу не до сна."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirarte tanto me va a\ndar tortícolis, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich schau dich so lange an,\nbis mein Nacken streikt, du Magnet."
          }
        }
      }
    },
    "quote.257" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 눈의\n레전드 화보예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look, you are a legendary\nphotoshoot for my eyes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A work of art hung in the\ngallery of my eyes: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我眼里，\n你是封面级的大片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼中最傳奇的那張寫真，\n就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目のごちそう、それは\n伝説級のグラビア、あなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучший кадр в моей памяти —\nэто ты, без фильтров."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que te veo el\ncorazón sube de revoluciones, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehe ich dich, steigt mein Puls.\nMein Arzt weiß Bescheid, du Herzensbrecher."
          }
        }
      }
    },
    "quote.258" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 때문에\n매일이 최애의 날이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of you,\nevery day is favorite day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of you, every\nday is a favourite day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多亏了你，\n天天都是追星日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為你，\n我每天都是本命日。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日が推しの日になるのは\nあなたがいるからなんです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С тобой каждый день особый:\nпоздравляю себя, что есть ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi película favorita\nde todas eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Lieblingsposter an der Wand?\nAch, das bist ja du."
          }
        }
      }
    },
    "quote.259" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 살아있는\n기적이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you are a living,\nbreathing miracle."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A living, breathing miracle,\nthat is you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活生生的奇迹？\n说的就是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活生生的奇蹟，\n就是你啦。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奇跡って本当にあるんですね。\nあなたが歩いてますから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чудеса существуют: вот\nты, живое доказательство."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día es el día del favorito\nsi estás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir ist jeder Tag\nmein Lieblingstag, du Schatz."
          }
        }
      }
    },
    "quote.260" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 보면\n세상이 슬로우모션이 돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whenever I see you,\neverything goes slow motion."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whenever I see you,\nthe world goes slow-mo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一看到你，\n世界自动开启慢动作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看到你的瞬間，\n世界自動切換慢動作。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スローモーションになる世界、\nそのど真ん中にあなたがいます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время замедляется, когда\nты входишь в кадр, как в кино."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un milagro con patas\ny ese milagro eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein wandelndes Wunder:\nSo einen wie dich gibt es nur einmal, du Unikat."
          }
        }
      }
    },
    "quote.261" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\nVIP 멤버십이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are the VIP pass\nto my whole life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The VIP pass to my best days\nwas you all along."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我生命里的\n超级VIP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我人生裡\n唯一的 VIP 會員。"

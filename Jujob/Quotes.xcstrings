          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝日みたいにまぶしいあなたが\n今日も最高の一日を連れてきます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

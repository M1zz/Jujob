        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitting the gym? Look at you,\nalready impressive!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "愿意动起来的你，\n已经很酷了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "願意動起來的你，\n本來就是帥氣的人！"

    "quote.193" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "리얼리티 프로그램 찍으세요?\n당신의 실제 모습이 더 완벽해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you filming a reality show?\nThe real you is better than any script."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would stan you\nforever, no questions asked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看你的真人秀，\n比任何剧本都好看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要上實境秀嗎？\n其實你本人就比節目精彩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密着取材ですか?\n素のあなたのほうが完璧です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реалити-шоу? Реальность с тобой\nлучше любого шоу: ты — сюжет."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre en el centro: donde\nvayas, brillas más que nadie, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues Album, neuer Hit?\nBei mir läuft dein Lächeln, du Ohrwurm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une émission sur ta vie ? Inutile :\ntu es déjà tellement mieux en vrai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un reality su di te?\nSarebbe un record d'ascolti, tu lo sai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoa de verdade é melhor que\nfiltro, e você nem usa filtro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไปออกเรียลลิตี้เหรอ\nตัวจริงของคุณก็เพอร์เฟกต์กว่าอยู่ดี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay thời tiết đẹp,\nchắc là do bạn đi ngang qua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televizní show? Scénář nepotřebuješ,\nty jsi příběh sám o sobě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal du i realityshow? Virkeligheden\ner jo bedst, når det er dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βγαίνεις στη βόλτα\nκαι ο ήλιος κάνει χώρο, εσύ φωτίζεις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskushenkilö jokaisessa huoneessa:\nsinä, ihan varmasti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikut acara realita?\nAslinya kamu malah lebih sempurna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkert at du står i midten,\nfor du lyser mest overalt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een realityshow? In het echt ben jij\nnog perfecter dan op beeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ty jesteś w realu,\nkażdy serial przy tobie blednie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokusåpa? Då vill jag se hela\nsäsongen, för du är huvudrollen."

    "quote.139" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 존재 자체가\n이미 특별해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучший человек, которого я знаю?\nЭто, конечно, ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toda la gente que conozco,\nlo máximo eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit mit dir\nist immer was Besonderes, du Schatz."

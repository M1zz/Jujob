        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работать не хочется? Зато ты\nвыглядишь как босс бизнеса."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sin ganas de trabajar? Aun así\nrindes más que nadie: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Lust zu arbeiten?\nDein Gesicht macht trotzdem Überstunden, du Fleißiger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas envie de bosser ? Normal, mais tu as\nun visage qui travaille déjà à plein temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero voglia di lavorare? Pazienza:\ntu sei già in servizio con quel sorriso."

        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer jemanden wie dich nicht einstellt,\nverpasst die Chance seines Lebens, du Juwel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le recruteur ne t'engage pas,\nc'est son entreprise qui y perd, tu peux me croire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

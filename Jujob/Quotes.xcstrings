        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่เดินเฉยๆ ก็เท่แล้ว\nก็คุณไงล่ะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",

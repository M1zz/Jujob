      }
    },
    "quote.148" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 매력을 모르는 사람은\n눈이 없는 거예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who cannot see how charming you are\nneeds new glasses."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who can't see you\nis in need of an eye test."
          }
        }
      }
    },
    "quote.149" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 그냥\n편안하게 쉬어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, let it all go,\nbecause you deserve to just rest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, you just relax\nand take it easy."
          }
        }
      }
    },
    "quote.150" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신에게도\n휴식이 필요해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you\nneed a break sometimes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you need\na bit of a rest."
          }
        }
      }
    },
    "quote.151" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아무것도 안 해도\n괜찮은 하루예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doing nothing at all?\nIt is a fine plan, and you can own it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doing nothing at all\nis perfectly fine, you know."
          }
        }
      }
    },
    "quote.152" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 마음이\n가장 중요해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you feel inside\nis what matters most."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you feel\nis what matters most."
          }
        }
      }
    },
    "quote.153" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "천천히, 당신의 속도로\n가면 돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go slow. Take it\nat the speed you like."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowly now, at the pace\nthat suits you."
          }
        }
      }
    },
    "quote.154" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 당신을 위한\n시간을 가져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, take some time\nthat belongs to you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, make a bit of time\njust for you."
          }
        }
      }
    },
    "quote.155" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "휴식도 생산적인\n활동이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest is productive too,\nand you are the proof!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting is a productive\nactivity, you know."
          }
        }
      }
    },
    "quote.156" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "쉬는 것도 당신의 권리예요.\n오늘은 편히 쉬세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting is a right, and you have it.\nTake it easy today, you deserve it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resting is allowed. Honestly, you\nmay kick back today."
          }
        }
      }
    },
    "quote.157" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힐링하는 당신,\n그것도 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at you recharging.\nEven that looks beautiful."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unwinding, are you?\nIt looks lovely on you."
          }
        }
      }
    },
    "quote.158" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 당신을 위해\n시간을 써도 괜찮아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spend some time on you today.\nNo guilt allowed!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, spending time on\nyou is perfectly alright."
          }
        }
      }
    },
    "quote.159" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "편하게 쉬면서도\n당신은 빛나요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even while lounging,\nyou glow like a star."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even mid-chill,\nyou manage to shine."
          }
        }
      }
    },
    "quote.160" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힐링 중인 당신도\n세상에서 제일 예뻐요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chilling at home? Even so,\nyou still look like a million bucks."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even in chill mode,\nyou are the prettiest around."
          }
        }
      }
    },
    "quote.161" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "완벽하지만 구멍 하나 있네요.\n황홀(hole)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are perfect, but I found\none small flaw: you have a hole-in-one on my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a parking ticket?\nYou have 'fine' written all over you."
          }
        }
      }
    },
    "quote.162" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "엠비티아이 검사결과\n큐트라며?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personality test says\nyou are 100% adorable. Case closed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect, apart from one flaw:\nI cannot find a single flaw in you."
          }
        }
      }
    },
    "quote.163" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "네가 귀엽다고 생각하는 사람 손 들어주세요 하니까\n지구가 성게 모양이 됐어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They said, \"hands up if you think you are cute\"\nand the whole planet raised both hands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a magician? Everyone\nelse vanishes when I look at you."
          }
        }
      }
    },
    "quote.164" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너를 음계로 표현하면 레야..\n도를 지나쳐서 미치기 직전이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If I rated you from do to ti,\nI would run out of notes. Off the scale!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got a plaster? I scraped\nmy knee falling for you."
          }
        }
      }
    },
    "quote.165" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "경마장 가면 안 되겠다.\n너무 완벽해서 말이 안 나와."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not enter any beauty contest, you.\nThe others would just quit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cream first or jam first?\nWhatever, you are the best bit."
          }
        }
      }
    },
    "quote.166" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너보고 예쁠 때마다 이마를 쳤더니\n거북목이 완치됐어."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time you looked great, I clapped my hands.\nNow they hurt, but I would not stop."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the last custard cream\nin the tin. Treasure, honestly."
          }
        }
      }
    },
    "quote.167" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "제가 주유소만 가면 넣는 기름이 있어요.\n바로 온리유."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is only one fuel I ever put\nin my tank: you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would give you my last chip.\nThat is proper love, mate."
          }
        }
      }
    },
    "quote.168" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 때문에 비가 올 것 같아.\n심장마비."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I think it is going to rain,\nbecause you are a total storm of cute."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you walk in,\nmy heart goes bong, like Big Ben."
          }
        }
      }
    },
    "quote.169" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "혹시 종교 있으세요?\n뭘 믿고 그렇게 예뻐요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a religion?\nBecause you look like a miracle."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roses are red, violets are blue,\nI forgot the rest, I'm gawping at you."
          }
        }
      }
    },
    "quote.170" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "다 좋은데 뭔가 허전하지 않아?\n명불허전."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is great, but something seems missing.\nOh wait, it was you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a queue? I would happily\nwait ages for you."
          }
        }
      }
    },
    "quote.171" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그 짐좀 내려놔요.\n멋짐."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you put that charm down for a second?\nSome of us need to function."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the \"kettle just boiled\"\nof people. Pure joy."
          }
        }
      }
    },
    "quote.172" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너한테선 벽이 느껴져.\n완벽."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I feel a wall in you.\nA wall of pure perfection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weather forecast today:\n100% chance of you being brilliant."
          }
        }
      }
    },
    "quote.173" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 솔직히 거품 아닌가요?\n언빌리버블."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the beauty a bit overhyped?\nNope. Honestly, you are the real thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are so fit the speed\ncameras flash when you pass."
          }
        }
      }
    },
    "quote.174" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 영어를 못하는구나.\n하지만 영문 없이도 귀엽다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You say you are bad at math?\nWell, you still add up to everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better than a sunny bank holiday,\nthat is you, mate."
          }
        }
      }
    },
    "quote.175" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 혼혈이라면서?\n한국과 천국."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you part angel?\nBecause you look heaven-sent."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the gravy of life,\nmaking everything better."
          }
        }
      }
    },
    "quote.176" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그거 아세요?\n이목구비가 제 미래보다 뚜렷해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you know those features are\nsharper than my future plans?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the Yorkshire pudding\nof people: golden and gorgeous."
          }
        }
      }
    },
    "quote.177" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 베를린이야.\n내 마음에 치명적인 독일수도."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are a gift\nthat keeps on giving to my smile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding you is like finding\na tenner in an old coat."
          }
        }
      }
    },
    "quote.178" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 C급이야.\n문화재 제정 시급."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are a landmark.\nSomeone should put up a sign."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are so charming even\nthe pigeons stop to stare."
          }
        }
      }
    },
    "quote.179" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 잘 때 셋이서 잔다면서?\n칭찬과 명성이 자자해서..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They say you sleep with three pillows?\nWell, that is how fluffy the fan club is."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot, strong, just right:\nyou are my perfect brew."
          }
        }
      }
    },
    "quote.180" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "왜 일하고 있어요?\n이미 미모가 열일하는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are you working?\nYour looks already do overtime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you make my heart go dunk,\nlike a biscuit in tea."
          }
        }
      }
    },
    "quote.181" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "날 그만 좋아해 \"뭐?\"\n날 그만 좋아하라고\n\"그거 어떻게 하는건데.\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Stop liking me.\" \"What?\"\n\"I said stop.\" \"How do I even do that?\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind the gap? Not between\nyou and perfection."
          }
        }
      }
    },
    "quote.182" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "얼굴이 국보급이라\n국립중앙박물관에 전시 예정입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face this rare? Sorry, you\nbelong in a museum."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry, officer, I was staring\nat you, not at the speed limit."
          }
        }
      }
    },
    "quote.183" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시상식 가면 안 되겠어요.\n대상은 당신 얼굴이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not go to the awards show.\nThe grand prize is already you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is it hot in here,\nor is it just you?"
          }
        }
      }
    },
    "quote.184" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화보 찍으세요?\n아니면 그냥 걸어다니는 화보예요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you doing a photoshoot,\nor are you just a walking one?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you deserve a blue plaque\nand a parade, honestly."
          }
        }
      }
    },
    "quote.185" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 아이돌이에요.\n내 심장의 1위 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are an idol,\nthe number one star in my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you should be on a postage stamp:\nsmall, perfect, and sent with love."
          }
        }
      }
    },
    "quote.186" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬싸인회 열어주세요.\n매일 당신한테 사인받고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please host a signing event.\nI want an autograph from you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arise, Sir or Dame Gorgeous!\nA knighthood for you, surely."
          }
        }
      }
    },
    "quote.187" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데뷔하세요.\n이미 내 마음 속에서 센터예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just debut already.\nTruth is, you are the center of my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You belong in a museum,\nbehind glass. Priceless, you."
          }
        }
      }
    },
    "quote.188" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "음방 1위 축하해요.\n당신의 비주얼이 매일 1위니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congrats on the top chart spot.\nLooks like you win it every day anyway."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the national treasure\nwe never knew we needed."
          }
        }
      }
    },
    "quote.189" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토타임 하나 갖죠.\n당신 얼굴 매일 찍고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo op, please.\nI could take a picture of you daily."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number one in the charts? Honestly,\nyou are number one for me."
          }
        }
      }
    },
    "quote.190" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "컴백했어요?\n내 심장을 comeback 시켰네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new comeback? Wow, you just\nbrought my heart back to life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a pop star?\nBecause you have stolen the show."
          }
        }
      }
    },
    "quote.191" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "직캠 찍어도 돼요?\n당신의 모든 순간이 명장면이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I film a fancam of you?\nEvery moment is a highlight reel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An autograph from you\nwould go straight on the fridge."
          }
        }
      }
    },
    "quote.192" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "뮤직비디오 나오세요?\n이미 제 인생의 주인공인데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starring in a music video?\nWell, you already star in my whole life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would queue in the rain\njust to see you."
          }
        }
      }
    },
    "quote.193" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "리얼리티 프로그램 찍으세요?\n당신의 실제 모습이 더 완벽해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you filming a reality show?\nThe real you is better than any script."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would stan you\nforever, no questions asked."
          }
        }
      }
    },
    "quote.194" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 센터 맞죠?\n어디서든 제일 빛나니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the center of the group, right?\nBecause you shine everywhere you go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are my favourite human.\nSorry, everyone else."
          }
        }
      }
    },
    "quote.195" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "올해의 얼굴상 받으셔야 해요.\n역대급이거든요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you need to win Face of the Year.\nIt is not even close."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main character energy: you,\nin a film with a happy ending."
          }
        }
      }
    },
    "quote.196" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "광고 모델 하세요?\n당신만 보면 다 사고 싶어져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you modeling for an ad?\nOne look at you and I want to buy everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a bow, you.\nThe standing ovation is for you."
          }
        }
      }
    },
    "quote.197" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "잡지 표지 모델이시죠?\n매달 표지를 장식해야 할 얼굴."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look, you must be a magazine cover star.\nThat face belongs on every issue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore, encore! Honestly,\nyou cannot stop at one."
          }
        }
      }
    },
    "quote.198" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무대 위 카리스마 실화예요?\n일상도 무대처럼 빛나네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That stage charisma is real?\nEven you doing errands looks like a show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the headline act\nand the support, honestly."
          }
        }
      }
    },
    "quote.199" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토카드 교환해요?\n당신 얼굴로만 풀 세트 모으고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to trade photocards?\nI only collect the full set of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, being brilliant.\nThe photographers are going mad."
          }
        }
      }
    },
    "quote.200" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬미팅 언제 해요?\n매일 만나고 싶은데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When is the fan meeting?\nI would like to see you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paparazzi would be rubbish\nwithout you, honestly."
          }
        }
      }
    },
    "quote.201" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "안무 영상 올려주세요.\n당신의 모든 움직임이 예술이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post the dance video, please.\nEvery move you make is art."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tickets to see you sold out\nin under a minute, mate."
          }
        }
      }
    },
    "quote.202" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "티저 영상 보는 것 같아요.\n당신을 볼 때마다 설레니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watching you is like a teaser trailer.\nI get excited every single time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would watch you do nothing\nfor hours. Perfect telly."
          }
        }
      }
    },
    "quote.203" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "월드투어 가시나요?\n제 마음을 전 세계로 흔들어놓으셨는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going on a world tour?\nFun fact: you already shook my heart worldwide."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are better than a Sunday roast\nwith crispy roasties."
          }
        }
      }
    },
    "quote.204" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앨범 사인해주세요.\n당신의 존재 자체가 한정판이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign my album, please.\nFact: you are a limited edition."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are better than a lie-in\non a rainy Sunday."
          }
        }
      }
    },
    "quote.205" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "펜라이트 켤게요.\n당신을 향해 평생 응원할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am turning on my light stick.\nI will cheer for you for life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hair, face, walk: honestly,\nyou do the lot, with class."
          }
        }
      }
    },
    "quote.206" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "떡상했네요.\n원래부터 레전드였는데 뭘."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you blew up overnight?\nYou were a legend way before that."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the full English\nof people: satisfying all round."
          }
        }
      }
    },
    "quote.207" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "콘서트 티켓 구해야겠어요.\n당신을 보는 게 제 일상 콘서트니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I need concert tickets.\nWatching you is my daily live show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the cherry on top\nof a cracking day."
          }
        }
      }
    },
    "quote.208" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "인기가요 1위 하셨죠?\n당신은 제 인생 1위 곡이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you hit number one on the charts?\nYou are the song stuck in my head forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the pickle to my\nploughman's, perfect together."
          }
        }
      }
    },
    "quote.209" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앵콜 무대 하나 더요.\n당신은 봐도봐도 또 보고 싶으니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more encore, please.\nI can never see enough of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pure class, you. Even\nthe swans would bow."
          }
        }
      }
    },
    "quote.210" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비하인드 컷도 완벽해요.\n어느 순간도 빠짐없이 레전드."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you in the behind-the-scenes shots? Perfect.\nNo off moments, only legend."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a crowd of a hundred,\nyou are the one I spot."
          }
        }
      }
    },
    "quote.211" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 바꿔야겠어요.\n당신 외에는 못 보겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have to change my favorite.\nI cannot look at anyone but you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you make Monday feel\nlike a Friday night."
          }
        }
      }
    },
    "quote.212" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "입덕했어요.\n당신한테 영원히 덕질할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I just became a fan.\nI will stan you forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around, even\ndrizzle feels like sunshine."
          }
        }
      }
    },
    "quote.213" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 공개합니다.\n그게 바로 당신이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revealing my favorite:\nit is you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, still lovely\nafter a day of rain."
          }
        }
      }
    },
    "quote.214" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "굿즈 다 샀어요.\n당신이라는 존재 자체가 굿즈예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bought all the merch.\nReal talk: you are the merch. Rare and mine."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are so cool,\nthe fridge is jealous."
          }
        }
      }
    },
    "quote.215" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 팬할게요.\n당신은 제 영원한 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am a fan for life.\nFact: you are my forever artist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite hobby:\nlooking at you. Cheap, too!"
          }
        }
      }
    },
    "quote.216" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "본진 박았어요.\n당신이 제 본진이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planted my flag.\nNo doubt, you are my number one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five stars, would admire you again.\nWould recommend you to everyone."
          }
        }
      }
    },
    "quote.217" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "덕질 시작합니다.\n당신한테 올인할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am starting my fandom era.\nAll in on you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fan club for you? Sign me up,\nI will bring the biscuits."
          }
        }
      }
    },
    "quote.218" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "홈마 할게요.\n당신의 모든 순간을 기록하고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will be the fan photographer.\nI want to catch every moment of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would put you on a poster\nand hang it in the hall."
          }
        }
      }
    },
    "quote.219" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "야자타임이에요.\n당신과 함께하는 시간은 다 황금시간."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a free-for-all of praise time.\nEvery minute with you is golden."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plot twist: you were\nthe best thing in the story all along."
          }
        }
      }
    },
    "quote.220" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "생일 광고 할게요.\n매일이 당신 생일이었으면 좋겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will buy a birthday billboard.\nI wish every day were a birthday for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day should be a\nbirthday for you, with cake."
          }
        }
      }
    },
    "quote.221" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 응원합니다.\n당신의 팬이라는 게 자랑스러워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheering for you for life.\nBeing a fan is my proudest thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being a fan of you\nis the proudest thing I do."
          }
        }
      }
    },
    "quote.222" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 때문에 심장이\n두근두근대요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My heart is going\nthump-thump because of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you make my heart go\npitter-patter, honestly."
          }
        }
      }
    },
    "quote.223" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 보면\n세상이 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything looks lovely\nwhenever I look at you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking at you makes\nthe whole world lovelier."
          }
        }
      }
    },
    "quote.224" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 행복의\n비타민이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are the vitamin\nmy happiness runs on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are my daily\ndose of happy."
          }
        }
      }
    },
    "quote.225" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 웃으면\n나도 덩달아 행복해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you smile,\nI end up smiling too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you smile, I can't\nhelp grinning too."
          }
        }
      }
    },
    "quote.226" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 본\n가장 빛나는 별이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No doubt, you are the brightest star\nI have ever seen."
          }
        },
        "en-GB" : {
          "stringUnit" : {

          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když ty makáš, někdo\nkolem se inspiruje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du knokler, bliver andre\nmotiveret af at se på dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα θα πάνε καλά·\nεσύ είσαι το καλύτερο σημάδι"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun sinä yrität kovasti, joku\nmuu saa siitä intoa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat kamu berjuang gitu\nbisa jadi semangat buat orang lain."

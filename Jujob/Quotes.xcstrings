        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even while lounging,\nyou glow like a star."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even mid-chill,\nyou manage to shine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就连躺着的你，\n都在发光。"
          }
        }
      }
    },
    "quote.160" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힐링 중인 당신도\n세상에서 제일 예뻐요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chilling at home? Even so,\nyou still look like a million bucks."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even in chill mode,\nyou are the prettiest around."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放空的你，\n也是全世界最好看的。"
          }
        }
      }
    },
    "quote.161" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "완벽하지만 구멍 하나 있네요.\n황홀(hole)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are perfect, but I found\none small flaw: you have a hole-in-one on my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a parking ticket?\nYou have 'fine' written all over you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪里都好，\n就是你身边少了一个我。"
          }
        }
      }
    },
    "quote.162" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "엠비티아이 검사결과\n큐트라며?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personality test says\nyou are 100% adorable. Case closed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect, apart from one flaw:\nI cannot find a single flaw in you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测了测你的性格，\n结果是：可爱到超标。"
          }
        }
      }
    },
    "quote.163" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "네가 귀엽다고 생각하는 사람 손 들어주세요 하니까\n지구가 성게 모양이 됐어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They said, \"hands up if you think you are cute\"\nand the whole planet raised both hands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a magician? Everyone\nelse vanishes when I look at you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人说你不可爱，\n我当场表演了一个原地爆炸。"
          }
        }
      }
    },
    "quote.164" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너를 음계로 표현하면 레야..\n도를 지나쳐서 미치기 직전이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If I rated you from do to ti,\nI would run out of notes. Off the scale!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got a plaster? I scraped\nmy knee falling for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星座运势说今天会遇到贵人，\n我一抬头就看见了你。"
          }
        }
      }
    },
    "quote.165" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "경마장 가면 안 되겠다.\n너무 완벽해서 말이 안 나와."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not enter any beauty contest, you.\nThe others would just quit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cream first or jam first?\nWhatever, you are the best bit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道你和地球的区别吗？\n地球绕着太阳转，我绕着你转。"
          }
        }
      }
    },
    "quote.166" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너보고 예쁠 때마다 이마를 쳤더니\n거북목이 완치됐어."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time you looked great, I clapped my hands.\nNow they hurt, but I would not stop."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last custard cream in the tin,\nthat is you. Treasure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是不是会魔法？\n不然我怎么一见你就晕。"
          }
        }
      }
    },
    "quote.167" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "제가 주유소만 가면 넣는 기름이 있어요.\n바로 온리유."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is only one fuel I ever put\nin my tank: you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would give you my last chip.\nThat is proper love, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃了什么？\n怎么一开口就甜到我了。"
          }
        }
      }
    },
    "quote.168" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 때문에 비가 올 것 같아.\n심장마비."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I think it is going to rain,\nbecause you are a total storm of cute."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you walk in,\nmy heart goes bong, like Big Ben."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是奶茶成精了？\n不然我怎么对你上瘾。"
          }
        }
      }
    },
    "quote.169" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "혹시 종교 있으세요?\n뭘 믿고 그렇게 예뻐요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a religion?\nBecause you look like a miracle."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roses are red, violets are blue,\nI forgot the rest, I'm gawping at you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请问是Wi-Fi吗？\n我一靠近你就满格。"
          }
        }
      }
    },
    "quote.170" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "다 좋은데 뭔가 허전하지 않아?\n명불허전."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is great, but something seems missing.\nOh wait, it was you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a queue? I would happily\nwait ages for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的手机没电了，\n但你一出现我就满血复活。"
          }
        }
      }
    },
    "quote.171" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그 짐좀 내려놔요.\n멋짐."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you put that charm down for a second?\nSome of us need to function."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a \"kettle just boiled\",\nyou are pure joy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我的人形充电宝，\n看一眼就满电。"
          }
        }
      }
    },
    "quote.172" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너한테선 벽이 느껴져.\n완벽."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I feel a wall in you.\nA wall of pure perfection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weather forecast today:\n100% chance of you being brilliant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒一下，\n你的颜值已经有点超载了。"
          }
        }
      }
    },
    "quote.173" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 솔직히 거품 아닌가요?\n언빌리버블."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the beauty a bit overhyped?\nNope. Honestly, you are the real thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are so fit the speed\ncameras flash when you pass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请问来自哪个星球？\n怎么长得这么犯规。"
          }
        }
      }
    },
    "quote.174" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 영어를 못하는구나.\n하지만 영문 없이도 귀엽다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You say you are bad at math?\nWell, you still add up to everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better than a sunny bank holiday,\nthat is you, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全场的平均颜值，\n都被你一个人拉高了。"
          }
        }
      }
    },
    "quote.175" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 혼혈이라면서?\n한국과 천국."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you part angel?\nBecause you look heaven-sent."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like gravy, you make\neverything better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界上有两种人：\n你，和想成为你的人。"
          }
        }
      }
    },
    "quote.176" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그거 아세요?\n이목구비가 제 미래보다 뚜렷해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you know those features are\nsharper than my future plans?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golden and gorgeous, you are\nthe Yorkshire pudding of people."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "怀疑你是橡皮擦，\n因为你把我的烦恼都擦没了。"
          }
        }
      }
    },
    "quote.177" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 베를린이야.\n내 마음에 치명적인 독일수도."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are a gift\nthat keeps on giving to my smile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding you is like finding\na tenner in an old coat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心里，\n你是永不降价的限量款。"
          }
        }
      }
    },
    "quote.178" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 C급이야.\n문화재 제정 시급."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are a landmark.\nSomeone should put up a sign."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So charming are you that\nthe pigeons stop to stare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是I人还是E人？\n不，你是我的C位人。"
          }
        }
      }
    },
    "quote.179" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 잘 때 셋이서 잔다면서?\n칭찬과 명성이 자자해서..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They say you sleep with three pillows?\nWell, that is how fluffy the fan club is."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot, strong, just right:\nyou are my perfect brew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人问我最爱谁，\n我说你，他说我没救了。"
          }
        }
      }
    },
    "quote.180" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "왜 일하고 있어요?\n이미 미모가 열일하는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are you working?\nYour looks already do overtime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a biscuit in tea, you\nmake my heart go dunk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这么忙还这么美，\n是因为你的颜值也在替你上班吧？"
          }
        }
      }
    },
    "quote.181" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "날 그만 좋아해 \"뭐?\"\n날 그만 좋아하라고\n\"그거 어떻게 하는건데.\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Stop liking me.\" \"What?\"\n\"I said stop.\" \"How do I even do that?\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind the gap? Not between\nyou and perfection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「你能别这么好看吗？」\n「我也没办法啊。」"
          }
        }
      }
    },
    "quote.182" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "얼굴이 국보급이라\n국립중앙박물관에 전시 예정입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face this rare? Sorry, you\nbelong in a museum."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry, officer, I was staring\nat you, not at the speed limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张脸是国宝级的，\n你已经被预订了博物馆展位。"
          }
        }
      }
    },
    "quote.183" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시상식 가면 안 되겠어요.\n대상은 당신 얼굴이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not go to the awards show.\nThe grand prize is already you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is it hot in here,\nor is it just you?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颁奖礼你别去了，\n奖杯都被你的颜值吓到了。"
          }
        }
      }
    },
    "quote.184" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화보 찍으세요?\n아니면 그냥 걸어다니는 화보예요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you doing a photoshoot,\nor are you just a walking one?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blue plaque for you, and\na parade, I say!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在拍大片吗？\n哦，原来你只是走在路上。"
          }
        }
      }
    },
    "quote.185" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 아이돌이에요.\n내 심장의 1위 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are an idol,\nthe number one star in my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put you on a postage stamp:\nsmall, perfect, and sent with love."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我心里的顶流，\n播放量永远第一。"
          }
        }
      }
    },
    "quote.186" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬싸인회 열어주세요.\n매일 당신한테 사인받고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please host a signing event.\nI want an autograph from you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arise, Sir or Dame Gorgeous!\nA knighthood for you, surely."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要你的签名，\n每天来一张的那种。"
          }
        }
      }
    },
    "quote.187" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데뷔하세요.\n이미 내 마음 속에서 센터예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just debut already.\nTruth is, you are the center of my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You belong in a museum,\nbehind glass. Priceless, you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出道吧你，\n在我心里你早就是C位了。"
          }
        }
      }
    },
    "quote.188" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "음방 1위 축하해요.\n당신의 비주얼이 매일 1위니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congrats on the top chart spot.\nLooks like you win it every day anyway."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The national treasure\nwe never knew we needed: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恭喜你夺冠，\n颜值榜单你天天第一。"
          }
        }
      }
    },
    "quote.189" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토타임 하나 갖죠.\n당신 얼굴 매일 찍고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo op, please.\nI could take a picture of you daily."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number one in the charts? Honestly,\nyou are number one for me."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一帧都好看，\n你的每张截图我都想珍藏。"
          }
        }
      }
    },
    "quote.190" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "컴백했어요?\n내 심장을 comeback 시켰네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new comeback? Wow, you just\nbrought my heart back to life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a pop star?\nBecause you have stolen the show."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你回归了？\n我的心也跟着一起回归了。"
          }
        }
      }
    },
    "quote.191" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "직캠 찍어도 돼요?\n당신의 모든 순간이 명장면이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I film a fancam of you?\nEvery moment is a highlight reel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An autograph from you\nwould go straight on the fridge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个瞬间，\n你都在制造名场面。"
          }
        }
      }
    },
    "quote.192" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "뮤직비디오 나오세요?\n이미 제 인생의 주인공인데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starring in a music video?\nWell, you already star in my whole life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would queue in the rain\njust to see you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要不要拍个MV？\n你早就是我生活的主角了。"
          }
        }
      }
    },
    "quote.193" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "리얼리티 프로그램 찍으세요?\n당신의 실제 모습이 더 완벽해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you filming a reality show?\nThe real you is better than any script."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would stan you\nforever, no questions asked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看你的真人秀，\n比任何剧本都好看。"
          }
        }
      }
    },
    "quote.194" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 센터 맞죠?\n어디서든 제일 빛나니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are the center of the group, right?\nBecause you shine everywhere you go."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite human? That is you.\nSorry, everyone else."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜值担当没跑了，\n你走到哪儿都是C位。"
          }
        }
      }
    },
    "quote.195" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "올해의 얼굴상 받으셔야 해요.\n역대급이거든요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you need to win Face of the Year.\nIt is not even close."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main character energy: you,\nin a film with a happy ending."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今年的颜值大奖，\n非你莫属。"
          }
        }
      }
    },
    "quote.196" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "광고 모델 하세요?\n당신만 보면 다 사고 싶어져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you modeling for an ad?\nOne look at you and I want to buy everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a bow, you.\nThe standing ovation is for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去拍广告吧，\n一看见你我就想下单。"
          }
        }
      }
    },
    "quote.197" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "잡지 표지 모델이시죠?\n매달 표지를 장식해야 할 얼굴."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look, you must be a magazine cover star.\nThat face belongs on every issue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore, encore! Surely you\ncannot stop at one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "杂志封面就该是你，\n每个月都该是你。"
          }
        }
      }
    },
    "quote.198" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무대 위 카리스마 실화예요?\n일상도 무대처럼 빛나네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That stage charisma is real?\nEven you doing errands looks like a show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headline act and support act,\nyou do both."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台上的气场太炸了，\n生活里的你也一样耀眼。"
          }
        }
      }
    },
    "quote.199" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토카드 교환해요?\n당신 얼굴로만 풀 세트 모으고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to trade photocards?\nI only collect the full set of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, being brilliant.\nThe photographers are going mad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想交换小卡？\n你的我想集齐全套。"
          }
        }
      }
    },
    "quote.200" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬미팅 언제 해요?\n매일 만나고 싶은데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When is the fan meeting?\nI would like to see you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paparazzi would be rubbish\nwithout you, honestly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粉丝见面会什么时候开？\n我想天天见到你。"
          }
        }
      }
    },
    "quote.201" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "안무 영상 올려주세요.\n당신의 모든 움직임이 예술이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post the dance video, please.\nEvery move you make is art."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tickets to see you sold out\nin under a minute, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快发舞蹈视频吧，\n你的每个动作都是艺术。"
          }
        }
      }
    },
    "quote.202" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "티저 영상 보는 것 같아요.\n당신을 볼 때마다 설레니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watching you is like a teaser trailer.\nI get excited every single time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would watch you do nothing\nfor hours. Perfect telly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次看到你，\n都像在看预告片，期待拉满。"
          }
        }
      }
    },
    "quote.203" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "월드투어 가시나요?\n제 마음을 전 세계로 흔들어놓으셨는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going on a world tour?\nFun fact: you already shook my heart worldwide."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sunday roast with crispy roasties?\nEven that loses to you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要开世界巡演了吗？\n你早就巡演到我心里了。"
          }
        }
      }
    },
    "quote.204" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앨범 사인해주세요.\n당신의 존재 자체가 한정판이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign my album, please.\nFact: you are a limited edition."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lie-in on a rainy Sunday?\nEven that loses to you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专辑请你签个名，\n你本人就是限量款。"
          }
        }
      }
    },
    "quote.205" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "펜라이트 켤게요.\n당신을 향해 평생 응원할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am turning on my light stick.\nI will cheer for you for life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hair, face, walk: honestly,\nyou do the lot, with class."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "荧光棒已就位，\n我会一直为你打call。"
          }
        }
      }
    },
    "quote.206" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "떡상했네요.\n원래부터 레전드였는데 뭘."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you blew up overnight?\nYou were a legend way before that."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full English of people,\nthat is you: satisfying all round."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你爆红了？\n你一直是传奇，不过是被更多人发现了。"
          }
        }
      }
    },
    "quote.207" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "콘서트 티켓 구해야겠어요.\n당신을 보는 게 제 일상 콘서트니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I need concert tickets.\nWatching you is my daily live show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cherry on top\nof a cracking day: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演唱会门票我来抢，\n毕竟看你就是我的日常演唱会。"
          }
        }
      }
    },
    "quote.208" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "인기가요 1위 하셨죠?\n당신은 제 인생 1위 곡이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you hit number one on the charts?\nYou are the song stuck in my head forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ploughman's without pickle?\nUnthinkable, like me without you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拿了榜单第一吧？\n在我心里你是永远的冠军曲。"
          }
        }
      }
    },
    "quote.209" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앵콜 무대 하나 더요.\n당신은 봐도봐도 또 보고 싶으니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more encore, please.\nI can never see enough of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pure class, you. Even\nthe swans would bow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再来一首安可，\n怎么看你都看不够。"
          }
        }
      }
    },
    "quote.210" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비하인드 컷도 완벽해요.\n어느 순간도 빠짐없이 레전드."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you in the behind-the-scenes shots? Perfect.\nNo off moments, only legend."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a crowd of a hundred,\nyou are the one I spot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连花絮都这么完美，\n你的每个瞬间都是传说。"
          }
        }
      }
    },
    "quote.211" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 바꿔야겠어요.\n당신 외에는 못 보겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have to change my favorite.\nI cannot look at anyone but you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you make Monday feel\nlike a Friday night."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要换爱豆了，\n除了你，其他人都入不了眼。"
          }
        }
      }
    },
    "quote.212" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "입덕했어요.\n당신한테 영원히 덕질할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I just became a fan.\nI will stan you forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around, even\ndrizzle feels like sunshine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我入坑了，\n你这个坑我心甘情愿跳。"
          }
        }
      }
    },
    "quote.213" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 공개합니다.\n그게 바로 당신이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revealing my favorite:\nit is you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, still lovely\nafter a day of rain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公布我的本命，\n就是你。"
          }
        }
      }
    },
    "quote.214" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "굿즈 다 샀어요.\n당신이라는 존재 자체가 굿즈예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bought all the merch.\nReal talk: you are the merch. Rare and mine."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So cool are you that\nthe fridge is jealous."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周边我全买了，\n你本人就是最值钱的周边。"
          }
        }
      }
    },
    "quote.215" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 팬할게요.\n당신은 제 영원한 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am a fan for life.\nFact: you are my forever artist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite hobby:\nlooking at you. Cheap, too!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要当你的终身粉丝，\n你是我永远的偶像。"
          }
        }
      }
    },
    "quote.216" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "본진 박았어요.\n당신이 제 본진이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planted my flag.\nNo doubt, you are my number one."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five stars, would admire you again.\nWould recommend you to everyone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大本营我安在你这儿了，\n你就是我唯一的本命。"
          }
        }
      }
    },
    "quote.217" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "덕질 시작합니다.\n당신한테 올인할게요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am starting my fandom era.\nAll in on you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fan club for you? Sign me up,\nI will bring the biscuits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始追星啦，\n我把全部应援都投给你。"
          }
        }
      }
    },
    "quote.218" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "홈마 할게요.\n당신의 모든 순간을 기록하고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will be the fan photographer.\nI want to catch every moment of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would put you on a poster\nand hang it in the hall."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我来当你的站姐，\n记录你的每一个瞬间。"
          }
        }
      }
    },
    "quote.219" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "야자타임이에요.\n당신과 함께하는 시간은 다 황금시간."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a free-for-all of praise time.\nEvery minute with you is golden."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plot twist: you were\nthe best thing in the story all along."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天是应援日，\n和你在一起的时间全是黄金档。"
          }
        }
      }
    },
    "quote.220" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "생일 광고 할게요.\n매일이 당신 생일이었으면 좋겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will buy a birthday billboard.\nI wish every day were a birthday for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day should be a\nbirthday for you, with cake."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给你投个生日广告，\n真希望天天都是你的生日。"
          }
        }
      }
    },
    "quote.221" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 응원합니다.\n당신의 팬이라는 게 자랑스러워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheering for you for life.\nBeing a fan is my proudest thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being a fan of you\nis the proudest thing I do."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终身应援，\n当你的粉丝是我的荣幸。"
          }
        }
      }
    },
    "quote.222" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 때문에 심장이\n두근두근대요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My heart is going\nthump-thump because of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My heart goes pitter-patter\nwhenever you turn up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说真的，一看到你，\n我的心跳就开始加班。"
          }
        }
      }
    },
    "quote.223" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 보면\n세상이 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything looks lovely\nwhenever I look at you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking at you makes\nthe whole world lovelier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪怕只瞄你一眼，\n世界都会变好看。"
          }
        }
      }
    },
    "quote.224" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 행복의\n비타민이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are the vitamin\nmy happiness runs on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My daily dose of happy?\nThat would be you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我快乐的维生素，\n每天都由你按时供应。"
          }
        }
      }
    },
    "quote.225" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 웃으면\n나도 덩달아 행복해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you smile,\nI end up smiling too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you smile, I can't\nhelp grinning too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笑一个吧，\n你一笑我就跟着傻乐。"
          }
        }
      }
    },
    "quote.226" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 본\n가장 빛나는 별이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No doubt, you are the brightest star\nI have ever seen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The brightest star I have ever clocked?\nWell, it is you, obviously."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我见过的星星里，\n你是最亮的那颗。"
          }
        }
      }
    },
    "quote.227" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 하루하루가\n내 마음속 축제예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you\nis a festival in my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you is\na little party in my head."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个有你的日子，\n都像我心里的庆典。"
          }
        }
      }
    },
    "quote.228" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 목소리만 들어도\n기분이 좋아져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even hearing you talk\nmakes my mood better."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just hearing you talk\nputs me in a good mood."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光听见你的声音，\n心情就好起来了。"
          }
        }
      }
    },
    "quote.229" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n최고의 행운이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the best luck\nI ever had in life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeting you was the\nluckiest break of my life."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇见你，\n是我这辈子的锦鲤。"
          }
        }
      }
    },
    "quote.230" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 있어서\n오늘도 웃을 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of you,\nI can smile again today."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of you, I can\nlaugh again today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为有你，\n今天我也笑得出来。"
          }
        }
      }
    },
    "quote.231" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 세상에서\n가장 소중한 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are the most precious\nperson in the world."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most precious person in the world\nto me? Simple: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对我来说，你是\n世界上最重要的人。"
          }
        }
      }
    },
    "quote.232" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 생각하면\n저절로 미소가 나와요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking of you\nmakes me smile on its own."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking of you makes\nme smile all by myself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想到你，\n嘴角就自己上扬。"
          }
        }
      }
    },
    "quote.233" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음의\n평화예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are the calm\nin my heart."

    },
    "quote.234" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신과 함께하는 시간은\n항상 특별해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spent with you\nis always special."

        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光顾着看你，\n我的脖子都快扭了。"
          }
        }
      }
    },
    "quote.256" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 볼 때마다\n심장 박동수가 올라가요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time I see you,\nmy heart rate goes up."

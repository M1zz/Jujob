    },
    "quote.097" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시험 잘 보세요!\n당신은 충분히 준비됐어요."

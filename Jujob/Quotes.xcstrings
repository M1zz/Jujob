        }
      }
    },
    "quote.278" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 덕분에\n인생이 풀컬러예요."

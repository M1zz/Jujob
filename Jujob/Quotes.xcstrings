            "state" : "translated",
            "value" : "Rande ještě nezačalo a ty\nuž teď lámeš srdce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før I overhovedet er mødt, er du\nallerede for fin. Stakkels hjerte."
          }
        },
        "el" : {
          "stringUnit" : {

            "value" : "Έδωσες ό,τι είχες σήμερα\nκαι εσύ αξίζεις παρασημοφόρηση!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teit tänään parhaasi, ja sinä\nsaat olla siitä ylpeä!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udah berusaha sekuat tenaga hari ini,\nbangga deh sama kamu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag ga du alt,\nog jeg er kjempestolt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gaf vandaag alles en ik ben trots,\ndus nu mag jij uitrusten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cały dzień na pełnych obrotach.\nCo za wzór wytrwałości, ty!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idag gjorde du ditt bästa,\noch det är jag stolt över!"
          }
        }
      }
    },
    "quote.016" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "피곤하지만 그래도\n오늘 하루 잘 버텼어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tired, sure, but look:\nyou survived the whole day!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knackered, sure, but look:\nyou survived the whole day!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虽然很累，\n但你今天稳稳扛住了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雖然很累，\n但你今天真的撐得超漂亮！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "くたくたでも乗り切った。\nそれだけで殿堂入りです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усталость — след великих дел,\nа в них ты — просто машина!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con todo el cansancio, aguantaste\nel día como nadie. Un mito, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müde, aber geschafft!\nDas hast du fein gemacht, du Held."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu crevé, mais tu as tenu bon.\nJ'ai les larmes aux yeux, c'est beau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un po' di stanchezza?\ne tu hai retto la giornata da fuoriclasse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deu sono, mas o dia deu certo\nporque você apareceu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล้าก็ล้า แต่คุณก็รอดมา\nได้อีกวัน สุดยอด!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mệt thì mệt, nhưng bạn vẫn\ntrụ vững cả ngày. Đỉnh!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únava jde spát, ty jsi\npořád hvězda i v domácím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træt, men dagen overlevede du\nmed stil. Hatten af!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κούραση; Φυσικά! Κι όμως εσύ\nτα κατάφερες περίφημα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väsyttää, mutta selvisit silti,\nkoska sinä olet tehty kestämään."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lelah sih, tapi kamu berhasil\nbertahan sampai malam. Keren!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Litt sliten? Ja visst, men\ndu klarte det likevel!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moe, maar toch hield jij het vol.\nDat is pas een held."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogi odmawiają posłuszeństwa,\nale ty i tak zasługujesz na medal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trött men ändå klarade du dagen.\nSnacka om seg!"
          }
        }
      }
    },
    "quote.017" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 하루는 언제나\n가치 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you in it\nis a day worth having."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you in it\nis a day worth having."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你过的每一天，\n都值得被好好珍藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一天的你，\n都值得被好好珍藏。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価値のない日なんて一日もない。\nあなたが過ごした日だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечер, мягкий плед, а в роли\nлучшего гостя — ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu día valió la pena\nporque lo viviste tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag ist immer wertvoll,\nwenn du ihn gelebt hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta journée vaut de l'or,\net ce soir, tu peux t'en vanter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una giornata fa il suo corso,\nma il pezzo forte di oggi sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cansaço é o troféu de quem\nfez tudo certo, e você fez."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกวันของคุณ\nมีค่าเสมอ รู้ไหม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày nào của bạn\ncũng đáng giá hết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měsíc se ptá, kdo to tam tak\nzáří. To budeš ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dag har været guld værd,\nfor du var med i den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε μέρα σου αξίζει,\nγιατί εσύ την έζησες"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen päivä on arvokas,\nkun sinä olet siinä mukana."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari-hari kamu selalu berarti,\nsekecil apa pun itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dag der du er med\ner aldri bortkastet. Aldri!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag waarin jij meedoet\nis een dag die telt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień był udany z jednego powodu:\nty."

    "quote.107" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "면접은 서로를 알아가는 시간,\n편안하게 임해요!"
          }

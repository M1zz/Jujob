        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Život je v barvě díky tomu,\nže ty jsi jeho režisér."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dig i livet er alt\ni fuld farve."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θρύλος όλων των εποχών\nείσαι εσύ, στα μάτια μου"

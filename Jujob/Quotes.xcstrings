{
  "sourceLanguage" : "ko",
  "strings" : {
    "quote.001" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 빛나는 하루의 시작!\n당신은 이미 충분히 멋져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rise and shine! Honestly,\nyou already look like a main character."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rise and shine, gorgeous!\nHonestly, you already look the part."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早安，今天的太阳\n是专门替你打工的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早安！今天的太陽\n是專門為你打工的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい一日のはじまり。\nあなたはもう十分すてきですよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С добрым утром! Сегодня\nты — сплошной блеск."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sol sale cada mañana\npara ver quién brilla más: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen, Sonnenschein!\nSo strahlend wie heute ist nur du."
          }
        }
      }
    },
    "quote.002" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아침 해처럼 빛나는 당신,\n오늘도 최고의 하루 될 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sun came up and said,\n\"Wow, you outshine me.\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sun saw you and said:\n\"Fine, you win. I'll dim.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睁开眼的那一刻，\n你就已经赢在起跑线了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一睜開眼就贏了，\n你根本是人生勝利組。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝日みたいにまぶしいあなたが\n今日も最高の一日を連れてきます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Солнце встаёт, потому что ты\nуже в деле. Вот это да!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despierta, que hoy la luz\nmás potente de la casa eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sonne geht auf, weil sie\nweiß, dass hier ein Mensch wie du wartet."
          }
        }
      }
    },
    "quote.003" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일어난 것만으로도 대단해요!\n오늘 하루도 화이팅!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you woke up today,\nand that alone deserves a trophy!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Out of bed already? Blimey,\nyou deserve a medal and a biscuit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能起床就是英雄，\n今天也被你帅到了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能準時起床的你，\n已經是英雄等級了啦！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起きた時点で、あなたはもう優勝。\n拍手が鳴りやみません!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глаза проснулись — уже подвиг.\nА ты — герой этого утра!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abres los ojos y el día\nya es tuyo. Imparable, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon wach? Respekt!\nDer Tag hat Glück mit dir, du Frühstarter."
          }
        }
      }
    },
    "quote.004" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 아침은 세상에서\n가장 아름다운 시작이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mornings are better because\nyou are in them. Fact."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mornings are better because\nyou are in them. Fact."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的一天上线啦，\n主角当然是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的一天開機完成，\n主角當然是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界でいちばん美しい朝は\nあなたが目覚めた朝です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кофе бодрит, но ты бодришь\nлучше любого эспрессо."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se levanta una leyenda\ny esa leyenda eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der schönste Start in den Morgen\nbist und bleibst eben du."
          }
        }
      }
    },
    "quote.005" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 하루도 당신이\n주인공이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, you get\nthe leading role again!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, you get\nthe leading role again!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比咖啡更提神的，\n是你早晨的那个笑容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比咖啡還提神的，\n是你早上那個微笑。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おはようの一言で\nあなたが主役の一日が始まります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня главный герой — ты.\nОстальные просто массовка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni el café despierta tanto\ncomo tú. En serio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute spielt wieder die Hauptrolle:\nganz klar du."
          }
        }
      }
    },
    "quote.006" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "눈을 뜬 순간부터\n당신은 이미 승리자!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyes open, and you\nalready won the day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyes open, and you\nhave already won the day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闹钟响了也不慌，\n毕竟你自带光芒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鬧鐘響了不用慌，\n反正你自帶光芒。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目を開けた瞬間から\nあなたは勝者の顔をしています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красиво просыпаться умеешь\nтолько ты. Остальные — нет."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena el despertador y la\nestrella del día eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaum die Augen auf,\nschon Gewinner: du."
          }
        }
      }
    },
    "quote.007" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "커피보다 달콤한 당신의\n아침 미소!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget coffee. Everyone agrees\nyou are the real morning boost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget the tea. Everyone agrees\nyou are the real morning boost."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的好心情，\n已由你亲自发货。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的好心情，\n已由你本人親自配送。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーヒーより目が覚めるのは\nあなたの寝ぐせ付きスマイル!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будильник звонил зря: ты и так\nсияешь без всякого звонка."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo más bonito del amanecer\nno es el sol: eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süßer als jeder Kaffee ist nur\ndein Lächeln am Morgen, du Zuckerstück."
          }
        }
      }
    },
    "quote.008" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 당신답게,\n그게 최고예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be you today.\nIt is the best look in town!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just be you today.\nIt is the best look in town!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做你自己就好，\n这就是今天的满分答案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做自己就好，\n你今天也是滿分答案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありのままのあなたでいこう。\nそれが毎日いちばん強い!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утро доброе, потому что в нём\nесть ты. Всё логично!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sé tú, a tu aire:\nes lo mejor que le pasa al día."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib heute einfach so, wie du bist.\nBesser geht's nicht."
          }
        }
      }
    },
    "quote.009" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아침부터 그렇게 예뻐도 돼요?\n범죄예요, 얼굴 범죄."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking this good before breakfast?\nHonestly, you should be arrested for it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This gorgeous before breakfast?\nHonestly, you should be arrested."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一大早就这么好看，\n你这是在犯规吧？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大清早就這麼好看，\n你這樣是犯規欸！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝からそんなにかわいくていいの?\nこれはもう顔面の条件違反。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красота с утра пораньше —\nэто законно? Всё, ты в розыске!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Madrugar y encima brillar:\nesa combinación solo la tienes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon so früh so hübsch?\nDas ist ein Verbrechen, du Schuft."
          }
        }
      }
    },
    "quote.010" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "굿모닝? 노노!\n당신이 있어서 베스트모닝!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good morning? No no,\nwith you here it's a GREAT morning!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good morning? Nope,\nwith you here it is a BRILLIANT one!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别人说早安，\n我只想对你说「早安之光」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別人的早晨叫早安，\n你的早晨叫全世界請注目。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グッドモーニングじゃ足りない。\nあなたがいるからベストモーニング!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не «доброе утро», а «лучшее»,\nраз уж на горизонте ты!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Buenos días? Qué va:\nmejores días, si estás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen? Nee, Bestmorgen,\nweil du da bist!"
          }
        }
      }
    },
    "quote.011" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일어나자마자 보는 당신,\n눈호강 제대로 하네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First thing I see is you.\nMy eyes just hit the jackpot."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First thing I see is you.\nEyes officially treated."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晨光刚到，\n你的光环已经先到了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晨光還在路上，\n你的光環已經先到了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起きてすぐ見るあなた、\n目の保養がすぎます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое, что увидит мир сегодня,\nэто ты. Мир везучий."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor plan para esta mañana:\nlo tienes tú, y nadie más."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht gleich nach dem Aufstehen:\nAugenschmaus pur, du Glückspilz."
          }
        }
      }
    },
    "quote.012" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 아침에도 세상에서\n제일 빛나는 사람 발견!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaking news this morning:\nyou are the brightest thing out there."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breaking news this morning:\nyou are the brightest thing out there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天亮了，这个世界\n也因为有你而升级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天亮了，世界因為有你\n自動更新到最新版本。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝イチで発見しました、\nこの世でいちばん輝いている人を。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утренний прогноз: ясно,\nа местами ты — ослепительно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerta de luz: ya amaneció\nporque has llegado tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute früh wieder entdeckt:\nden strahlendsten Menschen, nämlich du."
          }
        }
      }
    },
    "quote.013" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 하루도 고생했어요!\n당신은 정말 대단해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long day, huh? Seriously,\nyou handled it like a legend."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long day, eh? Mind you,\nyou handled it like a legend."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辛苦啦，今天的你\n已经超额完成人生任务！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天辛苦啦，\n你已經超額完成人生任務！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日おつかれさま!\nあなたの頑張りは国宝級です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День позади, а ты всё равно\nзвезда этого вечера."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Día completado con nota,\ny la mejor de la clase eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puh, was für ein Tag!\nStolz auf dich, du Kraftpaket."
          }
        }
      }
    },
    "quote.014" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하루를 마무리하는 당신의 모습,\n정말 멋져요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrapping up the day,\nand you still look amazing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrapping up the day,\nand you still look amazing!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜幕降临，\n收工的你依旧帅气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜幕低垂，\n收工的你依然帥到不行。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕暮れに染まるあなたの横顔、\nそのまま額に入れたい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День пережит красиво, и всё это —\nты. Овации!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierras el día como lo abriste:\na lo grande, como solo tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Abend braucht Applaus,\nund der geht heute an niemand anderen als du."
          }
        }
      }
    },
    "quote.015" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 최선을 다한 당신,\n자랑스러워요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You gave it everything today,\nand we are so proud of you!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You gave it everything today,\nand we are dead proud of you!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全力以赴的你，\n真的值得一只大鸡腿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全力以赴的你，\n配得上一整份鹽酥雞！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全力を出し切った今日のあなたに\n花丸を千個あげます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закат хорош, но ты всё\nравно красивее заката."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy lo diste todo. Quien merece\nun aplauso largo eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles gegeben, wie immer.\nDarauf darf man als du stolz sein."
          }
        }
      }
    },
    "quote.016" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "피곤하지만 그래도\n오늘 하루 잘 버텼어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tired, sure, but look:\nyou survived the whole day!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knackered, sure, but look:\nyou survived the whole day!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虽然很累，\n但你今天稳稳扛住了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雖然很累，\n但你今天真的撐得超漂亮！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "くたくたでも乗り切った。\nそれだけで殿堂入りです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усталость — след великих дел,\nа в них ты — просто машина!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con todo el cansancio, aguantaste\nel día como nadie. Un mito, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müde, aber geschafft!\nDas hast du fein gemacht, du Held."
          }
        }
      }
    },
    "quote.017" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 하루는 언제나\n가치 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you in it\nis a day worth having."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day with you in it\nis a day worth having."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你过的每一天，\n都值得被好好珍藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一天的你，\n都值得被好好珍藏。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価値のない日なんて一日もない。\nあなたが過ごした日だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечер, мягкий плед, а в роли\nлучшего гостя — ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu día valió la pena\nporque lo viviste tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag ist immer wertvoll,\nwenn du ihn gelebt hast."
          }
        }
      }
    },
    "quote.018" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 무사히 마쳤다는 것,\n그것만으로 충분해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, you got through in one piece.\nThat is plenty!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is done, and you got\nthrough in one piece. That is plenty!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平安收工就是胜利，\n你已经很棒了！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平安收工就是勝利，\n你真的很棒了！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無事に終わった、\nそれだけで今日は百点満点!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзды завидуют: ты светишь\nбез всякого неба."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro día más y sigues en pie.\nHéroe de lo cotidiano: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heil angekommen?\nDas reicht schon, echt wahr, du Wunder."
          }
        }
      }
    },
    "quote.019" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "밤하늘의 별처럼\n당신도 빛나요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stars came out tonight\nbut you were already glowing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like the stars in the night sky,\nyou shine too!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚风轻轻吹，\n星星都想跟你合影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚風輕輕吹，\n連星星都想跟你合照。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜空の星だって\nあなたの輝きに嫉妬してます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День был так себе,\nно ты в нём — топ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira el cielo: miles de estrellas\ny ninguna como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie die Sterne am Nachthimmel\nstrahlt auch jemand wie du."
          }
        }
      }
    },
    "quote.020" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "저녁인데도 여전히 빛나네요.\n어떻게 하루종일 예뻐요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is evening and you still sparkle.\nHow do you do it all day?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evening already, and you\nstill look this good? How?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都晚上了还在发光，\n你是充电宝成精了吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都晚上了還在發光，\n你是行動電源成精喔？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜になってもまだ輝いてる。\nあなたの電池、どうなってるの?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже в пижаме ты — эталон\nстиля. Закон вечера."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anochece, pero la luz sigue\nencendida. La luz eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abends noch so strahlend?\nWie schaffst du das den ganzen Tag?"
          }
        }
      }
    },
    "quote.021" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하루 종일 수고했어요.\n당신이라서 다행이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for all that hard work.\nLucky me, I know you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheers for the long day.\nGlad it was you doing it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙了一整天，\n能遇见你真是太好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙了一整天，\n有你這個人真是太好了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ずっとお疲れさま。\nあなたがあなたでよかった。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если бы вечер выбирал\nлюбимчика, это был бы ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por el día, tú:\nsin ti habría sido uno cualquiera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für heute.\nGut, dass es dich gibt, du Schatz."
          }
        }
      }
    },
    "quote.022" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 당신 덕분에\n세상이 아름다웠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole world looked nicer today\nbecause you were in it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks to you,\nthe world looked lovely today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的世界这么美，\n多亏有你在其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天也多虧有你，\n世界才沒那麼無聊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の世界がきれいだったのは\nあなたがそこにいたからです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо тебе за этот день:\nты — его лучшая часть."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy el mundo fue más bonito\nporque estabas tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dank dir war die Welt heute\nein Stück schöner, du Sonnenschein."
          }
        }
      }
    },
    "quote.023" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "밤에 봐도 레전드,\n낮에 봐도 레전드."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legend at night,\nlegend in daylight. Never a dull you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legend by night, legend by day,\nand you never even clock off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白天看你是传奇，\n晚上看你还是传奇。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白天看是傳說，\n晚上看還是傳說。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜に見ても伝説、\n昼に見ても伝説。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключаем свет, но ты\nвсё равно подсвечиваешь ночь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De día, leyenda. De noche,\nleyenda. Siempre tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts eine Legende,\ntagsüber eine Legende: du."
          }
        }
      }
    },
    "quote.024" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "괜찮아요, 힘든 날도 있는 거예요.\n당신은 충분히 잘하고 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is okay, rough days happen.\nYou are doing better than you think."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is alright to have rough days.\nHonestly, you are doing fine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没关系，谁都有低谷，\n你已经做得很好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒關係，低潮本來就會有，\n你已經做得很好了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大丈夫、そんな日もあるよ。\nあなたは十分がんばってる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжёлые дни бывают у всех.\nИ ты в них — большой молодец."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mal día no cuenta.\nLo que cuenta eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist schon okay. Solche Tage gibt's.\nIn der Disziplin schlägst du dich richtig gut."
          }
        }
      }
    },
    "quote.025" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금은 힘들어도\n당신은 이겨낼 수 있어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is tough right now,\nbut you can absolutely get through it!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is tough now, but you\nwill get through it, mate!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼下虽然难，\n但你一定扛得过去！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在雖然很累，\n但你絕對撐得過去！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しんどい今を越えられるのは\nあなたしかいません!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас непросто, но ты —\nиз тех, кто вытянет."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto pasará, y quien seguirá\nde pie, como siempre, eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist es zäh,\naber am Ende packt es keiner so wie du."
          }
        }
      }
    },
    "quote.026" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "완벽하지 않아도 돼요.\n있는 그대로의 당신이 최고예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody needs perfect.\nThe real you is already the best!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to be perfect.\nJust you, as you are, is the best."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用完美，\n本来的你就已经很好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用完美啦，\n原本的你就已經是最棒的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧じゃなくていいんです。\nそのままのあなたが最高だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеалом быть не нужно: ты\nуже подарок как есть."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfección no se pide, pero\nla más cercana eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt muss keiner sein.\nGenau so, wie du bist, ist es richtig."
          }
        }
      }
    },
    "quote.027" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들 때는 쉬어가도 돼요.\n당신의 속도로 가면 돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest if you need to.\nYou can go at the pace you like, you know."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a breather if you need one.\nGo at the pace that suits you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累了就歇一歇，\n按你自己的节奏走。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累了就休息，\n照你自己的步調慢慢走。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つかれたら休もう。\nあなたのペースで進めばいい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна пауза — бери. Ведь ты\nне робот, а живой герой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa si hace falta.\nIr a tu ritmo es de sabios, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönn dir ruhig eine Pause.\nDein Tempo ist das richtige, du Schatz."
          }
        }
      }
    },
    "quote.028" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 생각보다\n훨씬 강한 사람이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plot twist: you are\nway tougher than you think!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stronger than you think?\nOh, by a country mile!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其实啊，你比自己想象中\n要坚强得多！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其實你比自己想的\n還要堅強好多倍喔！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思っているよりずっと\nタフなんですよ、あなたって。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажу по секрету: ты — сильнее\nсвоих проблем. Намного."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más fuerte de lo que crees:\neso eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viel stärker, als man denkt,\nist ein Mensch wie du."
          }
        }
      }
    },
    "quote.029" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 또한 지나갈 거예요.\n당신은 할 수 있어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will pass, and\nyou will be the one still standing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will pass too,\nand you will smash it!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一切都会过去，\n你一定可以的！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這一切都會過去的，\n相信你一定可以！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これもいつか過ぎていく。\nあなたならきっと大丈夫!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это пройдёт, а ты\nостанешься. С короной."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo pasa, también esto.\nY aquí seguirás tú, de pie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geht vorbei.\nUnd wer schafft es? Genau, du."
          }
        }
      }
    },
    "quote.030" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기분이 다운되어도\n당신의 가치는 변하지 않아요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeling low? Sure, but\nyou still have the same big value."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even when the mood dips,\nyou are worth exactly the same."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情下雨也没事，\n你的价值从不打折。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情再低落，\n你的價值也不會打折。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分が沈んでも\nあなたの価値は一ミリも下がりません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроение на дне, а ты\nвсё равно на пьедестале."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el ánimo por los suelos\nvales oro igual, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst im Stimmungstief bleibt dein Wert,\nwas er ist: unbezahlbar, du Schatz."
          }
        }
      }
    },
    "quote.031" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "슬픔도 당신의 일부예요.\n모든 감정을 느껴도 괜찮아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadness is a part of you too.\nFeel it all, you are allowed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadness is part of you too.\nFeel whatever you need to feel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "难过也是你的一部分，\n想哭就哭，我在。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難過也是你的一部分，\n想哭就哭，沒在怕的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悲しみもあなたの一部。\nどんな気持ちも感じていいんだよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грусть — гостья, а хозяин\nтут ты. Выпроваживай!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir tristeza es normal.\nTodas tus emociones valen, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traurigkeit gehört dazu.\nAlle Gefühle sind okay, du Herz."
          }
        }
      }
    },
    "quote.032" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들 때 더 빛나는 거 알아요?\n다이아몬드도 압력을 받아야 생기잖아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamonds only form under pressure,\nso yeah, you sparkle hardest now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Know when you shine brightest?\nDiamonds need a bit of pressure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道吗？钻石是被压出来的，\n你也一样，越压越闪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑽石要受壓才會閃，\n所以你現在超級閃。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知ってました? ダイヤは圧力で生まれる。\nつまりいまのあなた、磨かれ中です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слёзы — это дождик, а ты —\nрадуга после него."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sabías que el diamante\nse forma bajo presión? Como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamanten entstehen unter Druck.\nGlitzer-Alarm also, du Juwel."
          }
        }
      }
    },
    "quote.033" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "우울하면 저 보세요.\n당신한테 미쳐서 저도 우울해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeling blue? Look at me.\nI am glued to you, so I am blue too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down in the dumps? Same here,\nI'm just gutted I'm not you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情不好？看我，\n我被你迷得都emo了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心情不好嗎？看看我，\n被你迷到的我也很憂鬱啊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ち込んだら私を見て。\nあなたに夢中すぎて私も落ち込み中。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алмаз рождается под давлением,\nи ты — тому доказательство."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bajón o no, la persona\nmás valiosa del mundo eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mies drauf? Schau mich an:\nIch bin wegen dir ganz aus dem Häuschen, du Wirbelwind."
          }
        }
      }
    },
    "quote.034" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "기분 다운? 그럴 때일수록\n당신은 세상에서 제일 소중해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Down in the dumps? Even then\nyou are the most precious thing around."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feeling low? That is when\nyou matter most to the world."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低落的时候，\n你依然是我心里的宝。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低落的時候，\n你還是全世界最珍貴的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分ダウン? 上等です。\nあなたはそんな日でも世界一大切。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если грустно, вспомни:\nв мире есть ты. Уже неплохо."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar de bajón no cambia\nque el tesoro eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmungstief? Egal!\nWertvoll bleibt bei allem nur du."
          }
        }
      }
    },
    "quote.035" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "슬퍼도 예쁘고,\n울어도 예뻐요. 어쩔 거예요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You look good sad,\nyou look good crying. What now?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorgeous when sad, gorgeous when teary.\nWhat are you like?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哭起来好看，\n笑起来更好看，你说气不气？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哭起來也好看，\n難過也好看，不然你想怎樣？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "泣いてもかわいいし、\n落ち込んでもかわいい。どうしましょう?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плохой день не отменяет того,\nчто ты — отличнейший человек."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta llorando brillas\ncomo una joya."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst traurig siehst du gut aus.\nUnd beim Weinen erst recht. Unfair!"
          }
        }
      }
    },
    "quote.036" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금 힘들어도\n당신이라는 존재 자체가 기적이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even on a bad day,\nyou being here is a small miracle."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even on a rubbish day,\nyou being you is a miracle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就算今天很糟，\n你的存在本身就是奇迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就算現在很辛苦，\n你的存在本身就是奇蹟。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つらい時でも、あなたがここにいること\nそれ自体が奇跡なんです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже в хмурый день ты —\nмаленькое личное солнышко."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que hoy cueste no cambia\nlo esencial: el milagro eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch an schweren Tagen:\nEin kleines Wunder bleibt immer du."
          }
        }
      }
    },
    "quote.037" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금은 힘들지만,\n당신은 반드시 해낼 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is hard right now,\nbut you will totally pull through!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is hard right now, but\nyou will absolutely do it!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前路再难，\n有你在就一定闯得过去！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在雖然辛苦，\n但你一定會成功的！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦しいのは今だけ。\nあなたは必ずやりとげます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тучи пройдут, а ты\nостанешься в моём топе."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy cuesta, pero lo lograrás:\nlo digo yo y lo sabes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute ist es schwer,\naber am Ende gewinnt eben du."
          }
        }
      }
    },
    "quote.038" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "어려운 순간일수록\n당신의 진가가 드러나요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tough moments are when\nyou show how awesome you are!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tougher the moment,\nthe more you shine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越是艰难的关头，\n越能看出你有多闪耀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越是艱難的時刻，\n越看得出你的真本事！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンチの時こそ\nあなたの本当の実力が光ります!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трудно сейчас. Но ты —\nчеловек, который не сдаётся."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los malos ratos se nota\nquién tiene casta: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade jetzt zeigt sich,\nwas in dir steckt, du Kämpfer."
          }
        }
      }
    },
    "quote.039" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포기하지 마세요.\n당신은 충분히 강해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not quit. You are\nmade of stronger stuff than you think."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't give up, you\nare plenty strong enough!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别放弃，\n你的韧劲儿全世界都看得见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要放棄喔，\n你比你想的還要強大！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あきらめないで。\nあなたは自分で思うより強いから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сдаваться — не твой жанр,\nведь ты — боевик с хорошим финалом."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te rindas. Fuerza de sobra\nla tienes tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib nicht auf.\nStark genug ist doch keiner so wie du."
          }
        }
      }
    },
    "quote.040" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘든 시기를 견디는 당신,\n정말 대단해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanging in there through all this?\nHonestly, you are a hero."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticking it out through a rough patch?\nHats off, you amazing thing!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撑过难熬时刻的人，\n真的太了不起了，说的就是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撐過低潮的你，\n真的超級厲害！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つらい時期を耐えているあなた、\nもうヒーローです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдержать такое — это\nуровень «ты — легенда»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguantar como lo haces\nes cosa de héroes, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie hältst du das nur aus?\nDas ist echte Größe, du Riese."
          }
        }
      }
    },
    "quote.041" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘의 고난은 내일의\n성장 밑거름이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's struggle is just\nfertilizer, and you are about to bloom."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's struggle feeds\ntomorrow's growth, and you know it!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃的苦，\n都是你明天长高的养分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃的苦，\n都是明天長大的養分！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の苦労は、明日の自分を\nぐんと育てる肥料になります!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодняшняя боль — тренировка,\nа ты — будущий чемпион!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los palos de hoy son abono:\nmañana la flor serás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kampf von heute ist\ndas Wachstum von morgen, versprochen, du Pflänzchen."
          }
        }
      }
    },
    "quote.042" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 생각보다\n훨씬 더 많이 견딜 수 있어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can handle\nway more than you believe!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you can handle\nfar more than you think!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能扛住的事，\n远比你以为的多得多！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別小看自己，\n你能承受的遠比想像中多！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耐える力だって、あなたは\n想像の三倍くらい持ってますよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаешь, ты выдерживаешь больше,\nчем показываешь. Это сила."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguanta más de lo imaginable\nquien, como tú, no se rinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dir steckt mehr Ausdauer,\nals du je gedacht hättest, du Marathon."
          }
        }
      }
    },
    "quote.043" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 힘든 순간도\n곧 추억이 될 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soon this hard stretch will be\na story you tell about how you won."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rough patch will soon be\na story you tell over a brew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这段难熬的日子，\n将来都会变成你的段子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段辛苦的日子，\n以後都會變成回憶啦！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このしんどさも、そのうち\n笑い話になる日が来ます!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через год будем смеяться над\nэтим. А пока ты — в обнимашках."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mal rato será anécdota\ny quien la cuente, leyenda: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bald denkst du an den Moment\nnur noch mit einem Lächeln zurück."
          }
        }
      }
    },
    "quote.044" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들어도 당신은 빛나요.\n다이아도 깎여야 빛나잖아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamonds shine after the cutting,\nso of course you glow right now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rough times, yet you still shine.\nDiamonds need cutting to sparkle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磨一磨才发光，\n你就是那颗被打磨的钻石。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再累你還是在發光，\n連燈泡都自嘆不如。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削られるほど輝くのがダイヤ。\nあなたもいま、きらめき途中です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блестишь даже в тяжёлые дни:\nты — настоящий бриллиант."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diamantes brillan tras\nel pulido. Igual que tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschliffen strahlt es heller.\nGilt für Diamanten und für dich, du Brillant."
          }
        }
      }
    },
    "quote.045" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금 힘들다고요?\n그래도 당신은 세상에서 제일 예뻐요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Having a rough time?\nStill, you are the best-looking thing in the room."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Having a hard time? Still,\nyou are the best-looking one around."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觉得很难？没事，\n你依然是我心中的顶配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說現在很糟？\n可是你糟得很好看欸。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つらいって? それでも\nあなたは世界一かわいい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да, тяжело. Но ты по-прежнему\nукрашаешь этот мир."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mal día? Aun así, lo mejor\nque he visto hoy eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles zu viel? Egal:\nSo hübsch bleibt trotzdem nur du."
          }
        }
      }
    },
    "quote.046" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 버티는 게\n누군가에겐 희망이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somebody out there sees you hang on\nand thinks, I can too."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somewhere, someone finds hope\nin you simply keeping going."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的坚持，\n正在悄悄点亮别人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咬牙撐著的你，\n對某個人來說就是希望。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "踏ん張るあなたの姿が\n誰かの希望になっています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то смотрит на тебя и верит\nв лучшее: ты — чей-то пример."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que sigas adelante es la\nesperanza de alguien, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Durchhalten ist für manche\neine echte Hoffnung, du Held."
          }
        }
      }
    },
    "quote.047" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들어 죽겠어도\n예쁜 건 어쩔 수 없네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drained and exhausted, and\nyou still look this good? Rude."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absolutely shattered, yet\nyou still look lovely. Typical."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累到不想动了，\n你的颜值还在加班。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累到快翻掉了，\n可是帥還是帥，沒辦法。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しんどくて倒れそうでも\nかわいいのは止められないんですね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хуже некуда, а ты всё равно\nнаше чудо. Таков закон."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la moral por los suelos\nsigue habiendo luz: eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix und fertig, aber trotzdem schön.\nDagegen ist man machtlos, du Naturgewalt."
          }
        }
      }
    },
    "quote.048" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 당신은 할 수 있어요!\n자신감 있게 시작해봐요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today you can do it!\nStart like you mean it!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today you can do it!\nStart with confidence, mate!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放手去干吧，\n你的底气比想象的足！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的你一定行！\n帶著自信出發吧！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やれますよ、あなたなら!\n自信満々でいってみよう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня ты в ударе!\nМир, держись крепче."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy se puede con todo, y\nquien mejor lo sabe eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf geht's, heute läuft's.\nGlaub an dich, du Profi!"
          }
        }
      }
    },
    "quote.049" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 능력을 믿어요!\n오늘도 멋진 하루 될 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I believe in you,\nand today will be a good one!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I believe in what you can do!\nToday will be a good one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我对你的能力，\n有百分之两百的信心！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我對你的實力有信心，\n今天一定超順！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの実力、信じてます。\n今日もきっといい日になる!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Верь в себя, ведь ты\nв этом деле профессионал."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confío en tu talento:\npara esto, el mejor eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich glaube an dein Können.\nHeute wird richtig gut, du Optimist."
          }
        }
      }
    },
    "quote.050" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "준비된 당신,\n이미 성공의 반이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at that, you showed up ready,\nso half the win is done!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ready already? Then you are\nhalfway to success!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好的你，\n已经成功一半了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備好的你，\n已經成功一半啦！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備万端のあなたは、\nもう成功の半分をつかんでます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считай, что победа в кармане:\nты же в деле!"

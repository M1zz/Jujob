    "quote.019" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "밤하늘의 별처럼\n당신도 빛나요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stars came out tonight\nbut you were already glowing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like the stars in the night sky,\nyou shine too!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚风轻轻吹，\n星星都想跟你合影。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晚風輕輕吹，\n連星星都想跟你合照。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜空の星だって\nあなたの輝きに嫉妬してます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День был так себе,\nно ты в нём — топ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira el cielo: miles de estrellas\ny ninguna como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie die Sterne am Nachthimmel\nstrahlt auch jemand wie du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le ciel du soir, il y a des étoiles\net, tout au milieu, tu brilles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come le stelle nel cielo,\nanche tu fai luce senza sforzo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

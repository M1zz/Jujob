        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rankkoja päiviä tulee, mutta sinä\nselviät niistä, vaikka et usko."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak apa-apa kok, hari berat itu wajar.\nPercaya deh, kamu udah cukup baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dårlige dager finnes, men uansett\ngjør du det bra."

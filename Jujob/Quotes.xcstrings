        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein innerer Frieden?\nDas bist du."
          }
        }
      }
    },
    "quote.235" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 아는\n가장 멋진 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you are the coolest\nperson I know."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loveliest person I know?\nEasy: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我认识的人里，\n你最酷，没有之一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我認識的人當中，\n你是最棒的那一個。"

        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt klart är du bättre än\ndu tror. Fråga vem som helst."
          }
        }
      }
    },
    "quote.147" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 이미\n충분히 잘하고 있어요."

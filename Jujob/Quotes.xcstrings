    "quote.081" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "퇴근하는 당신의 뒷모습,\n정말 멋져요!"

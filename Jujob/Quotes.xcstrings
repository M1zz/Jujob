        }
      }
    },
    "quote.235" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 아는\n가장 멋진 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you are the coolest\nperson I know."

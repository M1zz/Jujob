    "quote.108" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "면접관이 당신을 안 뽑으면\n그 회사 손해예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If they skip over you,\nthat company just lost big."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If they don't hire you,\nit is their loss."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要是不录用你，\n那是公司的损失。"

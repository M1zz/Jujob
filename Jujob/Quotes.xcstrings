    "quote.044" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들어도 당신은 빛나요.\n다이아도 깎여야 빛나잖아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamonds shine after the cutting,\nso of course you glow right now."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rough times, yet you still shine.\nDiamonds need cutting to sparkle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磨一磨才发光，\n你就是那颗被打磨的钻石。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再累你還是在發光，\n連燈泡都自嘆不如。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削られるほど輝くのがダイヤ。\nあなたもいま、きらめき途中です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блестишь даже в тяжёлые дни:\nты — настоящий бриллиант."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los diamantes brillan tras\nel pulido. Igual que tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschliffen strahlt es heller.\nGilt für Diamanten und für dich, du Brillant."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même cabossé, tu brilles : une pierre\nprécieuse, ça se taille d'abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche i diamanti vanno levigati.\nSe brilli così è perché tu non cedi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até diamante apanha pra brilhar,\ne você já tá ofuscando geral."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่อให้เหนื่อย คุณก็ยังเปล่งประกาย\nเพชรต้องโดนเจียถึงจะแวว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khó thì khó, bạn vẫn lấp lánh,\nkim cương cũng phải mài mới sáng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamení se brousí a ty\nse zrovna lesknou víc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv om du er under pres,\nskinner du som en diamant."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ότι αντέχεις εσύ\nδίνει ελπίδα σε κάποιον άλλον"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiotaan, hiotaan: timantti kiiltää\nvasta kun sinä kestät hionnan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihajar masalah pun kamu tetap kinclong,\nnamanya juga berlian diasah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med regn og motvind\nlyser du opp hele veien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwaar, maar toch glinster jij.\nSlijpen laat een diamant schitteren."

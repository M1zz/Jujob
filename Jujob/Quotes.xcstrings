        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie du dich anstrengst,\nmotiviert andere, glaub mir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu fais des efforts, tu inspires\nquelqu'un, même sans le savoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ti impegni, tu sei\nl'ispirazione di qualcuno."

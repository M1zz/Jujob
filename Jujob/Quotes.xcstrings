    "quote.231" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 세상에서\n가장 소중한 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are the most precious\nperson in the world."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most precious person in the world\nto me? Simple: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对我来说，你是\n世界上最重要的人。"

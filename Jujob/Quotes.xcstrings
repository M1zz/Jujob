          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle som ser at du gir alt\nkommer til å heie på deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

        }
      }
    },
    "quote.116" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 당신의 미소가\n최고의 무기예요!"

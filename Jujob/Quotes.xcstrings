        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vandrande historiebok är du.\nDe kommer skriva om dig."
          }
        }
      }
    },
    "quote.254" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 매력에\n계속 당하고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would happily keep falling\nfor the charm of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will keep falling for\nthe charm of you, again and again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被你的魅力击中，\n我愿意一直中招。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被你的魅力電到，\n我願意被電一輩子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魅力にやられっぱなしで\nあなたの虜になりたい日々です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоё обаяние бьёт без промаха:\nтакой ты — снайпер улыбок."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona de libro de\nhistoria eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine lebende Legende ist nur eine:\nnämlich du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À force de ne regarder que toi,\nj'aurai un torticolis, mais tu en vaux la peine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi lascio incantare ogni volta:\nfai sempre centro, tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu charme me derrota toda vez.\nPior: você nem tenta, né?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสน่ห์ของคุณ\nฉันยอมโดนทุกวันเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thế giới có bạn thật là\nmay mắn vô cùng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj šarm je nebezpečný,\nale ty ho nosíš s úsměvem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du have, at jeg falder for dig?\nJeg er allerede på vej ned."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε κοιτάζω τόσο πολύ\nπου εσύ μου έφερες πόνο στον αυχένα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinuun keskittyessäni niskani\njäi jumiin, sinä viehkeä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terpesona terus sama kamu\naku sih ikhlas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når jeg stirrer på deg\nfår jeg nakkesleng. Verdt det, du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar jij charme uitdeelt,\nwil ik voor altijd in de rij staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magnes? To ty:\ntrzymasz mnie przy sobie bez wysiłku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag faller för din charm igen\noch igen, för du ger mig inget val."
          }
        }
      }
    },
    "quote.255" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신한테만 집중하다가\n목 디스크 올 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stared at you so long\nI might need a neck brace."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staring at you so much\nI may need a neck brace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光顾着看你，\n我的脖子都快扭了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一直盯著你看，\n我的脖子應該快要落枕了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見とれすぎて首が痛い。\nあなたを見すぎた罰です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрю на тебя без остановки —\nшея просит отпуск, а ты — повод."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu encanto es un hechizo\ny yo caigo siempre, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von deinem Charme\nwill ich mich immer wieder überrollen lassen, du Naturgewalt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois que tu apparais,\nmon cœur passe la seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi viene il torcicollo a forza\ndi voltarmi quando passi tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tanto olhar pra você\no pescoço já pediu arrego."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มองแต่คุณจนเพลิน\nกลัวคอเคล็ดแล้วนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thật ra bạn là phiên bản\nnâng cấp của sự dễ thương."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z koukání na tebe mě bolí\nkrk, a ty za to můžeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg stirrer så meget på dig,\nat jeg får nakkesmerter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε φορά που εσύ\nχαμογελάς, ανεβαίνει ο σφυγμός μου"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sykkeeni nousee aina, kun sinä\nastut näkökenttääni."
          }
        },
        "id" : {

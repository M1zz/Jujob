        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有你在，\n可能性就是无穷无尽的！"
          }
        }
      }
    },
    "quote.131" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 하루도\n최선을 다해봐요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give today\neverything you have!"

          "stringUnit" : {
            "state" : "translated",
            "value" : "Presente do universo?\nSó pode ser você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ของขวัญที่ดีที่สุด\nในชีวิตฉันคือคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù bạn không phải người nổi tiếng,\nem vẫn muốn xin chữ ký."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejhezčí dárek od života?\nŽe ty vůbec existuješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livets bedste gave er, at du\nfindes, og at jeg kender dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κόσμος είναι ομορφότερος\nγιατί εσύ είσαι εδώ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivä ilman sinua olisi kuin\nkahvi ilman kofeiinia, sinä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadiah terindah dalam hidupku\ntuh kamu, tanpa bungkus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verden er enda vakrere\nfordi du er i den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het mooiste cadeau van mijn leven?\nDat ben jij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepszy prezent od losu?\nOczywiście ty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bästa present som livet gett mig\när du, med rosett."
          }
        }
      }
    },
    "quote.241" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 있어서\n세상이 더 아름다워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The world is prettier\nbecause you exist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around, the\nworld is a lovelier place."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多亏有你，\n这个世界更美好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為有你，\n世界又更美了一點。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この世界がもっときれいなのは\nあなたがいるからです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Весь мир красивее на десять\nбаллов, если в нём ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mundo es más bonito\ndesde que estás tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schönste Geschenk meines Lebens,\ndas bist du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans toi, le monde serait moins beau,\nc'est mathématique, tu peux vérifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mondo è un posto migliore\nsolo perché ci sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mundo ganhou mais cor\ndesde que você chegou."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โลกสวยขึ้นอีกเท่าตัว\nเพราะมีคุณอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có bạn là em thấy\nnhà nào cũng thành tổ ấm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díky tobě je svět barevnější\na ty to víš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verden er smukkere, fordi du\ner en del af den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια μέρα χωρίς εσύ\nδεν μπορώ να τη φανταστώ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ykkönen sydämessäni on\nsinä, ei kiistaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunia ini lebih cantik\nkarena kamu ikut menghuninya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dag uten deg?\nIkke tenkelig, så du blir her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik zweer het: als jij er bent\nis de wereld nog een stuk mooier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świat jest piękniejszy,\nbo ty na nim mieszkasz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Världen är ett bättre ställe\nsedan du kom till den."
          }
        }
      }
    },
    "quote.242" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 없는 하루는\n상상도 할 수 없어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A day without you?\nI cannot even picture it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A day without you\nis hard to imagine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有你的一天，\n我连想都不敢想。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有你的日子，\n我連想像都辦不到。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想像もできません、\nあなたのいない一日なんて。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не представляю день без тебя:\nты — моя точка отсчёта."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día sin ti da pereza.\nUn día contigo es fiesta, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir ist die Welt\nnoch ein Stück schöner, du Sonnenstrahl."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une journée sans toi ? Impossible,\nje ne sais pas ce que tu me fais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una giornata senza te? Impensabile.\nOgni giorno ho bisogno che ci sia tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imaginar um dia sem você?\nImpossível, já tentei."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันไหนไม่มีคุณ\nฉันนึกภาพไม่ออกเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần gặp bạn, em lại\ncó thêm lý do để yêu đời."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den bez tebe nedává smysl,\nty jsi přece jeho střed."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dag uden dig? Det kan\njeg slet ikke forestille mig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε κάθε λίστα μου\nεσύ είσαι πάντα το νούμερο ένα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaiken mahdollistaa se, että\nsinä seisot vierelläni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayangin sehari tanpa kamu?\nNggak sanggup, deh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hjertet mitt står du\npå førsteplass for alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik kan me geen dag voorstellen\nwaarin jij ontbreekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień bez ciebie? Nie dla mnie,\nty to mój tlen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänk dig en dag utan att du\nfinns. Nej tack, jag passar."
          }
        }
      }
    },
    "quote.243" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음속\n영원한 1등이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are forever number one\nin my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In my heart, you will\nalways be number one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心里，\n你永远是第一名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心裡，你永遠是\n不動搖的第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心の中の順位表では\nあなたがずっと一位です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое место в моём сердце\nзанимаешь ты. Пожизненно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposible imaginar mi día\nsin la persona que eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag ohne dich?\nKann ich mir nicht vorstellen, du Schatz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fond de mon cœur, tu es\nla numéro un pour toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel mio cuore, il numero uno\nè sempre e solo tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pódio do meu coração,\nvocê ocupa os três lugares."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่หนึ่งในใจฉัน\nคือคุณตลอดกาล"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu em có điều ước,\nchắc em chỉ muốn thấy bạn vui."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V žebříčku srdce ty vedeš\na nikdo tě nepředběhne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I mit hjerte står du\npå førstepladsen for evigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είσαι δίπλα μου, εσύ\nμε κάνεις να νιώθω ότι όλα γίνονται"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka päivä kiitän tuurista, koska\nsinä olet osunut kohdalleni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringkat satu di hatiku\nnggak pernah berubah: kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med deg ved min side tror jeg\nat du og jeg kan alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In mijn hart blijf jij altijd\nnummer één."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W moim sercu numer jeden:\nty. Bez konkurencji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etta på mitt hjärtas topplista?\nDet är du, självklart."
          }
        }
      }
    },
    "quote.244" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신과 함께라면\n뭐든 할 수 있을 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around,\nI feel like I can do anything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you by my side,\nI could do anything."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有你在身边，\n我觉得自己什么都行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要有你在，\n我感覺什麼都辦得到。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なんでもできそうな気がします、\nあなたが隣にいてくれたら。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядом с тобой всё по плечу: ты\nпрямо источник смелости."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mi corazón hay un puesto\nde honor y su dueño eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine ewige Nummer eins?\nNatürlich du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec toi à mes côtés, j'ai l'impression\nque tu rends tout possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ci sei tu\nsi può affrontare qualsiasi cosa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você tá do meu lado,\nqualquer plano dá certo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้ามีคุณอยู่ข้างๆ\nฉันทำได้ทุกอย่าง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với em thì bạn\nlà món quà quý nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tebou zvládnu cokoli,\nty jsi můj tým."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dig ved min side tror jeg,\nat jeg kan alt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε μέρα ευχαριστώ\nτον κόσμο που υπάρχεις εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hymysi voittaa kaiken maailmassa,\nja sinä tiedät sen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asal bareng kamu,\nrasanya semua bisa kuhadapi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag er jeg takknemlig\nfor at du finnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer jij naast me staat,\nlijkt alles mogelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z tobą mogę wszystko,\nbo ty to moja supermoc."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dig vid min sida känns allt\nmöjligt, för du är superkraften."
          }
        }

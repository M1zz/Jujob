    },
    "quote.265" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n골든타임이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the golden hour\nof my life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The golden hour of my life\narrived when you did."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生里的黄金时刻，\n有一大半都是你给的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

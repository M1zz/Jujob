        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz langsam, in dem Tempo von dir,\nkommst du genauso an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doucement : tu avances à ton rythme,\net c'est parfait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con calma, a passo morbido:\ntu non hai fretta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu tempo, do seu jeito.\nPode confiar que você chega lá."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่อยๆ ไปนะ\nตามจังหวะของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ từ thôi, cứ đi theo\nnhịp của bạn là được."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomalu, svým tempem, ty\njsi ten, kdo určuje rytmus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag det stille og roligt,\ni dit eget tempo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφιέρωσε χρόνο στον εαυτό σου·\nεσύ το χρειάζεσαι σήμερα"

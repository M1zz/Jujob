    },
    "quote.054" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일 시작 전 당신의 모습,\n이미 프로페셔널이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before work even starts,\nyou already look like a pro!"

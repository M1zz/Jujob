          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 노력을 아는 사람은\n당신을 응원할 거예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who sees how hard you work\nwill be rooting for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People who see how hard you work\nwill always cheer you on."
          }
        }
      }
    },
    "quote.137" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 충분히\n가치 있는 사람이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say it with me: you are more than enough\nand worth every bit of hype!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are enough\nand worth every bit!"
          }
        }
      }
    },
    "quote.138" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "있는 그대로의 당신,\n그게 완벽해요!"

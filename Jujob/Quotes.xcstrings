    "quote.161" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "완벽하지만 구멍 하나 있네요.\n황홀(hole)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are perfect, but I found\none small flaw: you have a hole-in-one on my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a parking ticket?\nYou have 'fine' written all over you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪里都好，\n就是你身边少了一个我。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哪裡都好，\n就是你還缺一個我。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完璧なのに、ひとつだけ穴がある。\nそれは「落とし穴」。恋に落ちるから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минус в тебе всего один:\nты заставляешь забыть про остальных."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defectos tuyos: he buscado\ndos veces y nada. Error 404, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast perfekt, aber ein kleiner Fehler:\nzu schön für diese Welt. Gemeint ist: du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est parfait chez toi, sauf un détail :\ntu m'empêches de regarder ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un solo difetto: che tu\nnon abbia nessun difetto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabe o que falta em você?\nNada. Nem um defeitinho pra contar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณไม่ใช่ขนมหวาน\nแต่ทำใจฉันเป็นเบาหวานได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoàn hảo thế này mà chỉ thiếu\nđúng một thứ: lỗi để chê."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokonalost s jedním háčkem.\nTen háček? Že ty o tom nevíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt som du er, mangler der\nkun én ting: mig ved siden af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τεστ προσωπικότητας\nβγάζει «κούκλα»· εσύ διαφωνείς;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täydellinen, mutta yksi vika:\nsinä olet liian hyvä ollaksesi totta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katanya nggak ada yang sempurna.\nBerarti kamu itu pengecualian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så fin du er at jeg trenger\nsolbriller innendørs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect, op één puntje na:\nje maakt me volledig sprakeloos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukam wad, a ty\nbez żadnej. Skandal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegeln ber om autograf, så\nperfekt är du."
          }
        }
      }
    },
    "quote.162" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "엠비티아이 검사결과\n큐트라며?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personality test says\nyou are 100% adorable. Case closed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect, apart from one flaw:\nI cannot find a single flaw in you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测了测你的性格，\n结果是：可爱到超标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是什麼星座？\n你是我的「心」座。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの性格診断の結果\n「キュート」しか出ませんでした。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест на личность выдал:\nты — «милота», без вариантов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El número Pi? Infinito,\nirracional y muy de nota. Igual que tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Persönlichkeitstest sagt:\nGefährlich süß, wie du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résultat de ton test de personnalité :\ntu es à 100 % adorable. Aucune marge d'erreur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei tu il Wi-Fi?\nPerché con te sento una connessione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidado: você causa vício,\ne ainda não existe reabilitação."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นลูกกวาดหรือเปล่าเนี่ย\nถึงหวานใจฉันทุกครั้งที่เห็นคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em bị cận nặng, vậy mà nhìn bạn\nvẫn thấy đẹp rõ mồn một."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test osobnosti dopadl jasně:\nty jsi na 100 % roztomilost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personlighedstesten siger, du er\nhelt sød. Den har aldrig taget fejl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο καθρέφτης είπε «πάω για ύπνο»\nγιατί εσύ τον ξεπέρασες σε λάμψη"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persoonallisuustesti paljasti:\nsinä olet sataprosenttisesti ihana."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes kepribadian bilang\nkamu 100% menggemaskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du kart? Jeg gikk meg vill\ni øynene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat zei de persoonlijkheidstest?\nDat jij het schattigst bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test osobowości wyszedł jasno:\nty to słodziak z dyplomem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testresultatet kom just:\ndu är 100 % söt."
          }
        }
      }
    },
    "quote.163" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "네가 귀엽다고 생각하는 사람 손 들어주세요 하니까\n지구가 성게 모양이 됐어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They said, \"hands up if you think you are cute\"\nand the whole planet raised both hands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a magician? Everyone\nelse vanishes when I look at you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人说你不可爱，\n我当场表演了一个原地爆炸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想買保險，\n因為你讓我心跳漏拍，需要理賠。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「あなたをかわいいと思う人?」と聞いたら\n地球が手のひらの森になった。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто считает, что ты — милота?\nПланета подняла руки. И Луна."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ser guapo fuera delito,\nla cadena perpetua llevaría tu nombre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, die dich süß finden, bitte melden.\nDie Erde kippt gleich zur Seite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que ceux qui te trouvent adorable lèvent la main.\nTout le monde debout, tu vois ça ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei una bomba, ma di quelle buone:\nsolo tu esplodi di simpatia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se beleza fosse crime, você\npegava prisão perpétua."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าความน่ารักต้องเสียภาษี\nคุณคงเสียมากสุดในประเทศ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điện thoại em sắp hết pin,\nnhìn bạn một cái là sạc đầy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo si myslí, že ty jsi\nk sežrání, ať zvedne ruku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, der synes, du er sød,\nbedes række hånden op. Det er en skov."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η ομορφιά ήταν έγκλημα,\nεσύ θα είχες ήδη ισόβια"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysyin: nostakaa käsi, jos sinä olet söpö.\nNyt koko planeetta vilkuttaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada survei: siapa yang paling imut?\nHasilnya, semua jari nunjuk kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du wifi?\nFor jeg kjenner en sterk forbindelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handen omhoog wie denkt dat jij schattig bent!\nDe hele wereld stond meteen op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilu ludzi uważa, że ty to słodziak?\nNie wiem, zabrakło palców."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla som tycker att du är söt:\nräck upp handen! Hela jorden vinkar."
          }
        }
      }
    },
    "quote.164" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너를 음계로 표현하면 레야..\n도를 지나쳐서 미치기 직전이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If I rated you from do to ti,\nI would run out of notes. Off the scale!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got a plaster? I scraped\nmy knee falling for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星座运势说今天会遇到贵人，\n我一抬头就看见了你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "珍奶跟你有什麼不同？\n珍奶會喝完，你讓我回味一輩子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたを音階にすると「レ」。\nだって「ド」が過ぎて、もう夢中だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ты — нота, то «до»:\nдо чего же ты — мечта!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test de personalidad: resultado\n«madre mía, qué maravilla». Eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eiskaffee? Nein, erfrischender:\nso bist nur du, du Genuss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai cherché « canon » dans le dico :\ntu étais dans l'illustration, forcément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmi tu se esisti davvero:\nsembri uscito da un sogno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá com GPS? Porque você\nme deixou perdido de vez."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เห็นคุณทีไรใจสั่น\nคุณนี่สัญญาณเตือนภัยชัดๆ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho em hỏi đường đến tim bạn\nđược không? Em lạc mất rồi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Policie hlásí: tvoje krása\npřekročila povolenou rychlost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du var en tone, var du den\nhøje, som alle gerne vil ramme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε λένε κόσμημα;\nΛίγο είναι, εσύ είσαι ολόκληρο κοσμηματοπωλείο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kauneusihmeet vertaavat itseään:\nsinä olet se mittapuu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagiku kamu tuh kayak huruf vokal,\ntanpa kamu kalimatku nggak kebaca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er det varmt her inne,\neller er det bare at du er her?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als jij een tijdperk was,\nvolgde ik meteen een geschiedenisles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala ma siedem nut,\nale ty to ósmy cud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte bara ett do-re-mi, du är\nhela symfonin."
          }
        }
      }
    },
    "quote.165" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "경마장 가면 안 되겠다.\n너무 완벽해서 말이 안 나와."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not enter any beauty contest, you.\nThe others would just quit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cream first or jam first?\nWhatever, you are the best bit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道你和地球的区别吗？\n地球绕着太阳转，我绕着你转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是偷吃糖？\n你怎麼這麼甜，我都血糖高了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "競馬場には行けないな。\nあなたが完璧すぎて馬も言葉を失う。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На скачки тебя не пустят: ты —\nфаворит, всё и так ясно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas filtro: ya vienes\nen alta definición, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich suche eine Tankstelle.\nDeine Augen tanken mein Herz voll, du Zapfsäule."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec toi, mon cœur capte cinq barres :\nton signal bat celui du Wi-Fi, tu sais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il navigatore dice \"ricalcolo\":\nla nuova destinazione sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizem que perfeição não existe,\nmas aí vem você e desmente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบตฉันเหลือ 1%\nพอเจอคุณก็ชาร์จเต็มเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trời nóng thế này chắc do\nbạn quá hot đó mà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze všeho v cukrárně\nty jsi ten nejsladší zákusek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv modvinden bliver til medvind,\nnår du cykler forbi."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στον πίνακα βαθμολογίας\nσε βάζουν δέκα, κι εσύ είσαι εκτός κλίμακας"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poliisi pysäytti ja sanoi:\nsinä ajat sydämeeni ylinopeutta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan sering lewat depan rumahku,\nnanti satu RT kesengsem sama kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du var en grønnsak,\nvar du en søtpotet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet jij naar de dokter? Nee,\njij bent de enige remedie die ik zoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ty wchodzisz na tor,\nkonie stają z wrażenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du bagare? För du får mitt\nhjärta att jäsa."
          }
        }
      }
    },
    "quote.166" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너보고 예쁠 때마다 이마를 쳤더니\n거북목이 완치됐어."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time you looked great, I clapped my hands.\nNow they hurt, but I would not stop."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last custard cream in the tin,\nthat is you. Treasure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是不是会魔法？\n不然我怎么一见你就晕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為什麼你一笑，\n我就想把手機桌布換成你？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたがかわいくて膝を打つたび\n猫背が完治しました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда ты проходишь мимо, шея\nсама поворачивается. Нечестно!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicen que el dinero no da la\nfelicidad. Pero tú sí, y sin IVA."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mir ist nach Regen zumute.\nDas Herz stürmt nämlich wegen dir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand je te regarde, mon cerveau affiche :\nerreur 404, tu n'as aucun défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furto confermato:\nil cuore è sparito e il ladro sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você fosse um verbo,\nseria \"brilhar\": irregular e único."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าเดินผ่านหน้าฉันบ่อย\nเดี๋ยวใจต้องส่งซ่อม เพราะคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao bạn không đi thi hoa hậu?\nVì ban giám khảo sợ mất giải."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mám slabý zrak? Ne,\njen ty zářiš na 100 wattů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du går forbi, vender jeg mig,\nog nu har min nakke aldrig været bedre."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε λένε μπαλαρίνα;\nΜάλλον ναι, γιατί εσύ χορεύεις στις καρδιές"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakkolappu tuli: sinä olet liian\nhyvännäköinen julkiseen tilaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap kamu lewat aku bengong,\nsampai lupa cara kedip."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke bare pen, nei, du er\npen på alle språk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke keer dat jij lacht, hoor ik engelen.\nMijn gehoor is er beter van geworden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoza: przelotne zauroczenie,\nwinowajca: ty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje gång du är fin lutar jag\nhuvudet bakåt. Nackspärren är botad."
          }
        }
      }
    },
    "quote.167" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "제가 주유소만 가면 넣는 기름이 있어요.\n바로 온리유."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is only one fuel I ever put\nin my tank: you, always you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would give you my last chip.\nThat is proper love, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天吃了什么？\n怎么一开口就甜到我了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想去加油站，\n因為你就是我的「加油」站。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給油所に行くたび入れたくなるのは\nあなたへの「ハイオク」な気持ち。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какой у меня любимый бензин?\nТот, что называется «ты»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fueras un cuento,\nserías el que nunca se acaba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich mag Wörter, aber bei dir\nfehlen sie mir. Nur noch Staunen, du Wunder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a un fruit que j'adore : la pêche.\nEn te voyant, j'ai la pêche, tu vois ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pizza è invidiosa:\nsolo tu piaci a chiunque, come lei."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me explica: como você pode\nser tão incrível e ainda humilde?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเป็นเครื่องซักผ้าหรือเปล่า\nล้างความเหนื่อยแล้วใจหมุนติ้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho hỏi bạn học trường nào?\nSao tốt nghiệp xuất sắc môn đẹp vậy?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošli mi číslo. Ne to telefonní,\nto ty jsi moje jednička."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er én ting, jeg aldrig bliver træt af,\nog det er dig. Fuld tank."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχω ένα πρόβλημα:\nτα επίθετα τελειώνουν όταν σκέφτομαι εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysyin, mikä kaupan paras tuote on,\nja myyjä osoitti: sinä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku punya kebiasaan buruk:\nnyari kamu tiap buka layar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem janteloven i dag.\nI dag får du lov til å være best."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn hart heeft maar één brandstof:\ndat ben jij, en de tank is altijd vol."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno paliwo mnie napędza:\nty, na sto procent."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du en laddstolpe? Med dig\nnår jag hundra procent."
          }
        }
      }
    },
    "quote.168" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 때문에 비가 올 것 같아.\n심장마비."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I think it is going to rain,\nbecause you are a total storm of cute."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you walk in,\nmy heart goes bong, like Big Ben."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是不是奶茶成精了？\n不然我怎么对你上瘾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是 Wi-Fi 嗎？\n我一靠近就瞬間滿格。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのせいで雨が降りそう。\nだって胸がざわざわしてるから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синоптики предупредили о шторме\nвосторга: ты выходишь на улицу!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perdona, se te ha caído algo:\nmi mandíbula al verte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du keine Mutter?\nSo ein Aussehen ist nicht von dieser Welt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On t'appelle comment ? Soleil ?\nParce que dès que tu arrives, ça brille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho cercato \"fascino\" nel dizionario:\nc'era una foto. Eri tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Será que você é Wi-Fi?\nPorque senti conexão na hora."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันสอบตกวิชาลืมคุณ\nได้เกรดเอฟทุกเทอมเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có phải bạn là Wi-Fi không?\nVì em thấy kết nối liền tay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určitě nejsi z nebe? Když ty\nvypadáš jak anděl bez práce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er det tordenvejr? Nej, det er\nbare mit hjerte, der brager for dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ήλιος παραιτήθηκε·\nεσύ κάνεις καλύτερα τη δουλειά"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehu kehuu kehua, mutta sinä\nolet koko kehuoppikirja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kok hujan deras, ya?\nTernyata hatiku kebanjiran gara-gara kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fredagstaco i menneskeform,\nsånn er du. Alle gleder seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg, jij zorgt voor een regenbui:\nmijn hart loopt over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy tobie serce bije jak burza,\na ty to zjawisko naturalne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det åskar i hjärtat så fort du\ndyker upp. Men vädret är fint."
          }
        }
      }
    },
    "quote.169" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "혹시 종교 있으세요?\n뭘 믿고 그렇게 예뻐요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a religion?\nBecause you look like a miracle."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roses are red, violets are blue,\nI forgot the rest, I'm gawping at you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请问是Wi-Fi吗？\n我一靠近你就满格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你有地圖嗎？\n我每次看你都會迷路。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もしかして信じる神様がいるの?\nその美しさ、ご利益ありすぎ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во что я верю? В чудеса —\nведь рядом ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No eres de este mundo.\nVienes de uno mejor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kam nur zum Wasserholen.\nJetzt hat mich dein Lächeln erwischt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis, tu crois au coup de foudre ?\nParce que là, je viens de prendre une décharge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non credevo ai miracoli.\nOra guardo te e il miracolo sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu sorriso devia pagar imposto,\nde tão valioso."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณชื่อเสิร์ชเอนจินหรือเปล่า\nเพราะมีทุกสิ่งที่ฉันตามหา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có phải bạn là đường không?\nSao nhìn là thấy ngọt rồi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svátek máš dneska ty,\na zítra taky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad er din hemmelighed? Hvad tror du på,\nsiden du ser så godt ud?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GPS λέει «έχετε φτάσει»\nκάθε φορά που σε βλέπω"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uskotko taikuuteen? Siitä viis,\nkoska sinä olet elävä todiste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti kamu lulusan sekolah sihir,\nsoalnya aku langsung terpesona."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvem trenger brunost når\ndu er det søteste på brødskiva?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb jij een geloof?\nWaarom ben je anders zo hemels mooi?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W co ty wierzysz,\nże wyglądasz tak dobrze?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tror du på ödet? För du är\nbevis nog för mig."
          }
        }
      }
    },
    "quote.170" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "다 좋은데 뭔가 허전하지 않아?\n명불허전."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is great, but something seems missing.\nOh wait, it was you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a queue? I would happily\nwait ages for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的手机没电了，\n但你一出现我就满血复活。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏值高成這樣，\n你讓我的眼睛每天都在追劇。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこも文句ないのに、なんか足りない?\nいいえ、「名に恥じない」美しさです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вроде всё есть, а чего-то не\nхватает? Нет, просто ты — комплект."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sonrisa tiene más «me gusta»\nque toda mi vida junta, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irgendwas fehlt? Ach nein,\nes ist einfach alles da, wie bei dir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je cherchais un défaut chez toi... j'ai trouvé :\ntu es trop adorable, c'est tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi mancava qualcosa, poi\nho capito: mancavi tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pernas pra que te quero?\nSó pra chegar até você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอไวไฟหน่อยนะ\nใจฉันเชื่อมต่อกับคุณแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có phải bạn là cà phê không?\nVì thấy bạn là em tỉnh cả người."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi ukazuje plný signál,\nale ty jsi lepší připojení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er der noget, der mangler? Nej, du\nlever op til alle forventninger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τόση λάμψη, και δεν σε πληρώνει\nη εταιρεία ρεύματος;"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki on kunnossa, mutta mitä puuttuu?\nEi mitään, sinä olet täysi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katanya nggak ada gading yang tak retak,\nkamu pengecualian, mulus banget."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speilet ber om autograf\nfordi du er så fin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles is top, maar mist er niet iets?\nOh ja, jij die voor altijd blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje czegoś? Nie, ty to\nkompletny zestaw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alltför bra för att vara sant?\nDå är du nog en bugg i verkligheten."
          }
        }
      }
    },
    "quote.171" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그 짐좀 내려놔요.\n멋짐."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can you put that charm down for a second?\nSome of us need to function."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a \"kettle just boiled\",\nyou are pure joy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我的人形充电宝，\n看一眼就满电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "難道你學過魔法？\n不然我怎麼被你定住了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "荷物は置いておこうよ。\nあなたはもう「かっこいい」を背負ってる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяжело нести такую красоту?\nПоставь, поможем: ты — наше всё."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Llevas mapa? Es que\nme pierdo en tu mirada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hab dein Gesicht gegoogelt.\nDas Internet bekam nur Herzaugen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y a-t-il un ange dans la pièce ?\nAh non, c'est juste que tu viens d'entrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un asso nella manica?\nNo: l'asso e la manica sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa do tesouro? Achei.\nO X marca onde você está."

            "state" : "translated",
            "value" : "Selv ved lysets slukning ser du\nud, som om du har et filter på."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευχαριστώ, γιατί σήμερα\nεσύ έκανες τον κόσμο πιο όμορφο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilta on jo täällä, mutta sinä\nkiiltelet yhä kuin aamulla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udah malam, tapi kamu masih bersinar.\nKok bisa secakep itu seharian?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsatt like fin på kvelden.\nHvordan får du det til?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is al avond en jij glanst nog.\nHoe doe je dat toch?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieczór, a ty ciągle jak z okładki.\nJak ty to robisz?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är kväll och du glänser ändå.\nHur orkar du vara så fin?"
          }
        }
      }
    },
    "quote.021" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하루 종일 수고했어요.\n당신이라서 다행이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for all that hard work.\nLucky me, I know you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheers for the long day.\nGlad it was you doing it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙了一整天，\n能遇见你真是太好了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙了一整天，\n有你這個人真是太好了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ずっとお疲れさま。\nあなたがあなたでよかった。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если бы вечер выбирал\nлюбимчика, это был бы ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por el día, tú:\nsin ti habría sido uno cualquiera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für heute.\nGut, dass es dich gibt, du Schatz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci pour tout ce que tu as fait.\nHeureusement que c'est toi !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per la giornata.\nIl bello è che c'eri tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boa noite pro mundo, e pra você\nmeus parabéns pelo dia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สู้มาทั้งวัน เก่งมากนะ\nมีคุณอยู่ ฉันสบายใจ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy deadline cả ngày mà bạn\nvẫn dễ thương, sao được vậy?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolik práce, a ty se ještě\nusmíváš? To je nadpozemské."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak for i dag! Verden er\nbedre, fordi du er i den."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κόσμος ήταν σήμερα υπέροχος\nγιατί ήσουν εσύ εκεί"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiitos päivästä, sinä sinnikäs!\nNyt on sohvan vuoro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makasih udah berjuang seharian.\nSyukurlah ada kamu di dunia ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk for i dag. Verden trenger\nat du fortsetter å være deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedankt voor je inzet vandaag.\nGelukkig bestaat er maar één jij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobranoc, ty promyczku.\nJutro znowu świecimy!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tack för idag, du.\nVärlden hade varit blekare utan dig."
          }
        }
      }
    },
    "quote.022" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 당신 덕분에\n세상이 아름다웠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole world looked nicer today\nbecause you were in it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks to you,\nthe world looked lovely today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的世界这么美，\n多亏有你在其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天也多虧有你，\n世界才沒那麼無聊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の世界がきれいだったのは\nあなたがそこにいたからです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо тебе за этот день:\nты — его лучшая часть."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy el mundo fue más bonito\nporque estabas tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dank dir war die Welt heute\nein Stück schöner, du Sonnenschein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci : grâce à toi, le monde a été\nplus beau aujourd'hui, tu sais ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mondo oggi era più bello:\nc'eri tu e si vedeva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lua tá linda hoje,\nmas você tá de outro nível."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โลกวันนี้สวยขึ้นเยอะ\nก็เพราะมีคุณนั่นแหละ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhờ có bạn mà hôm nay\nthế giới đẹp hơn hẳn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrou noc, ty hvězdo.\nZítřek už se na tebe těší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I aften lyser byen op,\nmen ikke så meget som du."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νύχτα ή μέρα,\nεσύ είσαι θρύλος και στις δύο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maailma oli tänään vähän parempi,\nkoska sinä kuljit siinä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berkat kamu, dunia hari ini\nkelihatan lebih indah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verden ble litt finere i dag\nfordi du var i den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door alles wat jij doet\nwas de wereld vandaag weer mooier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świat dzisiaj jaśniał,\ni wiemy, kto za to odpowiada: ty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Världen blev finare idag,\nvilket beror på att du fanns."
          }
        }
      }
    },
    "quote.023" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "밤에 봐도 레전드,\n낮에 봐도 레전드."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legend at night,\nlegend in daylight. Never a dull you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legend by night, legend by day,\nand you never even clock off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白天看你是传奇，\n晚上看你还是传奇。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白天看是傳說，\n晚上看還是傳說。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜に見ても伝説、\n昼に見ても伝説。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключаем свет, но ты\nвсё равно подсвечиваешь ночь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De día, leyenda. De noche,\nleyenda. Siempre tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts eine Legende,\ntagsüber eine Legende: du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir, légende. Le matin, légende.\nOn ne change pas une équipe qui gagne !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di giorno sei un mito,\ndi notte pure. Sì, proprio tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dia ruim ou dia bom, o saldo\nfinal é que você é demais."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลางคืนก็ปัง กลางวันก็ปัง\nคุณคือตำนาน 24 ชั่วโมง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đêm nhìn cũng huyền thoại,\nngày nhìn cũng huyền thoại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den končí, ale ty zůstáváš\nnejvětší hit večera."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både om dagen og om natten\ner du en levende legende."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δύσκολη μέρα; Κι όμως\nεσύ τα πας καλύτερα απ' ό,τι νομίζεις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöllä legenda, päivällä legenda.\nVuorokausitaukoa ei sinulle ole."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siang kamu legenda,\nmalam pun kamu tetap legenda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legende om dagen,\nlegende om natten. Aldri fri, du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het donker een legende,\nin het licht ook. Typisch jij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legenda w dzień, legenda w nocy,\nty zawsze na posterunku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På natten är du legend.\nPå dagen är du också legend."
          }
        }
      }
    },
    "quote.024" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "괜찮아요, 힘든 날도 있는 거예요.\n당신은 충분히 잘하고 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is okay, rough days happen.\nYou are doing better than you think."
          }

    "quote.211" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "최애 바꿔야겠어요.\n당신 외에는 못 보겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

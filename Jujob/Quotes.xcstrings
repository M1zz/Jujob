        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet w autobusie świecisz jak reflektor,\nty to zjawisko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser du upp bussen också?\nVem är fotografen?"
          }
        }
      }
    },
    "quote.078" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",

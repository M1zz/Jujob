    "quote.068" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "운동할 때도 빛나는 당신,\n어떻게 항상 그렇게 멋져요?"

    "quote.132" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 노력하는 모습,\n누군가에겐 동기부여예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watching you try hard\nmotivates a lot of people, you know."

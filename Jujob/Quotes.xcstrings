      }
    },
    "quote.076" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "출근길 당신 때문에\n지하철이 런웨이가 됐어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The subway became a runway\nthe moment you stepped on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you on board,\nthe Tube has become a catwalk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

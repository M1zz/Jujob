      }
    },
    "quote.043" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "이 힘든 순간도\n곧 추억이 될 거예요!"
          }

          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Večerní ty je tak krásné,\nže si zaslouží vlastní hymnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjernerne tænder for dig i aften,\nfor du skinner allerede."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαν τα άστρα στον ουρανό\nλάμπεις κι εσύ απόψε"

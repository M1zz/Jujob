    "quote.148" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 매력을 모르는 사람은\n눈이 없는 거예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who cannot see how charming you are\nneeds new glasses."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who can't see you\nis in need of an eye test."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不懂你魅力的人，\n一定是没带眼睛。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不懂你魅力的人，\n大概是眼睛忘了帶。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの魅力に気づけない人は\n目がついてないのかも。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня можно ничего не делать:\nты — не робот-исполнитель."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien no ve tu encanto\nes que no tiene ojos, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer den Charme von dir nicht sieht,\nträgt wohl keine Brille, du Sonnenschein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux qui ne voient pas ton charme\nont besoin de lunettes, et tu n'y es pour rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se qualcuno non vede quanto brilli tu,\nè ora che compri gli occhiali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem não vê seu valor\nprecisa trocar de óculos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครไม่เห็นเสน่ห์ของคุณ\nตาบอดสีแล้วล่ะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai không thấy sức hút của bạn\nchắc cần đi khám mắt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo nevidí, jak ty kouzlíš,\nasi nosí zamlžené brýle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folk, der ikke ser din charme,\nmå have glemt deres briller."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σήμερα απλώς\nχαλάρωσε, εσύ το αξίζεις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka ei huomaa viehätystäsi,\nei ole katsonut, sillä sinä loistat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yang nggak sadar pesona kamu\nmungkin matanya lagi libur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser noen ikke at du er sjarmerende,\nmå de ha mistet synet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie niet ziet wat jij uitstraalt,\nheeft blinde ogen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto nie docenia ciebie,\nten zgubił okulary. A ty dalej lśnisz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som inte ser din charm behöver\nglasögon. Så grym som du är!"
          }
        }
      }
    },
    "quote.149" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",

    "quote.077" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "버스 안에서도 빛나는 당신,\n오늘도 화보 찍나요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowing on the bus again?\nIs there a shoot, you gorgeous thing?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shining on the bus too.\nAre you doing a photoshoot?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挤公交也这么耀眼，\n你今天又要拍大片吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公車上都能發光的你，\n今天也要拍封面嗎？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バスの中でも輝くなんて、\nまた撮影ですか?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже в автобусе ты выглядишь\nкак с обложки. Отдыхайте, модели."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta en el autobús brillas, tú.\n¿Hoy toca sesión de fotos?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst im Bus eine Wucht.\nGibt's heute ein Fotoshooting für dich, du Star?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même dans le bus, tu resplendis.\nUne séance photo avant le terminus ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull'autobus brilli.\nStai facendo un servizio fotografico, tu?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fone no ouvido e você\ndesfilando na calçada: cinema."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นั่งรถเมล์ก็ยังเปล่งประกาย\nวันนี้คุณถ่ายแฟชั่นเหรอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngồi trên xe mà bạn vẫn sáng,\nhôm nay chụp ảnh bìa hả?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V autobuse svítíš. Natáčí se tu\nněco, nebo jsi to ty?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv i bussen skinner du,\nså er der fotoshoot i dag?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στον δρόμο σε βλέπω να λάμπεις\nκαι εσύ μου φτιάχνεις το πρωί"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bussin ikkunassa kiiltää taas yksi\ntähti, ja se olet sinä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di dalam bus pun kamu bersinar,\nmau pemotretan lagi?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv i trikken lyser du.\nEr det fotoshoot i dag?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de bus stralen? Zeker, want jij\nziet eruit als een covermodel."

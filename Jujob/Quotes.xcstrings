        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В зале славы моего сердца\nпервая табличка — ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi salón de la fama\ntiene un solo nombre: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In meinem Herzen steht dein Name\nganz oben in der Ruhmeshalle, du Legende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis que tu as débarqué, ma vie\na pris un joli virage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel mio pantheon personale\nil primo posto d'onore sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hall da fama, vaga número um:\nreservada pra você, claro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในหอเกียรติยศของใจฉัน\nคุณคือคนแรกเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gió có thổi bay cả mây,\ncũng không bay nổi sức hút của bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síň slávy v mém srdci má\njediného člena: ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hos mig sidder du på æresplads\ni hjertets hall of fame."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χάρη στο χαμόγελό σου\nεσύ έκανες τη ζωή μου έγχρωμη"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunniatauluni ensimmäinen nimi on\nsinä, ja loput ovat tyhjiä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aula kehormatan hatiku\nbaru diisi satu orang: kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siden du kom\ner livet i full farge."

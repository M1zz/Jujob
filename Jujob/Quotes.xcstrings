    },
    "quote.042" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 생각보다\n훨씬 더 많이 견딜 수 있어요!"

          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje minut med dig är guldkant. Det\när min bästa tid, det vet du."
          }
        }
      }
    },
    "quote.220" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "생일 광고 할게요.\n매일이 당신 생일이었으면 좋겠어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will buy a birthday billboard.\nI wish every day were a birthday for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day should be a\nbirthday for you, with cake."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给你投个生日广告，\n真希望天天都是你的生日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要買生日應援廣告，\n希望天天都是你的生日。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日広告を出しますね。\n毎日あなたの誕生日だったらいいのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хочу, чтобы каждый день был\nтвоим днём рождения: ты — повод."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te aplaudiré siempre.\nSer tu fan es mi orgullo, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt ist Schwärmzeit!\nJede Minute mit dir ist pures Gold, du Schatz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je loue un panneau pub pour toi :\nque chaque jour soit celui où tu fêtes ton anniversaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pago un cartellone in piazza:\nogni giorno dovrebbe essere festa, perché ci sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiz fila pra ver você.\nValeu cada minuto, hein!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอทำป้ายโฆษณาวันเกิด\nอยากให้ทุกวันเป็นวันเกิดคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần bạn gửi tin nhắn,\nem đã vui cả tuần rồi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslava narozenin? Klidně každý den,\nty si ji zasloužíš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gid hver dag var din fødselsdag,\nså kunne jeg synge for dig hver gang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για την ιστορία:\nεσύ είσαι ο λόγος που ο κόσμος αξίζει"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuen sinua elämän loppuun asti,\nja sinä olet fanikuntani ylpeys."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku mau pasang iklan ulang tahun.\nAndai tiap hari ultahnya kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg heier på deg for alltid.\nStolt over at du har meg som fan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik plaats een verjaardagsadvertentie.\nWat als jij elke dag jarig was?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billboard urodzinowy dla ciebie?\nBiorę, bo ty świętujesz codziennie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag hyr en stor skylt på stan: varje\ndag borde vara din födelsedag, du."
          }
        }
      }
    },
    "quote.221" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "평생 응원합니다.\n당신의 팬이라는 게 자랑스러워요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheering for you for life.\nBeing a fan is my proudest thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being a fan of you\nis the proudest thing I do."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

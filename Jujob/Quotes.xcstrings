        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute siehst du so gut aus,\nich verliebe mich fast, du Schöner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En te voyant ce soir, quelqu'un\nva tomber amoureux, tu verras."

    },
    "quote.141" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 생각보다\n훨씬 강해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surprise: you are\nmuch stronger than you think!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are\nmuch stronger than you think!"
          }
        }

    "quote.109" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 스펙이 화려한 게 아니라\n당신 자체가 화려해요."

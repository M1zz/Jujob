    },
    "quote.053" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "파이팅! 오늘도\n당신답게 해내봐요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go get it! Do it\nthe way only you can!"

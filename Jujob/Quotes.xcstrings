        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sydämeni hakkaa, kun sinä\nkäännät katseen minuun."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fans seumur hidup nih.\nBangga banget jadi penggemar kamu."

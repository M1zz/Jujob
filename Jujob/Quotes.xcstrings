        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dir steckt mehr Ausdauer,\nals du je gedacht hättest, du Marathon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux encaisser bien plus\nque tu ne l'imagines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai quanto puoi reggere?\nPiù di quanto immagini tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode apostar que você aguenta\nmuito mais do que acha que aguenta."

    "quote.086" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "퇴근하는 당신,\n오늘도 고생 많았어요. 수고했어요!"

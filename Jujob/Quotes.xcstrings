        }
      }
    },
    "quote.106" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 이야기를\n당당하게 들려주세요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell them the story of you\nwith pride!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the story of you\nwith pride!"
          }
        },
        "zh-Hans" : {

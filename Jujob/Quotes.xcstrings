    "quote.055" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일하기 싫다고요?\n그래도 당신 얼굴은 열일 중이에요."

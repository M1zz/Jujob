            "value" : "自分の体のことは\n自分がいちばんよく知っています。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый подход — повод для\nгордости: ты — сила."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie conoce tu cuerpo\ncomo lo conoces tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand kennt deinen Körper so gut\nwie du. Vertrau ihm!"

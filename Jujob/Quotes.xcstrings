        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegen dir kann ich auch heute\nwieder lächeln, du Sonnenschein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n'est plus précieux que toi,\net tu le sais bien, avoue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

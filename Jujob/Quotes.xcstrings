            "value" : "I am a fan for life.\nFact: you are my forever artist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My favourite hobby:\nlooking at you. Cheap, too!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我要当你的终身粉丝，\n你是我永远的偶像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我決定當一輩子的粉絲，\n你是我永遠的偶像。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一生ファンでいます。\nあなたは私の永遠のアーティスト。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буду вечным фанатом: ты\nдля меня — главный артист."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya he elegido bando:\nel tuyo. Mi equipo eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Liebling ist dir bekannt?\nGenau, das bist du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan à vie, c'est décidé :\nje te suivrai partout, tu es mon artiste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faccio il tifo a vita:\nho un solo idolo, e sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapete vermelho pra quê?\nJá que você chega brilhando."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอเป็นแฟนคลับตลอดชีวิต\nคุณคือศิลปินตลอดกาลของฉัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp hình xin phép trước nhé,\nvì bạn đẹp quá đà."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fandím ti navždy, protože ty\njsi můj nejlepší důvod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg bliver fan resten af livet,\nfor du er min evige stjerne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με το που σε βλέπω\nεσύ μου φτιάχνεις το χαμόγελο"

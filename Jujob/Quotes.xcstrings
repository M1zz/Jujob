        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich buche Werbung zum Geburtstag.\nAm liebsten wäre jeder Tag deiner, du Schatz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je te soutiens pour la vie :\nje suis fier que tu aies un fan-club."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tifo per te per sempre.\nChe orgoglio essere fan di quello che sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troféu de melhor sorriso:\nvai pra você, sem votação."

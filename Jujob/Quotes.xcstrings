        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobra robota dziś, ty ikono!\nWracaj do domu i odpoczywaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bra jobbat idag!\nNu hem och vila, du."

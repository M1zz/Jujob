        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzień dobry to za mało,\nty zasługujesz na dzień genialny!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God morgon? Nej, du gör det\ntill en toppenmorgon!"

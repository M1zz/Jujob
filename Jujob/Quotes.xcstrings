        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciężko? Wiem. Ale ty\nbłyszczysz mimo wszystko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är tungt, men du lyser.\nDiamanter måste också slipas."
          }
        }
      }
    },
    "quote.045" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금 힘들다고요?\n그래도 당신은 세상에서 제일 예뻐요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Having a rough time?\nStill, you are the best-looking thing in the room."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Having a hard time? Still,\nyou are the best-looking one around."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觉得很难？没事，\n你依然是我心中的顶配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說現在很糟？\n可是你糟得很好看欸。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つらいって? それでも\nあなたは世界一かわいい。"
          }
        },
        "ru" : {
          "stringUnit" : {

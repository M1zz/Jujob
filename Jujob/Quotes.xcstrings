    },
    "quote.142" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 개성이\n당신을 빛나게 해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What makes you\nunique is what makes you shine!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What makes you different\nis what makes you shine!"
          }
        }
      }
    },
    "quote.143" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자신을 믿어요.\n당신은 할 수 있어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Believe in you. I do,\nbecause you are the real deal!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Believe in you,\nbecause you can do it!"
          }
        }
      }
    },
    "quote.144" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 그 자체로\n완벽한 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are\nperfect just as you are."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are\nperfect as you are."
          }
        }
      }
    },
    "quote.145" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "자신감 넘치는 당신,\n세상에서 제일 멋져요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All that confidence?\nHonestly, you look incredible in it!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brimming with confidence,\nyou are the best around!"

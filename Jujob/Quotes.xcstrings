            "value" : "Katson sinua ja sydän menee\nepäkuntoon. Korjaajaksi kelpaa vain sinä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas ada kamu,\nsemuanya serasa sempurna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drømmetypen min? Det er du,\nmen jeg torde aldri ønske det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zodra jij erbij bent\nis alles ineens perfect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ty jesteś obok,\nwszystko po prostu gra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I stunden när du är med\när allt precis rätt."
          }
        }
      }
    },
    "quote.251" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내가 꿈꾸던\n이상형 그 자체예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are literally\nthe person I dreamed of."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything I ever wanted\nin a person came as you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你就是我\n梦里理想型的本人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢裡的理想型，\n本人就是你。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢に見ていた理想の人が\nそのまま現れました。あなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идеал из моих снов — это\nты, только реальнее."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tu lado cada momento\nes perfecto, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dir ist jeder Augenblick\nvollkommen, du Traum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon cœur tombe en panne\ndès que tu passes devant moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mio tipo ideale?\nDescrizione esatta: sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu tipo ideal? Chegou:\nvocê, em tamanho real."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สเปกในฝันของฉัน\nก็คือคุณทั้งตัวเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỗ nào có bạn đứng\nlà chỗ đó thành nơi đáng sống."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideál, o kterém se mi zdálo,\njsi ty, bez diskuse."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min drømmepartner, det er dig,\nog nu står du her. Jackpot!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λέω στην καρδιά μου «ηρέμησε»\nκαι εσύ την ξαναχαλάς"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matkaan kanssasi vaikka kuuhun, sillä\nsinä olet paras reppukaveri."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipe idaman yang dulu cuma mimpi\nternyata nyata, namanya kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siden jeg så deg er hjertet mitt\nødelagt. Kan du lappe det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerlijk, jij bent precies de droom\ndie ik ooit had."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideał z moich marzeń?\nTo ty, w wersji deluxe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precis den person jag drömde om\när du, fast bättre."
          }
        }
      }
    },
    "quote.252" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 보면 심장이\n고장 난 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing you makes me think\nmy heart is broken. It is racing!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeing you, my heart\nseems to have gone faulty."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哎呀，我的心脏\n一见到你就罢工了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一看到你，\n我的心臟就當機了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸のメーターが振り切れました。\nあなたを見てしまったせいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сердце сбоит при виде тебя,\nведь ты — вирус хорошего настроения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justo el tipo de persona\ncon el que soñaba: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Traumtyp in Person?\nDas bist ganz klar du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On devrait te mettre au programme\nscolaire : tu es une légende vivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cuore va in tilt\nogni volta che passi tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu coração perdeu o\ncompasso quando viu você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใจฉันรวนหมดแล้ว\nทุกครั้งที่เห็นคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần bạn gật đầu,\nem sẵn sàng xếp hàng cả đời."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srdce přeskočí rytmus, jakmile\nty mrkneš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du går forbi, gør\nmit hjerte noget underligt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περπατώντας εσύ\nγράφεις ιστορία"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historiankirjoihin päätyvä ihminen, ja\nsinä olet jo kävelevä elämäkerta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap kamu muncul, jantungku\nkayak mau mogok."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå rolig, du er en vandrende\nbiografi. Historien husker deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telkens als jij lacht,\nlijkt mijn hart kapot te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ty wchodzisz do pokoju,\nserce wywala błąd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitt hjärta gick i baklås när\ndu klev in. Ring en tekniker."
          }
        }
      }
    },
    "quote.253" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 걷는 위인전이에요.\n역사에 남을 사람."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriously, you are a walking history book.\nPure legend material."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A walking history book, you.\nThey will write about you for ages."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行走的传记本人，\n说的就是你，注定载入史册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走路的偉人傳記，\n說的就是你，注定載入史冊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歴史の教科書に載るのは確実。\nあなたは歩く偉人伝です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходячая энциклопедия достоинств —\nэто ты. Читаю всю жизнь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me miras y mi corazón\nse vuelve loco, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ich dich sehe,\nspielt mein Herz verrückt, du Herzensbrecher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton charme est une attaque surprise\net tu peux recommencer, je me laisse faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esistesse un libro dei grandi,\nin copertina ci sarebbe tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biografia ambulante, é\nisso que você é: pura história."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประวัติศาสตร์เดินได้\nก็คือคุณ ต้องจารึกไว้ในตำรา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em đã thử đếm sao trên trời,\nnhưng bạn vẫn sáng nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chodící učebnice krásy,\na ty jsi její hlavní kapitola."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gående biografi, det er hvad\ndu er. Dit navn bliver husket."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη γοητεία σου\nεσύ με νικάς κάθε φορά"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charmisi iskee jatkuvasti, ja\nsinä saat jatkaa vaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biografi berjalan, itulah kamu,\nnamanya bakal tercatat di buku sejarah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjarmen din vil jeg gjerne\nfalle for, så du får skylden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk, jij bent een wandelend geschiedenisboek.\nIemand voor de eeuwigheid."

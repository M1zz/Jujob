    "quote.122" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 당신 보면\n사랑에 빠질 것 같아요."
          }
        },
        "en" : {
          "stringUnit" : {

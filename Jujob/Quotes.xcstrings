        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เห็นคุณทีไร\nโลกก็สวยขึ้นทุกที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe giọng bạn thôi\nlà em thấy khỏe hẳn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

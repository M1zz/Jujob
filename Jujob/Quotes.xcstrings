          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohovor je jen rozhovor.\nKdyž ty mluvíš, svět poslouchá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En samtale er bare en snak,\nså tag den roligt og vær dig selv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεν σε προσλάβουν,\nχάνουν εκείνοι, όχι εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haastattelu on keskustelu, ja\nsinä olet siinä luonteva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wawancara itu saling kenalan,\njadi santai aja ya!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et intervju er en samtale.\nSlapp av, så er du deg selv."

    "quote.158" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘은 당신을 위해\n시간을 써도 괜찮아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spend some time on you today.\nNo guilt allowed!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today, spending time on\nyou is perfectly alright."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天为自己花点时间，\n你完全担得起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天為你自己花點時間，\n完全沒有問題喔。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は自分のために\n時間を使っても大丈夫。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже в режиме «ничего» ты\nсияешь на полную."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicarte un rato está más\nque bien, y lo mereces tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist völlig okay,\nZeit für dich zu nehmen, du Schatz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce temps que tu t'offres aujourd'hui,\nil est mérité, ne t'excuse pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendersi del tempo va bene.\nIl mondo aspetta, tu no."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo em modo soneca,\nvocê continua incrível."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะใช้เวลากับตัวเองก็ได้\nไม่มีใครว่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dành thời gian cho bạn\ncũng chẳng sao đâu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas pro sebe? Klidně, ty\nsi ho můžeš dát hned."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er helt okay, at du\nbruger tid på dig selv i dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκουράζεσαι και πάλι\nεσύ λάμπεις, δεν γίνεται αλλιώς"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota aikaa itsellesi, sillä\nsinä olet sen ansainnut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini nggak apa-apa\npakai waktu buat kamu sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag kan du godt bruke\ndagen på deg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag mag jij\neens aan jezelf denken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś dogadzaj sobie,\nbo ty to numer jeden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg tid på dig själv, du.\nUtan att skämmas."
          }
        }
      }
    },
    "quote.159" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "편하게 쉬면서도\n당신은 빛나요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even while lounging,\nyou glow like a star."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even mid-chill,\nyou manage to shine."

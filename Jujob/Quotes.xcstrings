    "quote.121" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데이트 룩 완벽해요.\n화보 찍어도 되겠는데?"

        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "憑你的熱情，\n今天一定會被點亮的！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "燃えるあなたの情熱が\n今日をぴかぴかにします!"

            "value" : "Add you to an ordinary\nTuesday and it is a celebration."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇见你之后，\n日子都变得与众不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多虧有你，\n今天變得好不一樣。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日がとっておきになる、\nあなたの魔法のせいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День превращается в праздник —\nэто магия, имя которой ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ti la vida\ntiene otro color, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Herz hat einen Ehrenplatz.\nDer gehört nur dir, du Ehrengast."
          }
        }
      }
    },
    "quote.275" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n히든 카드예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you are the ace\nup my sleeve."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My secret weapon in life\nis simply you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生的隐藏款惊喜，\n竟然是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我人生裡\n那張王牌。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人生の切り札を探したら\nあなたがそこにいました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Козырь в моём рукаве —\nэто ты. Лучше джокера."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi evento principal\ndel año eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ass im Ärmel meines Lebens?\nDas bist du."
          }
        }
      }
    },
    "quote.276" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 생각하면\n기분이 업그레이드돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just thinking of you\nupgrades my whole mood."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just thinking of you\nupgrades my mood."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想起你，\n心情就自动升级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想著你，\n心情就自動升級。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分が全部アップグレード。\nあなたを思い浮かべただけで。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроение растёт до максимума,\nстоит увидеть, что ты онлайн."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi nivel de felicidad\nsube cuando apareces, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allein ein Gedanke an dich\nhebt meine Laune, du Gute-Laune-Quelle."
          }
        }
      }
    },
    "quote.277" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음속\n명예의 전당 1호예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real talk: you are the first one\nin my hall of fame."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My hall of fame has\none inductee: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的人生滤镜，\n全是你送的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在我心中，\n是名人堂的第一號。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心の殿堂入り第一号は\nあなたです。異論は認めません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В зале славы моего сердца\nпервая табличка — ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi salón de la fama\ntiene un solo nombre: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In meinem Herzen steht dein Name\nganz oben in der Ruhmeshalle, du Legende."
          }
        }
      }
    },
    "quote.278" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신 덕분에\n인생이 풀컬러예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks to you,\nlife is in full color."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks to you, life is\nin full colour now."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永恒经典这个词，\n我只想送给你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多虧有你，\n我的人生是全彩的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白黒だった毎日が\nあなたのおかげでフルカラーです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жизнь расцвела всеми красками:\nэто ты, цветной фильтр судьбы."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que estás tú\nla vida va a todo color."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dank dir ist mein Leben\nfarbenfroh und bunt, du Regenbogen."
          }
        }
      }
    },
    "quote.279" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 눈의\n올타임 레전드예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No doubt, you are the all-time\nlegend of my eyes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The all-time great in my eyes?\nWell, it is you, obviously."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间遇上你，\n都舍不得走快一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我眼裡，你是\n永遠的傳奇。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目に映る永遠のレジェンド、\nそれがあなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легенда всех времён и народов —\nэто ты. Учебники уже пишутся."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi pase VIP a la felicidad\neres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Allzeit-Hit meines Lebens?\nGanz klar, du."
          }
        }
      }
    },
    "quote.280" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신만 보면\n세상이 슬로우 비디오 같아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whenever I see you,\nit feels like a slow-motion replay."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With you around, even\nslow days feel like a film."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的快乐，\n有一半是你批发的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇見你之後，\n我的人生才開始有配樂。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくり流れる時間さえ、\nあなたがいると宝物になります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как в замедленной съёмке: на\nэкране только ты, и всё прекрасно."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mis ganas de verte\nvan en aumento, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seh ich dich an,\nläuft alles in Zeitlupe, du Zauberer."
          }
        }
      }
    },
    "quote.281" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n프리미엄 패스예요."

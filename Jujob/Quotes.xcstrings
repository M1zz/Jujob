    "quote.063" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "땀 흘리는 당신의 모습,\n정말 아름다워요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

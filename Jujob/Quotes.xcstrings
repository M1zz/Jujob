        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: quem passa perto\nde você sai com o coração acelerado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชื่อ \"ใช่เลย\" ใช่ไหม\nเพราะเจอคุณทีไรก็ใช่ทุกที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chắc bạn học cao thủ từ nhỏ,\nchứ sao xinh đẹp có bằng cấp vậy?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako mapa: ty ukazuješ směr,\nkterým se chci dívat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalaen går kun til 12, så når du\nfår 13, ødelægger du hele systemet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μου έβαλαν πρόστιμο\nγια υπερβολικό θαυμασμό· ευθύνη εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauna lauantaina on ihanaa,\nmutta sinä olet vielä löylyisempi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti kamu kurang tidur ya?\nSoalnya semalaman kamu muter-muter di pikiranku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snøen smelter\nnår du går forbi. Klimakrise?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreek jij geen Frans? Geen probleem,\njij zegt alles al met je ogen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język obcy? Zbędny,\nbo ty to słodkość w każdym języku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga ord behövs, för ditt leende\nfunkar på alla språk, du."
          }
        }
      }
    },
    "quote.175" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 혼혈이라면서?\n한국과 천국."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you part angel?\nBecause you look heaven-sent."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like gravy, you make\neverything better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界上有两种人：\n你，和想成为你的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜市最紅的攤位是你嗎？\n我排了好久，只為了看你一眼。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなた、実は天使と人間のハーフでしょ?\n羽が見えてますよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откуда ты родом? Из рая,\nа в паспорте — просто город."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres tan guay que\nel hielo se pone celoso, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin kein Dichter,\naber wegen dir fällt mir Lyrik ein, du Muse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélange de charme et de classe : tu es\nun cocktail à consommer sans modération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come l'espresso: corto e intenso.\nIl mio risveglio quotidiano sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá com febre? Não, é\nsó o efeito que você causa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณ + ฉัน = เรา\nสมการนี้ฉันตอบถูกแน่นอน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần thấy bạn là em\ntưởng mình trúng độc đắc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukr ti uhne z dráhy,\nprotože ty jsi sladší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du halvt dansk, halvt engel?\nFor du er altså himmelsk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μοιάζεις με Wi-Fi:\nεσύ μου δίνεις σύνδεση με τη ζωή"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revontulet pyytävät tuuraajaa, kun\nsinä olet paikalla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katanya kamu blasteran?\nBidadari campur surga."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heldige er de som kjenner deg.\nHeldigst er de du snakker med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom jij van een andere planeet?\nZo mooi bestaat niet op aarde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówią, że ty masz korzenie w niebie.\nPolska plus niebo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom du ner från himlen? Då\nvar det en riktigt mjuk landning."
          }
        }
      }
    },
    "quote.176" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "그거 아세요?\n이목구비가 제 미래보다 뚜렷해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you know those features are\nsharper than my future plans?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golden and gorgeous, you are\nthe Yorkshire pudding of people."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "怀疑你是橡皮擦，\n因为你把我的烦恼都擦没了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笑容有多甜？\n你甜到連糖尿病看了都要搬家。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知ってました?\nあなたの目鼻立ち、私の将来よりはっきりしてます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой профиль чётче моих планов\nна будущее, а ты — скульптура."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto pesas? Oro, como mínimo.\nQuilates a tope, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navi aus: Ich verlaufe mich gern\nim Lächeln von dir, du Lieblingsziel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petite info : quand tu souris, tes traits sont\nplus nets que mon avenir. Sans jalousie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con te il tempo vola.\nChi ha messo le ali alle ore? Sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponto turístico? Não, é só\nvocê andando pela rua."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟ้าไม่ได้มีแค่สีฟ้า\nแต่มีสีของคุณด้วย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em xin phép khai báo,\nvì bạn quá đẹp nên em bị loạn nhịp."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krása by měla mít cenu,\nale ty jsi k nezaplacení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør du bare grin? Dine kindben er\nskarpere end min fremtidsplan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο καλύτερος τύπος:\nεσύ + χαμόγελο = ευτυχία"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisua ei tarvita, kun sinä olet\nvalmiiksi liian upea."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tau nggak, garis wajah kamu\nlebih jelas dari masa depanku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv elgen stopper opp og\nklapper når du går forbi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je wat? Jouw gelaatstrekken zijn\nscherper dan mijn toekomst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje rysy są wyraźniejsze\nniż moje plany, ty rzeźbo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din käklinje är skarpare än mina\nframtidsplaner, det vet du."
          }
        }
      }
    },
    "quote.177" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 베를린이야.\n내 마음에 치명적인 독일수도."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are a gift\nthat keeps on giving to my smile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding you is like finding\na tenner in an old coat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在我心里，\n你是永不降价的限量款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是電池嗎？\n不然怎麼一看到你我就充飽電。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベルリンの首都はドイツ。\nでも私の心の首都はあなたです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берлин, Париж, Рим... А ты —\nстолица моего хорошего настроения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanto talento junto\ndebería tributar aparte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei dir geht mir ein Licht auf\nwie im Kühlschrank, du Kühle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour moi, tu es la capitale du cœur :\npas besoin de GPS, j'y vais les yeux fermés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei come il parmigiano:\nogni piatto migliora se ci sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ave Maria! Aí você é uma\nobra-prima sem moldura."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉันไม่ได้เป็นหวัด\nแต่เป็นไข้ใจเพราะคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe đồn bạn là thần đèn,\nvì cứ xuất hiện là ước gì cũng thành."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praha je hezká, ale ty\nji přezáříš i v dešti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle veje fører til dig, så du\nmå være Rom, altså!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο ηλιοβασίλεμα δίνω εννιά·\nεσύ παίρνεις δέκα με τόνο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mökillä on rauhallista, mutta\nsinä tuot sinne kesäyön auringon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibu kota hatiku itu kamu,\nsemua jalan menuju kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenger du en vits?\nNei, du er morsom nok."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even serieus: jij bent Berlijn.\nEen muur van mooi, en ik val erover."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak Kraków, ty też\nzachwycasz od pierwszego wejrzenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huvudstaden i mitt hjärta är du.\nAlla vägar leder dit."
          }
        }
      }
    },
    "quote.178" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 C급이야.\n문화재 제정 시급."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are a landmark.\nSomeone should put up a sign."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So charming are you that\nthe pigeons stop to stare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是I人还是E人？\n不，你是我的C位人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我想辦一張你的會員卡，\n這樣每天都能點你的名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは文化財ですね。\n早く指定しないと国の損失です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Класс А? Нет, ты — класс «люкс».\nОформляйте охранный статус."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fueras un verbo, serías\n«brillar»: siempre en presente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt's bei dir Sternenstaub?\nSo glitzert nur ein Mensch wie du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour moi, tu mérites le classement\nmonument historique. Urgence absolue !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti darei dieci e lode,\nma tu meriti un voto nuovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sorriso fosse moeda,\nvocê já teria banco próprio."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดือนเพ็ญที่ไม่มีวันแรม\nก็คือคุณในใจฉัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu cái đẹp là tội thì bạn\nđã bị tù chung thân rồi đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnotím tě na 10 z 10.\nVlastně ty jsi mimo stupnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der skal fredningsskilt op, for du\ner et levende kulturminde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η καλοσύνη ήταν νόμισμα,\nεσύ θα είχες ήδη τράπεζα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulla pehmeää, kahvi kuumaa,\nmutta sinä olet makeampi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dasar kamu cabai rawit,\nkecil-kecil bikin hatiku kepedasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg har sjekket det nøye:\ndu er 100 prosent topp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als jij een monument was,\nvroeg ik meteen een beschermde status aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasa? Powiedzmy: ty\nto liga mistrzów."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulturminnesmärkt borde du vara.\nAlla måste få se dig."
          }
        }
      }
    },
    "quote.179" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너 잘 때 셋이서 잔다면서?\n칭찬과 명성이 자자해서..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They say you sleep with three pillows?\nWell, that is how fluffy the fan club is."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot, strong, just right:\nyou are my perfect brew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人问我最爱谁，\n我说你，他说我没救了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是溫度計嗎？\n不然我怎麼一看你就發燒。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寝顔まで国宝だって聞きました。\nあなたの噂、町中に広まってます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходят слухи, что ты спишь с\nодеялом и славой на пару."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fueras un restaurante,\nhabría lista de espera de un año, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin kein Mathe-Genie,\naber du addierst dich in mein Herz. Rechenfehler: nie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On dit que, sur ton passage, même les fleurs\nfont la queue pour te saluer, tu savais ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è un concorso di bellezza,\nma se lo fosse, tu avresti già vinto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelas minhas contas, você\ntem 100% de aprovação. As contas são minhas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีแผนที่ไหมคะ\nฉันหลงอยู่ในรอยยิ้มของคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người ta có bản đồ, em có bạn,\nnhìn là biết đúng hướng hạnh phúc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje kouzlo je tak silné,\nže ty ho nemusíš ani zapínat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du en pantflaske? For jeg vil\ngerne have dig tilbage hver gang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην βγεις βόλτα· θα γεμίσει\nο δρόμος θαυμαστές, και εσύ φταις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paljon on kaunista Suomessa,\nmutta sinä olet ihan oma järvensä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katanya kamu jago masak?\nSoalnya hatiku langsung matang gara-gara kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvorfor sliter du? Utseendet ditt\njobber jo overtid for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik hoorde dat jij een lopende lamp bent.\nNu bespaar ik op stroom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podobno ty zasypiasz w otoczeniu komplementów.\nSłusznie!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett A+ får du av mig, och jag\när en hård bedömare."
          }
        }
      }
    },
    "quote.180" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "왜 일하고 있어요?\n이미 미모가 열일하는데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why are you working?\nYour looks already do overtime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a biscuit in tea, you\nmake my heart go dunk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这么忙还这么美，\n是因为你的颜值也在替你上班吧？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為什麼還要上班？\n你的顏值明明已經在加班了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうして働いているんですか?\nもう顔面がフル稼働してるのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зачем ты работаешь? Обаяние\nуже делает всё за тебя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicen que el amor es ciego,\npero le devuelves la vista."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Lieblingszahl lautet eins.\nWer das ist? Schätze, du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi tu travailles ? Ta beauté\nfait déjà des heures sup' pour toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavori ancora? Eppure\ntu hai già il fascino a tempo pieno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntaram quem é o melhor.\nRespondi sem pensar: você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าคุณเป็นข้อสอบ\nฉันยอมสอบซ้ำเป็นร้อยรอบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi nhỏ, bạn có mệt không?\nVì chạy trong đầu em cả ngày."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proč ty pracuješ? Tvoje\nkrása dělá přesčasy za tebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvorfor arbejder du?\nDit udseende har travlt nok."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπήκε το κέφι στο σπίτι\nμε ένα όνομα: εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karjalanpiirakka on kansallisaarre,\nmutta sinä olet vielä suurempi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngapain kerja keras?\nMuka kamu udah lembur duluan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutt å være så fin. «Hvordan?»\nNettopp. Det kan du ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarom werk je nog?\nJe uitstraling doet al alles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po co ty pracujesz?\nUroda już robi nadgodziny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varför jobbar du? Din skönhet\ngör redan övertid."
          }
        }
      }
    },
    "quote.181" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "날 그만 좋아해 \"뭐?\"\n날 그만 좋아하라고\n\"그거 어떻게 하는건데.\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Stop liking me.\" \"What?\"\n\"I said stop.\" \"How do I even do that?\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mind the gap? Not between\nyou and perfection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「你能别这么好看吗？」\n「我也没办法啊。」"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是不是該去看醫生？\n一遇到你，心跳就破表。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「私のこと、好きにならないで」\n「それ、どうやるの?」"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Хватит мне нравиться!»\n«А как?» — вот и ты не знаешь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cara ya es patrimonio\nde la humanidad, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll ich dich fotografieren?\nDann hab ich dich immer dabei, du Motiv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Arrête de me plaire. »\n« Et comment tu veux qu'on fasse, au juste ? »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smettila di essere adorabile!\n\"E come si fa?\"\nAppunto: tu non sai farlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por que trabalhar, se a sua beleza\njá faz hora extra?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอเลิกชอบคุณสักที\nแต่ไม่รู้จะเริ่มยังไงเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm ơn bạn vì đã đẹp,\nđể thế giới này bớt buồn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přestaň mi dělat radost!\nNejde to? Tak ty už zůstaň."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold op med at kunne lide mig, sagde jeg.\n\"Hvordan gør man det?\" sagde du."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κινητό μου έβαλε φίλτρο·\nεσύ δεν χρειάζεσαι κανένα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miksi sinä työskentelet?\nNaamasi tekee jo kaiken työn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Berhenti suka sama aku, dong.\"\n\"Hah?\"\n\"Cara berhentinya gimana?\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjeset ditt burde fredes, for du\ner en nasjonalskatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Stop met zo mooi zijn.\" \"Wat?\"\n\"Stop ermee.\" \"Hoe dan?\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przestań mi się podobać!\n- Ale jak?\n- No właśnie, ty nie umiesz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Sluta vara så fin!\" \"Hur gör\njag det då?\" Det vet du ju inte."
          }
        }
      }
    },
    "quote.182" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "얼굴이 국보급이라\n국립중앙박물관에 전시 예정입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face this rare? Sorry, you\nbelong in a museum."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry, officer, I was staring\nat you, not at the speed limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张脸是国宝级的，\n你已经被预订了博物馆展位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顏值國寶級，\n博物館正在排隊跟你借展。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その顔は国宝級なので\n博物館に展示予定です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицо — достояние республики:\nты уже в планах главного музея."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelen la gala: el premio\ngordo de este año ya tiene dueño: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern Abend träumte ich von dir.\nHeute früh wollte ich nicht aufstehen, du Traum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton visage est un trésor national :\nsi tu veux, on l'expose au musée demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vetrina di museo ti vuole in vetrina:\ntu sei un capolavoro che cammina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizem que a lua é linda,\nmas nunca viram você de perto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าตาระดับสมบัติชาติ\nคุณต้องไปจัดแสดงในพิพิธภัณฑ์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gương mà biết nói chắc cũng\nxin chụp chung với bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do muzea s tím, protože ty\njsi nejkrásnější exponát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit ansigt er så sjældent, at du\nsnart udstilles på Nationalmuseet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ποιος είπε ότι υπάρχει σχέδιο Β;\nΌταν εσύ είσαι το σχέδιο Α"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaalassa ei voi jakaa palkintoja,\nkoska sinä veisit ne kaikki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajah kamu sekelas pusaka,\njadi mau dipajang di museum nasional."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke gå på prisutdelingen,\nfor du tar hovedprisen uansett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gezicht is nationaal erfgoed.\nTentoonstelling in het Rijksmuseum volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taki skarb narodowy jak ty\nmuzeum już szykuje gablotę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museet vill ställa ut dig, så\nvacker är du. Gratis inträde."
          }
        }
      }
    },
    "quote.183" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "시상식 가면 안 되겠어요.\n대상은 당신 얼굴이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not go to the awards show.\nThe grand prize is already you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is it hot in here,\nor is it just you?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颁奖礼你别去了，\n奖杯都被你的颜值吓到了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頒獎典禮你別去，\n不然大獎都被你拿光了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授賞式には出ないでください。\n大賞をぜんぶ持っていくので。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Награды можно не вручать: ты\nвсё равно займёшь все места."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sesión de fotos o es que\ncaminas así por la vida, tú?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Wege führen nach Rom,\nmeiner führt nur zu dir, du Wegweiser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de cérémonie pour toi, c'est inutile :\nle prix de la plus belle frimousse, tu l'as."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che premiazione inutile:\nse ci sei tu, i vincitori sono già noti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você fosse bateria,\nseria 100% e sem descarregar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งานประกาศรางวัลอย่ามานะ\nเพราะรางวัลใหญ่คือหน้าคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên đời có 7 kỳ quan,\ncòn bạn là kỳ quan thứ 8."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny za krásu rozdají v neděli,\nale ty ji už máš doma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliv hjemme fra prisuddelingen,\nfor du tager alle priserne."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το μουσείο θα σε ήθελε έκθεμα·\nεσύ πάντως ήδη είσαι έργο τέχνης"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaaja on pyytänyt tulla uudestaan,\nkoska sinä olet liian hyvä kuva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan ikut ajang penghargaan, ya.\nPiala utamanya jelas buat kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er det fotoshoot?\nEller går du bare sånn til vanlig?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naar de prijsuitreiking? Beter niet,\nwant jij wint de hoofdprijs al."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie chodź na galę nagród,\nbo ty zgarniesz wszystko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå inte på galan. Priset går ändå\ntill ditt ansikte, det vet du."
          }
        }
      }
    },
    "quote.184" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "화보 찍으세요?\n아니면 그냥 걸어다니는 화보예요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you doing a photoshoot,\nor are you just a walking one?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blue plaque for you, and\na parade, I say!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在拍大片吗？\n哦，原来你只是走在路上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是在拍寫真嗎？\n還是你本人就是行走的寫真？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影中ですか?\nそれとも歩く写真集ですか?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это фотосессия или ты\nпросто идёшь по улице?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi artista número uno,\nen bucle en mi cabeza: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht gehört auf ein Plakat.\nAm besten gleich überall, du Werbeträger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance photo en cours ? Ou alors tu fais juste\nune promenade version magazine ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servizio fotografico o passeggiata?\nIn ogni caso tu sei una copertina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabe aquele filme bom\nque a gente quer rever? É você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายแฟชั่นอยู่เหรอ\nหรือคุณแค่เดินมาก็เป็นแฟชั่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần bạn cười lên là toàn khu\nđược mùa luôn đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focení? Pro tebe nic nového,\nty pózuješ i při chůzi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du til fotoshoot, eller går du\nbare rundt som en forside?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βγάζεις φωτογραφία;\nΟ φακός ζητά συγγνώμη, εσύ ήσουν τέλειο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei, et ole mikään idoli, vaan sinä\nolet sydämeni listaykkönen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagi pemotretan, ya?\nAtau memang kamu jalan sambil jadi cover?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popstjerne? Det er du.\nNummer én på hjertets hitliste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoshoot gehad?\nOf loop jij gewoon zo rond?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja zdjęciowa? A może ty\njesteś po prostu chodzącą okładką?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är det fotografering, eller går du\nbara förbi som vanligt?"
          }
        }
      }
    },
    "quote.185" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 아이돌이에요.\n내 심장의 1위 아티스트."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are an idol,\nthe number one star in my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put you on a postage stamp:\nsmall, perfect, and sent with love."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你是我心里的顶流，\n播放量永远第一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說真的，你根本是偶像，\n我心中永遠的第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたはアイドルです。\n私の心のセンターは、いつもあなた。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В моём сердечном хит-параде ты\nуже год на первой строчке."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiero tu autógrafo\ntodos los días, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach bei der Casting-Show mit.\nIn meinem Herzen gewinnst du längst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le classement de mon cœur, tu es\nune idole, numéro un depuis toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei una star: nel mio cuore\nil primo in classifica sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que anúncio é esse?\nAh, é você chegando com tudo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณคือไอดอล\nศิลปินอันดับ 1 ในใจฉัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe nói bạn cao thủ lắm,\nvì cả thành phố đều bị bạn hạ gục."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idol? Dnes to ty jsi,\nv mém srdci číslo jedna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du er en popstjerne, så er du\nnummer ét på min hitliste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δόξα τω Θεώ, υπάρχεις·\nεσύ είσαι ο λόγος που ζει η λέξη «τέλειο»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydän nimikirjoitusta:\nsinä saat signeerata koko päiväni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idola di hatiku itu kamu,\nperingkat satu sepanjang masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold signeringsstund, for jeg\nvil ha at du signerer daglig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik zeg het eerlijk: jij bent een popster.\nNummer één in mijn hart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiesz, że ty jesteś idolem?\nW rankingu mojego serca numer jeden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popstjärnan som toppar listan i\nmitt hjärta, det är du."
          }
        }
      }
    },
    "quote.186" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬싸인회 열어주세요.\n매일 당신한테 사인받고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please host a signing event.\nI want an autograph from you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arise, Sir or Dame Gorgeous!\nA knighthood for you, surely."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要你的签名，\n每天来一张的那种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請開簽名會，\n我想天天找你簽名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイン会を開いてください。\n毎日あなたにサインをもらいたい!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпиши мне открытку, ты ж\nзвезда первой величины."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debuta ya: en mi corazón\nya eres cabeza de cartel, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht gehört ins Museum.\nVorn schon reserviert für dich, du Kunstwerk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une séance de dédicaces, s'il te plaît :\nje veux ton paraphe chaque matin, si tu veux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai un firmacopie, ti prego!\nCi sarò ogni giorno, tu lo sai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é uma pessoa ou\num filtro de cinema? Ah, é você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดแฟนไซน์หน่อยสิ\nอยากได้ลายเซ็นคุณทุกวัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn là bài hát,\nem sẽ bấm nghe lặp lại cả đời."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autogramiáda by měla být,\nty rozdáváš úsměvy zadarmo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Må jeg få en autograf, du?\nJeg tager gerne én hver dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σήμερα η ομορφιά\nβγήκε βόλτα και είχε όνομα: εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debytoi pian, sillä sinä olet\njo sydämessäni keskipisteenä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolong adain jumpa fans, dong.\nAku mau minta tanda tangan kamu tiap hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debuter, da! I hjertet mitt står\ndu allerede på scenen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd eens een handtekeningensessie.\nVolgens mij ben jij een ster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorganizuj spotkanie z autografami,\nbo ty zasługujesz na kolejkę fanów."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordna en signering, snälla. Jag vill\nha din autograf varje dag, du."
          }
        }
      }
    },
    "quote.187" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "데뷔하세요.\n이미 내 마음 속에서 센터예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just debut already.\nTruth is, you are the center of my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You belong in a museum,\nbehind glass. Priceless, you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出道吧你，\n在我心里你早就是C位了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快點出道吧，\n你早就是我心中的 C 位了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デビューしてください。\nもう私の心ではセンターです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пора дебютировать: ты и без\nсцены в центре внимания."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número uno en mi lista\nsemana tras semana: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Preisverleihung bitte nicht.\nDen Hauptpreis kriegt sowieso dein Gesicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance ta carrière, tu es déjà\nla tête d'affiche dans mon cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debutta pure: nel mio cuore\ntu sei già il frontman."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se simpatia ganhasse prêmio,\nvocê levava a taça e a torcida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไปเดบิวต์เถอะ\nคุณเป็นเซ็นเตอร์ในใจฉันแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho em xin số của bạn nhé?\nSố may mắn của đời em!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debutovat už nemusíš, ty\njsi ve středu mého světa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dig løs på scenen, for du er\nallerede i centrum af mit liv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε είδα στην οθόνη· εσύ\nκάνεις το ίντερνετ καλύτερο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listaykkönen taas! Kun sinä\nastut lavalle, hitti on valmis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debut aja, deh.\nDi hatiku kamu udah jadi center."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratulerer med førsteplassen.\nSå pen som du er, topper du alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je debuut!\nIn mijn hart sta jij al vooraan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadebiutuj, bo ty\ni tak stoisz w moim sercu na środku sceny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debutera redan! För du är\nrefrängen i mitt liv."
          }
        }
      }
    },
    "quote.188" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "음방 1위 축하해요.\n당신의 비주얼이 매일 1위니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congrats on the top chart spot.\nLooks like you win it every day anyway."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The national treasure\nwe never knew we needed: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恭喜你夺冠，\n颜值榜单你天天第一。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恭喜拿下音樂榜冠軍，\n你的顏值天天都是第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランキング一位おめでとう。\nあなたのビジュアルは毎日一位だから。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С первым местом в чартах: ты\nих возглавляешь без песен."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa un momento: quiero\nuna foto tuya cada día, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Star bist du\nin meinem Herzen längst die Nummer eins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier au hit-parade, encore ! Normal :\ntu as la plus belle bobine de l'industrie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primo in classifica ancora?\nNormale, tu vinci ogni giorno col sorriso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até o horóscopo disse:\n\"hoje é dia de elogiar você\"."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยินดีด้วยที่ได้ที่หนึ่งบนชาร์ต\nความปังของคุณขึ้นอันดับหนึ่งทุกวันอยู่แล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thật ra em không thích đếm cừu,\nchỉ đếm điểm đáng yêu của bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitparáda? Tam, kde ty jsi,\nje každý týden první místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitlisten er klar: du ligger nummer\nét, som du gør hver eneste dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με έναν καφέ κι εσύ\nη μέρα γίνεται γιορτή"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysähdy hetkeksi, kun sinä\nhymyilet, haluan ottaa kuvan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selamat juara tangga lagu!\nVisual kamu juara tiap hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et bilde av at du smiler hver dag?\nDet tar jeg gjerne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gefeliciteerd met nummer één!\nVolgens mij sta jij dagelijks bovenaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratulacje pierwszego miejsca!\nA ty wygrywasz co dzień."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grattis, du toppar listan varje\nvecka. Ingen annan kommer nära."
          }
        }
      }
    },
    "quote.189" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토타임 하나 갖죠.\n당신 얼굴 매일 찍고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo op, please.\nI could take a picture of you daily."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number one in the charts? Honestly,\nyou are number one for me."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一帧都好看，\n你的每张截图我都想珍藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來個合照時間吧，\n我想天天跟你拍。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影タイムをください。\nあなたを毎日撮りたいんです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давай фоточку? Знаешь, ты\nвсегда получаешься красиво."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Vuelves? Mi corazón acaba\nde reiniciarse, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autogrammstunde, bitte!\nDeine Unterschrift hänge ich mir ein, du Star."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une séance photo, ça te dit ? Parce que tu mérites\nqu'on te photographie tous les jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedimi una foto:\nsolo tu sei uno scatto perfetto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem querer incomodar, mas\nvocê é demais, tá?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอถ่ายรูปหน่อย\nอยากเก็บหน้าคุณทุกวัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soi gương chưa bạn?\nChắc cái gương cũng đang xin tên."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chci foto s tebou, ty\njsi galerie sama o sobě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Står du stille et øjeblik? Jeg vil\ngerne tage et billede hver dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πέρασες από δω και τα λουλούδια\nάνθισαν από ζήλια· εσύ φταις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paluu lavalle? Kyllä, sinä olet\nkäynnistänyt sydämeni uudelleen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi foto dulu, yuk.\nAku mau abadiin kamu tiap hari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comeback? Så du fikk hjertet mitt\ntil å gjøre comeback."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even poseren?\nIk wil elk moment dat jij lacht vastleggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotka z tobą? Pewnie,\nale ty już jesteś jak sesja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Får jag ta en bild? Det är du\nsom blir min nya bakgrundsbild."
          }
        }
      }
    },
    "quote.190" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "컴백했어요?\n내 심장을 comeback 시켰네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new comeback? Wow, you just\nbrought my heart back to life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you a pop star?\nBecause you have stolen the show."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你回归了？\n我的心也跟着一起回归了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回歸了嗎？\n我的心剛剛被你整個召回。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カムバックしたんですか?\n私の心臓を再起動させましたね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Едва ты входишь, моё сердце\nделает громкий камбэк."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te grabo? Cada momento tuyo\nes de ver en bucle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann ist dein Debüt?\nIn meinem Kopf stehst du ganz vorn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retour de toi dans ma vie ? Pour moi, tu as\nfait de mon cœur un remix, un vrai hit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuovo singolo? Il mio cuore\nlo riascolta a ogni battito. La hit sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para de ser tão incrível:\no ranking acabou, só tem você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คัมแบ็กแล้วเหรอ\nคุณทำใจฉันคัมแบ็กมาเต้นแรงอีกแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xin lỗi vì làm phiền, nhưng\nbạn đẹp quá nên em báo công an."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comeback roku? To ty se\nvracíš do mého srdce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du tilbage? Så fik du mit\nhjerte til at genopstå."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το γέλιο σου κάνει τα δέντρα\nνα χορεύουν, εσύ το ξέρεις"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoleikkeet sinusta pyörivät päässäni,\nkoska sinä olet joka kohtauksessa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comeback ya?\nJantungku ikut hidup lagi gara-gara kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan jeg filme deg? Alle øyeblikk\nder du er med er høydepunkter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terug van weggeweest?\nJe liet mijn hart weer opveren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comeback roku? To ty,\nbo serce znów bije szybciej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du tillbaka? Mitt hjärta\nfick just ett glädjefyllt comeback."
          }
        }
      }
    },
    "quote.191" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "직캠 찍어도 돼요?\n당신의 모든 순간이 명장면이니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can I film a fancam of you?\nEvery moment is a highlight reel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An autograph from you\nwould go straight on the fridge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个瞬间，\n你都在制造名场面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以拍你的直拍嗎？\n因為你每一刻都是神仙畫面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンカメラ回してもいい?\nあなたの全部が名場面なので。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый твой миг — как кино: ты\n— и режиссёр, и главная роль."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿En un videoclip? Ya eres\nprotagonista de mi vida, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platz eins der Charts?\nBei mir sowieso, jeden Tag, du Hit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux te filmer en gros plan ? Chaque fois\nque tu bouges, c'est une belle scène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso riprenderti da vicino?\nOgni istante con te, tu, è da applausi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A receita do bolo perfeito?\nUma pitada de você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอถ่ายโฟกัสหน่อยได้ไหม\nทุกมุมของคุณคือฉากเด็ด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáng ăn gì mà bạn\nđẹp hết phần thiên hạ vậy?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natočit tě? Každý záběr je\nvýběr roku, když v něm jsi ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Må jeg filme dig, mens du går?\nHvert sekund er en scene fra en film."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα σχόλιο·\nμόνο εσύ, και αρκεί"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiikkivideossa ei ole tilaa muille,\nkun sinä olet pääosassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boleh aku rekam kamu?\nSoalnya tiap momen kamu itu adegan terbaik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikkvideo? I livet mitt har du\nallerede hovedrollen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag ik filmen? Want jij hebt\nelke seconde een filmmoment."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogę nagrać fancam?\nBo ty to każda klatka hit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Får jag filma när du går förbi?\nVarje steg är en höjdpunkt."
          }
        }
      }
    },
    "quote.192" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "뮤직비디오 나오세요?\n이미 제 인생의 주인공인데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starring in a music video?\nWell, you already star in my whole life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would queue in the rain\njust to see you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要不要拍个MV？\n你早就是我生活的主角了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要演 MV 嗎？\n你早就是我人生的男女主角了。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージックビデオに出るの?\nもう私の人生の主人公なのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для клипа тебя не нужно\nгримировать: ты — готовый хит."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Documental de tu vida?\nAl natural ganas a todos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto mit dir wäre toll.\nEigentlich zehn. Eher hundert, du Sternchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clip avec toi ? Dans ma vie,\ntu tiens déjà le premier rôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoclip? No, tu sei già\nil film che vorrei vedere ogni sera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu café com você\ntem gosto de domingo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นมิวสิกวิดีโอด้วยเหรอ\nคุณเป็นตัวเอกในชีวิตฉันอยู่แล้วนะ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em đã thử đủ cách rồi,\nchẳng tìm ra khuyết điểm nào của bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoklip nepotřebuješ,\nty jsi hlavní postava mého dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal du være med i en musikvideo? Det er\njo dig, der har hovedrollen i mit liv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο καλύτερος ρόλος της ταινίας;\nΟ δικός σου, γιατί εσύ είσαι ο πρωταγωνιστής"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumenttisarjassa sinä olisit\nmaailman viehättävin päähenkilö."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main video klip, ya?\nPadahal kamu udah jadi tokoh utama hidupku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reality-TV? Egentlig er du\nenda bedre i virkeligheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel jij in een videoclip?\nJe bent al de hoofdpersoon in mijn leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teledysk? Nie trzeba,\nbo ty to cały film."

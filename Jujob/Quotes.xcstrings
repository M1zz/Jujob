    },
    "quote.136" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 노력을 아는 사람은\n당신을 응원할 거예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who sees how hard you work\nwill be rooting for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People who see how hard you work\nwill always cheer you on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道你有多努力的人，\n都会站在你这边。"
          }
        }
      }
    },
    "quote.137" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 충분히\n가치 있는 사람이에요!"

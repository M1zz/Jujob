        }
      }
    },
    "quote.027" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘들 때는 쉬어가도 돼요.\n당신의 속도로 가면 돼요."
          }

        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nằm thư giãn mà bạn\nvẫn tỏa sáng, kỳ ghê!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I na gauči ty záříš jako\nhotel s pěti hvězdičkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

{
  "sourceLanguage" : "ko",
  "strings" : {
    "quote.001" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 빛나는 하루의 시작!\n당신은 이미 충분히 멋져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rise and shine! Honestly,\nyou already look like a main character."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rise and shine, gorgeous!\nHonestly, you already look the part."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早安，今天的太阳\n是专门替你打工的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早安！今天的太陽\n是專門為你打工的。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい一日のはじまり。\nあなたはもう十分すてきですよ。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С добрым утром! Сегодня\nты — сплошной блеск."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sol sale cada mañana\npara ver quién brilla más: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen, Sonnenschein!\nSo strahlend wie heute ist nur du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveil réussi, et tu rayonnes déjà.\nLe soleil peut retourner dormir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buongiorno! Il sole è in ritardo\nperché stai già brillando tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bom dia! O sol só nasceu\nporque você acordou."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตื่นมาก็เฉิดฉายแล้ว\nคุณนี่มันตัวแม่แห่งเช้านี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào buổi sáng! Hôm nay bạn đã\nđủ lấp lánh rồi nhé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobré ráno! Slunce dnes vstává\njen proto, že ty už jsi vzhůru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God morgen, solstråle!\nI dag ser du helt fantastisk ud."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλημέρα! Σήμερα εσύ\nλάμπεις πιο πολύ κι από τον ήλιο"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi päivä, uusi tilaisuus loistaa.\nJa sinä olet jo valmiiksi kiillotettu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari baru, vibes baru,\nkamu tuh udah keren dari sananya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei sann! Allerede nå har du\nvunnet dagen ved å våkne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat een stralende start! Want\nvandaag ben jij al geweldig genoeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowy dzień, nowe blaski.\nA największy blask? To ty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "God morgon! Idag lyser du\nhärligare än både sol och kaffe."
          }
        }
      }
    },
    "quote.002" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "아침 해처럼 빛나는 당신,\n오늘도 최고의 하루 될 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sun came up and said,\n\"Wow, you outshine me.\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sun saw you and said:\n\"Fine, you win. I'll dim.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

      }
    },
    "quote.134" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포기하지 말아요.\n당신은 충분히 멋진 사람이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not quit. You are\nan amazing person and you know it."

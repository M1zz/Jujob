        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dois changer de chouchou :\ntu m'empêches d'en regarder un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambio la mia star preferita:\nda oggi la numero uno sei tu."

        }
      }
    },
    "quote.051" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 할 일도\n당신이라면 문제없어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever is on the list today,\nyou will crush it without breaking a sweat."

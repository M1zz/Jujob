          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ternyata kamu sanggup menanggung\njauh lebih banyak dari bayanganmu!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณเป็นตำรวจหรือเปล่า\nถึงได้จับใจฉันไว้อยู่หมัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em leo đỉnh núi cao nhất còn chưa\nđỉnh bằng bạn đâu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena za roli sebe sama jde\njasně k tobě, ty talente."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som rugbrød er du sund og solid,\nog alle danskere elsker dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είσαι ζαχαροπλαστείο,\nαλλά εσύ μου γλυκαίνεις τη μέρα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laske laukku alas, sinä olet\nkantanut jo tarpeeksi hurmaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taruh dulu bebannya, sini,\nkamu cukup jadi cakep aja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du fra Bergen? For det regner\nkomplimenter hver gang du kommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg die tas maar neer, jij hoeft niets te dragen.\nAlleen maar prachtig te zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaw ten bagaż, ty\nwejdź lekko do mojego serca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Släpp väskorna så bär jag dig.\nSå lätt som du är!"
          }
        }
      }
    },
    "quote.172" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너한테선 벽이 느껴져.\n완벽."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I feel a wall in you.\nA wall of pure perfection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weather forecast today:\n100% chance of you being brilliant."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒一下，\n你的颜值已经有点超载了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請問你是搜尋引擎嗎？\n因為你就是我所有問題的答案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの前に立つと壁を感じる。\nそう、「完璧」の壁。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С тобой как за каменной стеной:\nвсё потому, что ты — опора."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esto es un sueño, que no\nme despierte nadie. Tan real: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du WLAN? Bei dir\nist sofort Empfang, volle Balken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu es là, c'est comme un bon café :\nfort, chaud, et ça réveille tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roma avrebbe otto colli,\nse l'ottavo fossi tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usou filtro? Nada! Aí você\ntem beleza de fábrica."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณทำอะไรหกหรือเปล่า\nใจฉันถึงเลอะไปหมด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá xăng tăng rồi, nhưng độ xinh\ncủa bạn còn tăng nhanh hơn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas se zastavil, protože ty\njsi nejhezčí pohled dne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg leder efter en fejl ved dig,\nmen du er bygget uden revner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα χνάρια σου θα μπουν στο μουσείο,\nεσύ ο καλλιτέχνης"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiljaa hyvä tulee, mutta sinä\ntulet kuin ukkonen: kaikki huomaavat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumpah, kamu itu kayak sinyal penuh,\nbikin hidupku lancar jaya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis skjønnhet var en forbrytelse,\nvar du dømt til livstid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg, jij ziet er zo goed uit\ndat mijn spiegel jaloers wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do ideału nic ci nie brakuje,\nbo ty to właśnie ideał."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag letar efter ditt fel. Jag hittar\nbara fler pluspoäng på dig, du."
          }
        }
      }
    },
    "quote.173" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비주얼 솔직히 거품 아닌가요?\n언빌리버블."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is the beauty a bit overhyped?\nNope. Honestly, you are the real thing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are so fit the speed\ncameras flash when you pass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请问来自哪个星球？\n怎么长得这么犯规。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "魅力是違禁品，\n你讓我上癮了，請不要叫我戒掉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その見た目、正直盛ってませんか?\nいえ、素でこのレベルなんですよね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Красота — это миф? Нет,\nты — наглядное опровержение."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

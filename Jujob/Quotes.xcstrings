    "quote.060" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 건강을 챙기는 당신,\n정말 대단해요!"

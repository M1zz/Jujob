    },
    "quote.061" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 몸은\n당신이 가장 잘 알아요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking about you\nmakes my whole day better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要想起你，\n一整天都是甜的。"
          }
        }
      }
    },
    "quote.249" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 마음의\n홈이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fact: you are the home\nof my heart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home to me, in human form,\nthat is you."

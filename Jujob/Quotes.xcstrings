        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena za nejlepší obličej roku?\nJistě ty. Porota už nehlasuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisen som årets ansigt skal gå til dig,\nfor du er helt historisk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ήσουν γλυκό,\nεσύ θα ήσουν το πιο ακριβό της βιτρίνας"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainoksissa sinä loistat niin,\nettä kaikki haluavat ostaa kaiken."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piala wajah terbaik tahun ini\nwajib jatuh ke kamu, saingan nggak ada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal du reklamere? Ser jeg deg,\nvil jeg kjøpe alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezicht van het jaar word je zeker.\nEen absolute topper."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrodę za najlepszy wygląd\nodbierasz co roku, ty rekordzisto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årets pris borde du få.\nVarje år, utan undantag."
          }
        }
      }
    },
    "quote.196" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "광고 모델 하세요?\n당신만 보면 다 사고 싶어져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you modeling for an ad?\nOne look at you and I want to buy everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a bow, you.\nThe standing ovation is for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去拍广告吧，\n一看见你我就想下单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要接代言嗎？\n看到你我什麼都想買單。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CMに出ています?\nあなたを見ると何でも買いたくなる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотришь на тебя — и сразу\nулыбка: ты — реклама счастья."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portada de revista cada mes:\nesa cara lo merece, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehst du eine Doku?\nDein echtes Ich ist schon die Sensation, du Naturtalent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu fais de la pub, je vais tout acheter,\nmême ce dont je n'ai pas besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai pubblicità? Appena ti vedo\nvoglio comprare qualsiasi cosa. Che potere, tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurei um elogio à sua altura.\nNão existe, mas você merece."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เป็นพรีเซนเตอร์เหรอ\nเห็นคุณทีไรอยากซื้อทุกอย่าง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đẹp đến mức camera thường nhìn bạn\ncũng phải xin lỗi vì chưa đủ nét."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tvou tváří by se vyprodalo\nvšechno, ty jsi nejlepší značka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du reklamemodel? Jeg får lyst\ntil at købe alt, når du er med."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε κάθε φωτογραφία\nέλειπες εσύ, και τώρα συμπληρώθηκε"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehden kansikuvaan sinä kuulut,\nsekä jokaiseen numeroon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadi model iklan, ya?\nLihat kamu aja bikin aku pengen beli semuanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsidemodell? Fjeset ditt burde\npryde hvert eneste blad, du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben jij reclamemodel?\nAls ik je zie, wil ik alles kopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ty pojawiasz się w reklamie,\nkażdy chce kupić wszystko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du med i reklamen? Jag köper allt\nsom du ler mot."
          }
        }
      }
    },
    "quote.197" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "잡지 표지 모델이시죠?\n매달 표지를 장식해야 할 얼굴."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look, you must be a magazine cover star.\nThat face belongs on every issue."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore, encore! Surely you\ncannot stop at one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "杂志封面就该是你，\n每个月都该是你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雜誌封面人物就是你吧？\n你的臉每個月都該上封面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雑誌の表紙の人ですよね?\n毎月飾るべき顔です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На обложке всегда ты, потому\nчто выбор у редактора один."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tu carisma es real? La calle\ncontigo ya es un escenario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitte der Bühne? Gehört dir.\nAm meisten leuchtet überall nur du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une couv de magazine, c'est toi, tous les mois.\nPour toi, il faudrait un numéro quotidien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmi che sei in copertina:\nsul giornale ci sta solo tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que você ri,\num unicórnio ganha asas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขึ้นปกนิตยสารใช่ไหม\nปกทุกเดือนคงต้องเป็นหน้าคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quả này bạn lên top xu hướng,\nmà thật ra bạn vốn là top từ lâu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titulka časopisu? Na tu ty\nmáš nárok každý měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du forsidemodel? Dit ansigt burde\npryde alle blade hver måned, du."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν σε έχω ανάγκη·\nαπλώς εσύ είσαι η πιο ωραία συνήθεια"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavalla sinä olet karismaa,\nja arjessakin loistat kuin valonheitin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sampul majalah tiap bulan\nmemang pantas dihiasi muka kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekte scenekarisma? Selv når du\ngår på butikken er det show."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta je op een tijdschriftomslag?\nEigenlijk elke maand, zo'n gezicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto na okładce co miesiąc?\nNo ty, bo konkurencja odpada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du omslagsstjärna?\nDitt ansikte borde pryda varje månad."
          }
        }
      }
    },
    "quote.198" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "무대 위 카리스마 실화예요?\n일상도 무대처럼 빛나네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That stage charisma is real?\nEven you doing errands looks like a show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headline act and support act,\nyou do both."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台上的气场太炸了，\n生活里的你也一样耀眼。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台魅力是真的嗎？\n連你的日常都像在舞台上發光。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステージ上のカリスマ、本物?\n普段の姿もステージ級なんだけど。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Харизма на сцене зашкаливает,\nа в жизни ты — не хуже."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cromos? Yo quiero la colección\ncompleta, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wahl zum Gesicht des Jahres:\nGewinnen tut, ohne anzutreten, nur du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le charisme sur scène, c'est vrai ?\nQuand tu es là, le quotidien ressemble à un spectacle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che carisma sul palco!\nMa anche a casa sei una star, tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se carisma fosse um rio,\nvocê seria a cachoeira."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออร่าบนเวทีของคุณนี่จริงเหรอ\nชีวิตประจำวันก็เหมือนเวทีเลย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bác sĩ dặn không nên nhìn bạn lâu,\nvì em dễ bị say nắng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pódiu zazáříš, ale ty\nsvítíš i v obýváku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er scenekarismaen ægte? Selv i hverdagen\nlyser du som på en scene."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλο φως και πάθος,\nεσύ είσαι αυτό που ψάχνει ο κόσμος"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos keräisin kuvakortteja, sinä\nolisit koko pakka, ei muuta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karisma kamu di panggung beneran?\nSehari-hari pun kamu kayak lagi di panggung."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal vi bytte samlekort? Jeg vil\nha hele settet der du er med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat charisma op het podium, is dat echt?\nOok in het gewone leven steel jij de show."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na scenie ty błyszczysz,\na w tramwaju też."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så mycket scennärvaro! Även en\ntisdag blir en konsert när du är där."
          }
        }
      }
    },
    "quote.199" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포토카드 교환해요?\n당신 얼굴로만 풀 세트 모으고 싶어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to trade photocards?\nI only collect the full set of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotted: you, being brilliant.\nThe photographers are going mad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想交换小卡？\n你的我想集齐全套。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要交換小卡嗎？\n我想用你的臉湊齊整套。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレカ交換しませんか?\nあなたの顔だけでフルコンプしたい。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточки с тобой разлетелись бы\nза секунду: ты — редкость."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuándo es el encuentro con fans?\nYo, a diario, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbung mit dir? Sofort\nwill ich alles kaufen, was du anfasst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échange de cartes à collectionner ? Si tu en as,\nje voudrais tout l'album, sans doublon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faccio l'album delle figurine:\nin ogni pagina ci sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá todo mundo perguntando:\nquem é essa lenda? É você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาแลกการ์ดกันไหม\nอยากสะสมครบเซ็ตแต่หน้าคุณ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thấy bạn thì em lập tức\nmở chế độ fan cuồng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartičky s tvou tváří by byly hit,\na ty jsi na nich hlavní hvězda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du bytte samlekort? Jeg vil kun\nhave dem med dit ansigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αστέρια ρώτησαν\nπώς λάμπεις έτσι εσύ, και δεν απάντησες"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanitapaaminen? Kyllä, sinä olet se,\njonka haluan nähdä joka päivä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukeran kartu foto, yuk?\nAku mau kumpulin satu set penuh wajah kamu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når er fansamlingen? Jeg vil\nmøte deg hver dag, vet du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruilen we fotokaartjes?\nIk wil alleen de set waar jij op staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekcja z twoją twarzą?\nZbieram całą serię, ty gwiazdo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byter vi samlarkort? Jag vill att du\nska vara hela samlingen."
          }
        }
      }
    },
    "quote.200" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "팬미팅 언제 해요?\n매일 만나고 싶은데."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When is the fan meeting?\nI would like to see you every day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paparazzi would be rubbish\nwithout you, honestly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粉丝见面会什么时候开？\n我想天天见到你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粉絲見面會什麼時候？\n我想天天都跟你見面。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンミはいつ開催ですか?\n毎日でも会いたいのに。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда встреча с фанатами?\nМы ждём: ты — наш кумир."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube un vídeo bailando:\nmoverte ya es arte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelbild für jedes Magazin:\ndieses Gesicht gehört auf alle Cover, du Schönheit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça se passe quand, ta rencontre avec les fans ?\nJ'aimerais que tu viennes chaque jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

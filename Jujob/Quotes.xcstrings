    "quote.036" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "지금 힘들어도\n당신이라는 존재 자체가 기적이에요."

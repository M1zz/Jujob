        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze všech lidí na světě\nje pro mě nejdůležitější ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På hele jorden er der ingen,\nder er så dyrebar som du."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειρωνεία της μοίρας:\nεσύ με κάνεις να χαμογελώ μόνος μου"

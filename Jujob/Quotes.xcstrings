        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time with you is\nalways something special."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和你在一起的时光，\n永远特别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟你在一起的時光，\n每分每秒都很特別。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に過ごすと、\nあなたとの時間はいつも特別です。"

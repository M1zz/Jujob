        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't give up, you\nare plenty strong enough!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别放弃，\n你的韧劲儿全世界都看得见。"
          }
        }
      }
    },
    "quote.040" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "힘든 시기를 견디는 당신,\n정말 대단해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanging in there through all this?\nHonestly, you are a hero."

        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любое задание — детская игра,\nпока на месте ты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que toque hoy tiene\nsolución, y la solución eres tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufgaben von heute?\nKein Problem für dich, du Meister."
          }
        }
      }
    },
    "quote.052" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신의 열정이\n오늘을 빛낼 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch out, the fire in you\nwill light up the whole day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The passion in you will\nlight up today!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热情一上线，\n你今天就亮堂了。"

          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duše je tvoje priorita, a ty\njí dnes dáš pozornost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit hjerte er det\nvigtigste, du har."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αργά και σταθερά,\nεσύ με τον δικό σου ρυθμό"

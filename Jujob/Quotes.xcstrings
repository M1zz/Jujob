      }
    },
    "quote.053" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "파이팅! 오늘도\n당신답게 해내봐요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go get it! Do it\nthe way only you can!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go on! Smash it today\nlike only you can."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冲呀，今天也要\n活出你的风格！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加油！今天也\n用你的方式漂亮完成吧！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイト! 今日も\n自分らしくやりきろう!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вперёд! Сегодня ты — тот,\nкого ждали все дедлайны."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Vamos! A lo grande,\ncomo siempre, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los geht's, zeig, was in dir steckt,\nso wie nur du es kannst."
          }
        }
      }
    },
    "quote.054" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일 시작 전 당신의 모습,\n이미 프로페셔널이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before work even starts,\nyou already look like a pro!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before work, you already\nlook like a total professional!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开工前的你，\n已经自带职场精英气场。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開工前的你，\n看起來已經是專業級的了！"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事前のあなたの佇まい、\nすでにプロの風格です。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочий день ещё не начался,\nа ты уже выглядишь на миллион."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de empezar ya tenías\naire de profesional, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon vor Arbeitsbeginn\nein echter Profi: du."
          }
        }
      }
    },
    "quote.055" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일하기 싫다고요?\n그래도 당신 얼굴은 열일 중이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not feel like working?\nWell, you still look like you are working it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreading work? Well, that face\nis already doing overtime for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不想上班？可你的颜值\n倒是一直在勤勤恳恳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不想上班？\n可是你的臉還是很認真在加班。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "働きたくない? それでも\nあなたの顔面は絶賛フル稼働中。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работать не хочется? Зато ты\nвыглядишь как босс бизнеса."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sin ganas de trabajar? Aun así\nrindes más que nadie: tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Lust zu arbeiten?\nDein Gesicht macht trotzdem Überstunden, du Fleißiger."
          }
        }
      }
    },
    "quote.056" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 출근길 비주얼 미쳤어요.\n회사가 당신 덕분에 빛나네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commute looks? Unreal.\nThe office glows because you walk in."
          }

        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在我心中，\n是名人堂的第一號。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心の殿堂入り第一号は\nあなたです。異論は認めません。"

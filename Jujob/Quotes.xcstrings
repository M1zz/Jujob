        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehi tu, sì, proprio tu:\nè iniziata la giornata migliore!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje o mundo tá melhor,\ne a prova é que você acordou."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตะวันยังต้องเกรงใจ\nเพราะคุณเปล่งประกายกว่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặt trời còn phải nể\nkhi thấy bạn thức dậy."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Káva? Pro tebe zbytečná,\nty potřebuješ jen publikum."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solen står op, og det gør du også.\nDet bliver en god dag!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξύπνησες; Τότε εσύ\nκέρδισες ήδη τη μέρα!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aurinko nousi vain siksi, että\nsinä näkisit sen näin kauniina."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matahari aja kalah silau sama kamu,\npagi ini kamu juara lagi!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgensolen blekner mot hvor\nmye du skinner i dag!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

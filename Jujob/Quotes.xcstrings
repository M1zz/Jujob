        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня всё осветит твой огонь,\nведь ты — настоящий прожектор."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ilusión iluminará el día\nentero, tú, farola humana."

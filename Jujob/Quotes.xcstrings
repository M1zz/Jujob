        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep breath, and\ntrust what you know!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep breath, and trust\nwhat you know!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

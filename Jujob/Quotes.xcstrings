        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are the premium pass\nto my life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A season ticket to my happiness?\nThat is you, mate."

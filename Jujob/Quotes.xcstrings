      }
    },
    "quote.011" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "일어나자마자 보는 당신,\n눈호강 제대로 하네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First thing I see is you.\nMy eyes just hit the jackpot."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First thing I see is you.\nEyes officially treated."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

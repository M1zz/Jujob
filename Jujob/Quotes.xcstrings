        }
      }
    },
    "quote.174" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "너는 영어를 못하는구나.\n하지만 영문 없이도 귀엽다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You say you are bad at math?\nWell, you still add up to everything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better than a sunny bank holiday,\nthat is you, mate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全场的平均颜值，\n都被你一个人拉高了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我最近不玩手遊了，\n因為你比抽卡還讓我心跳加速。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーダーは「あなたの笑顔」ひとつ。\nお会計は、胸いっぱいです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Языков в мире много, но смысл\nодин: ты — просто класс."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupo sanguíneo: A positivo.\nPura buena onda, como tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Schönheit verboten wäre,\nbekämst du lebenslänglich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de super-pouvoirs, toi ? Alors comment\ntu fais pour illuminer toute la pièce ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tiramisù tira su il morale?\nSì, ma tu lo tiri su meglio."

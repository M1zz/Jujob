    "quote.108" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "면접관이 당신을 안 뽑으면\n그 회사 손해예요."

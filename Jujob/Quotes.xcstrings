        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gespräch ist ein Kennenlernen.\nEntspannt bleiben kann niemand so wie du."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un entretien, c'est une rencontre.\nDétends-toi, tu n'as rien à prouver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colloquio è una chiacchierata.\nE tu in questo sei un asso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrevista é só um papo,\ne papo é com você mesmo."

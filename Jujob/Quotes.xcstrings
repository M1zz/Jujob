    },
    "quote.229" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 내 인생의\n최고의 행운이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

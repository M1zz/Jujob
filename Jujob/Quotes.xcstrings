        }
      }
    },
    "quote.057" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 일하는 모습,\n그게 바로 아트예요."

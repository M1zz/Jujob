        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первое, что увидит мир сегодня,\nэто ты. Мир везучий."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor plan para esta mañana:\nlo tienes tú, y nadie más."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gesicht gleich nach dem Aufstehen:\nAugenschmaus pur, du Glückspilz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier regard du matin sur toi,\net je me dis que tu mérites une médaille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo raggio di sole\nha chiesto di te. Sì, proprio tu!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O despertador toca, mas quem\nacorda o dia de verdade é você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นาฬิกาปลุกดังแค่ครั้งเดียว\nคุณก็ลุกมาเป็นตำนานแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mới sáng ra đã gặp bạn,\nmắt em được đi spa luôn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotva otevřeš oči, už je tu\nnejhezčí pohled dne: ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Første blik i dag faldt på dig,\nog så vidste jeg, du var dagens fund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πρώτο που είδα σήμερα\nήταν η οθόνη, κι εσύ μου φτιάχνεις τη μέρα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aamupeili tuijottaa ja miettii,\nmiten sinä jaksat näyttää noin hyvältä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mata baru melek, eh ada kamu di layar,\nrezeki nomplok banget!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Først ser jeg deg i dag,\nog morgenøynene sier takk, du."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerste blik van de dag, en daar ben jij.\nMijn ogen krijgen meteen een traktatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledwo oczy otwarte,\na tu ty: widok bez filtra, a jaki!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det första du möter i spegeln\när en riktig vinnare."
          }
        }
      }
    },
    "quote.012" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",

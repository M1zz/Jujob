    },
    "quote.126" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "포기하지 마세요.\n당신의 꿈은 이루어질 거예요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not give up.\nWe know you will reach that dream!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't give up, the dreams\nyou have will come true!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别放弃，\n你的梦想会成真的！"

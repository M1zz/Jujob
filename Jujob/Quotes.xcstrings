        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dor de hoje é o músculo\nde amanhã. Segue firme!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความลำบากวันนี้\nคือปุ๋ยของคุณในวันพรุ่งนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khó khăn hôm nay là phân bón\ncho bạn lớn lên ngày mai!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní trable jsou zítřejší\nvyprávění a ty jsi hlavní hrdina."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens modgang er morgendagens\nstyrke, og den har du masser af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντέχεις περισσότερα\nαπ' όσα νομίζεις, εσύ το έχεις αποδείξει"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän päivän tuska on huomisen\nvoima, ja sinä keräät sitä jo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesulitan hari ini jadi pupuk\nbuat kamu tumbuh besok!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motgangen i dag gjør at du\nvokser enda mer i morgen!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ellende van vandaag is de brandstof\nvoor de kracht die jij morgen toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejsze zmartwienie to jutrzejszy trening,\na ty już jesteś w formie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens motgång blir morgondagens\nstyrka, och du är redan på väg!"
          }
        }
      }
    },
    "quote.042" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 생각보다\n훨씬 더 많이 견딜 수 있어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can handle\nway more than you believe!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you can handle\nfar more than you think!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能扛住的事，\n远比你以为的多得多！"

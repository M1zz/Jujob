          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включаю фонарик в твою честь:\nты — вечный повод для света."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas en ascenso, aunque\nsiempre fuiste de leyenda, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ein Trailer bist du:\nIch will gleich den ganzen Film."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'allume mon bâton lumineux pour toi :\nje t'encouragerai tant que tu me souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzo la torcia del telefono:\nper te, che illumini la sala. Sì, tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedido de bis: você\nchegando de novo pro dia todo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอเปิดแท่งไฟนะ\nจะเชียร์คุณไปตลอดชีวิต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debut đi, em tin bạn\nsẽ có fan số một là em."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Světýlka nahoru! Všechna svítí\njen proto, že ty jsi na pódiu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg tænder lysstaven og hepper på dig\nhele livet, så længe du skinner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε ψάχνω παντού\nκαι εσύ είσαι πάντα στην καρδιά μου"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nousu listalle on selvä, mutta\nsinä olet ollut legenda aina."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lightstick-ku nyala nih,\naku bakal dukung kamu seumur hidup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plutselig stjerne? Det var du\njo alltid, en legende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichtstok aan.\nIk juich een leven lang, en jij bent de reden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapalam lightstick,\nbo ty to gwiazda mojego wieczoru."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag viftar med ficklampan, för du\när värd en hejarklack livet ut."
          }
        }
      }
    },
    "quote.206" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "떡상했네요.\n원래부터 레전드였는데 뭘."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admit it, you blew up overnight?\nYou were a legend way before that."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full English of people,\nthat is you: satisfying all round."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你爆红了？\n你一直是传奇，不过是被更多人发现了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紅了耶？\n欸不對，你本來就是傳說啊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バズりましたね。\nでも、もともと伝説だったんですけどね。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хайп догнал, но ты и без него\nлегенда с самого рождения."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busco entradas para verte:\neres mi concierto diario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehst du auf Welttournee?\nMein Herz hast du schon überall verteilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça a explosé, hein ? Normal,\ntu étais déjà légendaire depuis le début."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scalata in classifica?\nIn vetta eri già da sempre, tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei, na primeira fila,\nsó tem fã de você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พุ่งแรงเลยนะ\nก็คุณเป็นตำนานตั้งแต่แรกแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhìn bạn thôi là em thấy\nbao nhiêu gánh nặng bay hết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víc fanoušků, než ty tušíš,\nti dnes tleská."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gik du viralt? Legende var du fra\nførste dag, så jeg undrer mig ikke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Δευτέρα φοβάται\nόταν σε βλέπει να χαμογελάς εσύ"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konserttiliput odottavat, mutta\nsinä olet päivittäinen keikkani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naik daun, ya?\nPadahal dari dulu kamu udah legenda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsertbilletter? Å se på at du\ngår forbi er min daglige konsert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viral gegaan? Niet vreemd,\nwant jij was allang een legende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozgłos? Spoko, bo ty\nlegenda od zawsze, świat dopiero łapie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grattis till succén! Fast du var\nju legend redan innan."
          }
        }
      }
    },
    "quote.207" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "콘서트 티켓 구해야겠어요.\n당신을 보는 게 제 일상 콘서트니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I need concert tickets.\nWatching you is my daily live show."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cherry on top\nof a cracking day: you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演唱会门票我来抢，\n毕竟看你就是我的日常演唱会。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我得去搶演唱會門票了，\n看你就是我的日常演唱會。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンサートのチケット探さなきゃ。\nあなたを見る日常が私のライブです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Концерт? Я лучше просто\nпосмотрю на тебя: ты — шоу."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Número uno? Lo eres\nen mi lista de éxitos, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signier mir dein Album.\nDein Dasein ist limitierte Edition, du Rarität."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dois réserver des places de concert :\nquand tu apparais, c'est mon spectacle quotidien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concerto? Io vado\nsolo per vedere se ci sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assina aqui? Quero levar\num autógrafo seu pra vida inteira."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องหาบัตรคอนเสิร์ตแล้ว\nเพราะการได้เห็นคุณคือคอนเสิร์ตของฉัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em đang tính lập fanpage\nchỉ để khen bạn cả ngày."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lístek na koncert? Mám\nvstupenku zadarmo: ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg skal have koncertbilletter, for hver\ndag, jeg ser dig, er det en koncert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η Δευτέρα είχε προσωπικότητα,\nεσύ θα την έκανες Παρασκευή"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kappale ykkössijalla, ja sinä\nolet elämäni parhaat soinnut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku harus cari tiket konser.\nSoalnya lihat kamu itu konser harianku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Førsteplass på alle lister,\nog i livet mitt er du også først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concertkaartje nodig? Nee hoor,\njij bent mijn dagelijkse concert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wejściówki na koncert są drogie,\nale ty dajesz show za darmo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag ska skaffa biljetter. Att se\ndig, du, är min dagliga konsert."
          }
        }
      }
    },
    "quote.208" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "인기가요 1위 하셨죠?\n당신은 제 인생 1위 곡이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you hit number one on the charts?\nYou are the song stuck in my head forever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ploughman's without pickle?\nUnthinkable, like me without you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拿了榜单第一吧？\n在我心里你是永远的冠军曲。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登上榜首了吧？\n你是我人生榜單的永遠第一名。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽番組で一位でしたよね?\nあなたは私の人生の一位ソング。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хит-парад обновился: ты\nопять на первом месте."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis, bis, bis: otra vez,\nque no me canso de verte, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach das Licht an, Fanclub:\nIch jubel dir ein Leben lang zu, du Star."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier du top 50, encore ?\nPour moi, tu es le hit de toute ma vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primo posto in hit parade?\nPer me la canzone numero uno sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hit do verão? Que nada,\no hit do ano inteiro é você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้ที่หนึ่งรายการเพลงใช่ไหม\nคุณคือเพลงอันดับหนึ่งในชีวิตฉัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được bạn ghé qua là cả ngày\nem ở chế độ lễ hội."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hit sezóny? No přece ty,\nv tom není diskuse."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gik du til tops på hitlisten? For mig er du\ni hvert fald yndlingssangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καρδιά μου έχει\nμια θέση, και εσύ την έχεις πιάσει"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielä yksi encore, sillä sinä\nolet liian hyvä lopetettavaksi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juara tangga lagu, kan,\nkamu itu lagu nomor satu di hidupku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstranummer, takk! Jeg vet\nat du aldri blir for mye."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nummer één in de hitlijsten?\nMaakt niet uit, jij bent de nummer één van mijn leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet lista przebojów\nwie, że ty to numer jeden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppat listorna igen? För du är min\nfavoritlåt, på repeat."
          }
        }
      }
    },
    "quote.209" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "앵콜 무대 하나 더요.\n당신은 봐도봐도 또 보고 싶으니까."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more encore, please.\nI can never see enough of you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pure class, you. Even\nthe swans would bow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再来一首安可，\n怎么看你都看不够。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安可、安可！\n你怎麼看都看不膩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アンコールをもう一曲!\nあなたは見ても見ても、また見たくなる。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бис! На бис! Вот ты — тот,\nна кого хочется смотреть снова."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta en las tomas falsas\nresultas de leyenda, tú."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plötzlich so berühmt?\nWarst doch immer schon eine Legende, du Held."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel, encore un !\nOn ne se lasse pas de te revoir quand tu passes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis, bis, bis!\nUna canzone che riascolto sempre? Sei tu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na minha playlist, só você\ntoca no repeat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขออีกหนึ่งเพลงนะ\nดูคุณกี่รอบก็ยังอยากดูอีก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em chọn bạn làm bias\nvà đổi luôn cả danh sách yêu thích."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis! Bis! Ať ty se objevíš\nna jevišti ještě jednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ekstranummer, tak! Man bliver\naldrig træt af at se dig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μουσική είναι ωραία,\nαλλά εσύ είσαι το τραγούδι"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvauksen taustakuvatkin ovat täydellisiä,\nsillä sinä olet joka kuvassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore sekali lagi, dong.\nDilihat berkali-kali pun kamu tetap bikin kangen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bak kameraet er du også perfekt.\nIngen svake øyeblikk å finne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog één toegift graag.\nWant als jij erbij bent, is het nooit genoeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis! Jeszcze raz,\nbo ty to piosenka na repeat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett extranummer till! Jag blir\naldrig mätt på dig, du."
          }
        }
      }
    },
    "quote.210" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "비하인드 컷도 완벽해요.\n어느 순간도 빠짐없이 레전드."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even you in the behind-the-scenes shots? Perfect.\nNo off moments, only legend."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",

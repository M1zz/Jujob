        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut vorbereitet?\nDann bist du schon zur Hälfte am Ziel."
          }
        }
      }
    },
    "quote.051" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 할 일도\n당신이라면 문제없어요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever is on the list today,\nyou will crush it without breaking a sweat."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's to-do list is\nno problem for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的任务，\n交给你肯定稳稳的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天要做的事，\n交給你根本小菜一碟。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のタスクなんて、\nあなたにかかればおやつ前です。"

        }
      }
    },
    "quote.133" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이라면 다 잘될 거예요.\n진짜로요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything will work out for you.\nSeriously, I mean it!"

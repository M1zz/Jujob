    "quote.059" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "운동하는 당신,\n이미 멋진 사람이에요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

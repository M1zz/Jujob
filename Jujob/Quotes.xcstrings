        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joka näkee vaivannäkösi, pitää\npeukkuja, ja sinä ansaitset sen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

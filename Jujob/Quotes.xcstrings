    },
    "quote.056" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 출근길 비주얼 미쳤어요.\n회사가 당신 덕분에 빛나네요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commute looks? Unreal.\nThe office glows because you walk in."

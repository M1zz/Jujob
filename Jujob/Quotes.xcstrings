        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag speel jij de hoofdrol,\ndus geniet van je applaus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś na scenie ty,\na reszta świata klaszcze."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idag är det du som är\nhuvudrollen. Resten är statister."
          }
        }
      }
    },
    "quote.006" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "눈을 뜬 순간부터\n당신은 이미 승리자!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyes open, and you\nalready won the day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyes open, and you\nhave already won the day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闹钟响了也不慌，\n毕竟你自带光芒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

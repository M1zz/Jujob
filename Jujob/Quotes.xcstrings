        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшие часы моего дня — те,\nгде есть ты. Золотой час!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengo la vida en HD\ndesde que apareciste, tú."

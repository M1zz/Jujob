    "quote.080" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘 하루도 고생했어요!\n집에 가서 푹 쉬어요."

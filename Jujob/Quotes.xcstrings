        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotijoukkueeni löytyy luotasi,\nsillä sinä olet minun kapteenini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fans seumur hidup, resmi,\nkamu artis abadi buatku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hovedkvarteret mitt er der du er.\nJeg flytter inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een leven lang fan.\nWant jij blijft mijn eeuwige artiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Będę twoim fanem do końca,\nbo ty to ikona stulecia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag är ditt fan för all framtid, för\ndu är min artist nummer ett."
          }
        }
      }
    },
    "quote.216" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "본진 박았어요.\n당신이 제 본진이에요."

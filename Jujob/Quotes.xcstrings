          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdo tě nevezme, přijde o hvězdu\na ty to ani nemusíš řešit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de ikke ansætter dig,\ner det firmaet, der taber."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν λάμπει το βιογραφικό σου·\nεσύ λάμπεις, και αυτό φαίνεται"

        }
      }
    },
    "quote.146" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신이 생각하는 것보다\n당신은 훨씬 대단해요!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are far more\nawesome than you think credit for!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honestly, you are way\nmore amazing than you reckon!"
          }
        }
      }
    },
    "quote.147" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "당신은 이미\n충분히 잘하고 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth is, you are\nalready doing great."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at that: you are\nalready doing brilliantly."
          }

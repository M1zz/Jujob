        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen lyst til at arbejde? Dit ansigt\nknokler på overtid, uanset hvad du gør."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",

    },
    "quote.020" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "저녁인데도 여전히 빛나네요.\n어떻게 하루종일 예뻐요?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is evening and you still sparkle.\nHow do you do it all day?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evening already, and you\nstill look this good? How?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都晚上了还在发光，\n你是充电宝成精了吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

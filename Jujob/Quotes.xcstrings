    "quote.082" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "하루를 마치고 돌아가는 길,\n당신은 최고예요!"

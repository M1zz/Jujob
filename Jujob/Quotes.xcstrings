    "quote.075" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "오늘도 책임감 있게\n출근하는 당신, 멋져요!"
